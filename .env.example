# Optional code required when creating the first administrator.
# PANEL_SETUP_TOKEN=replace-with-a-long-random-value

# Optional bearer token for automation and emergency access.
# PANEL_API_TOKEN=replace-with-a-separate-long-random-token

# Maximum upload size in bytes (default: 2 GiB).
# MAX_UPLOAD_BYTES=2147483648

# Helper for accessing volumes while a game is stopped.
# FILE_HELPER_IMAGE=alpine:3.22

# Enable behind one trusted HTTPS reverse proxy.
# TRUST_PROXY=true
# COOKIE_SECURE=true

# Default: 3000 in production, 3001 in development.
PORT=3000

# Production default: /data/panel.db.
# PANEL_DB_PATH=./data/panel.db
