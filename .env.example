# Copy this file to .env to configure Docker Compose.

# Log verbosity: error, warn, info (default), or debug.
# Use debug temporarily when diagnosing API, WebSocket, or Docker connections.
# LOG_LEVEL=info

# Optional API access. Grants full administrator rights, so it must be at least
# 32 characters; shorter values are ignored. Generate with: openssl rand -hex 32
# LUDOCK_API_TOKEN=replace-with-a-separate-long-random-token

# Maximum upload size in bytes (default: 2 GiB).
# MAX_UPLOAD_BYTES=2147483648

# Audit log entries to retain (default: 100000). Failed sign-ins are recorded
# for unauthenticated callers, so this bounds how large the log can grow.
# AUDIT_LOG_MAX_ROWS=100000

# Helper for accessing volumes while a game is stopped.
# FILE_HELPER_IMAGE=alpine:3.22
