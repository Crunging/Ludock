# Copy this file to .env to configure Docker Compose.

# Optional API access. Generate with: openssl rand -hex 32
# PANEL_API_TOKEN=replace-with-a-separate-long-random-token

# Maximum upload size in bytes (default: 2 GiB).
# MAX_UPLOAD_BYTES=2147483648

# Helper for accessing volumes while a game is stopped.
# FILE_HELPER_IMAGE=alpine:3.22

# Optional. Trust only the proxy directly connected to the panel. This makes
# audit logs and rate limits use the client IP supplied by that proxy.
#
# Docker example (replace the network and container names):
# docker inspect -f '{{(index .NetworkSettings.Networks "proxy").IPAddress}}' traefik
# Common container names: traefik, nginx, nginx-proxy-manager, caddy.
# Add /32 to the result. Prefer a static IP or dedicated proxy-only network.
# Multiple entries may be comma-separated.
# TRUSTED_PROXIES=<proxy-ip>/32
