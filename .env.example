# Copy to .env beside compose.yaml and uncomment the settings you want to change.
# Recreate Ludock after saving: docker compose up -d --force-recreate ludock
# No .env file is required for the default installation.
# Configure backup limits, server sharing, schedules, and Discord in the browser.

# COMMON SETTINGS

# Maximum size of each uploaded file (default: 2 GiB).
# Use a readable size such as 500 MB, 2 GiB, or 1.5 GiB; bytes also work.
# MAX_UPLOAD_SIZE=2 GiB

# OPTIONAL FEATURES

# Approved Compose source roots, separated by ':' in the Linux runtime.
# Mount these read-only at the SAME absolute paths as on the Docker host.
# Example mount: /srv/game-stacks:/srv/game-stacks:ro
# LUDOCK_COMPOSE_ROOTS=/srv/game-stacks

# Approved mounted backup roots, separated by ':'. Default: /backups.
# An empty value disables new backup configuration.
# LUDOCK_BACKUP_ROOTS=/backups

# ADVANCED SETTINGS — the defaults normally need no changes.

# Log verbosity: error, warn, info (default), or debug.
# LOG_LEVEL=info

# Optional first-administrator setup code; 32-128 characters.
# Generate a random value, for example with openssl rand -hex 32.
# If unset, Ludock generates one at startup; retrieve it locally with
# `docker compose logs ludock`. Configured values are never printed.
# Remove this setting after initial setup and keep it out of URLs and labels.
# LUDOCK_SETUP_CODE=

# Optional full-administrator API access; at least 32 characters.
# Generate a separate random value, for example with openssl rand -hex 32.
# Never put this token in a browser URL or a game-container label.
# Rotating it invalidates queued operations requested with the old token.
# LUDOCK_API_TOKEN=

# Application database path inside Ludock's persistent data mount.
# LUDOCK_DB_PATH=/data/ludock.db

# Socket path INSIDE Ludock, for deployments with a different mount target.
# DOCKER_SOCKET=/var/run/docker.sock

# Override only when the Docker hostname cannot identify the Ludock container.
# LUDOCK_SELF_CONTAINER=your-ludock-container-name

# Optional dedicated read-only Docker client config for private-registry access.
# This may contain credentials. Do not expose it as a game file root.
# LUDOCK_DOCKER_CONFIG=/registry-auth

# Additional protected container/host paths, separated by ':'.
# LUDOCK_SENSITIVE_PATHS=/srv/private:/data/private

# Optional helper override; the default is selected automatically.
# Requires Bun >= package.json's minimum, Linux /proc/self/fd, and a verified digest.
# Validate both linux/amd64 and linux/arm64 before distribution.
# FILE_HELPER_IMAGE=registry.example.com/ludock-helper:tested-version@sha256:<verified-digest>

# Retained audit entries (default: 100000).
# AUDIT_LOG_MAX_ROWS=100000
