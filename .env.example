# Copy to .env beside compose.yaml and uncomment the settings you want to change.
# Recreate Ludock after saving: docker compose up -d --force-recreate ludock
# No .env file is required for the default installation.
# Configure backup limits, server sharing, schedules, and Discord in the browser.
# Ludock refuses to start when a setting is invalid and says which one.

# COMMON SETTINGS

# Maximum size of each uploaded file (default: 2 GiB).
# Use a readable size such as 500 MB, 2 GiB, or 1.5 GiB; bytes also work.
# LUDOCK_MAX_UPLOAD_SIZE=2 GiB

# OPTIONAL FEATURES

# Approved backup folders, separated by ':' (default: /backups).
# Set it to an empty value to turn backups off.
# LUDOCK_BACKUP_ROOTS=/backups

# ADVANCED SETTINGS — the defaults normally need no changes.

# Log verbosity: error, warn, info (default), or debug.
# LUDOCK_LOG_LEVEL=info

# Reverse proxies allowed to supply client addresses through X-Forwarded-For.
# Comma-separated IP addresses or CIDRs; unset uses the direct peer address.
# Trust only your proxies, and have the edge proxy overwrite X-Forwarded-For.
# LUDOCK_TRUSTED_PROXIES=172.18.0.2,2001:db8::2

# Optional first-administrator setup code; 32-128 characters.
# Generate a random value, for example with openssl rand -hex 32.
# If unset, Ludock generates one at startup; retrieve it locally with
# `docker compose logs ludock`. Configured values are never printed.
# Remove this setting after initial setup and keep it out of URLs and labels.
# LUDOCK_SETUP_CODE=

# Address and port Ludock listens on inside its container (default: :3000).
# Change the published port in compose.yaml instead of this.
# LUDOCK_LISTEN=:3000

# Folder for the database and its identity key (the image uses /data).
# LUDOCK_DATA_DIR=/data

# Docker socket path INSIDE Ludock, for deployments with a different mount target.
# LUDOCK_DOCKER_SOCKET=/var/run/docker.sock

# Override only when the Docker hostname cannot identify the Ludock container.
# LUDOCK_SELF_CONTAINER=your-ludock-container-name

# Optional dedicated read-only folder with a Docker config.json, for updating
# servers whose images come from private registries. Ludock reads the inline
# "auths" entries that `docker login` saves without a credential helper.
# This may contain credentials. Do not expose it as a game file root.
# LUDOCK_DOCKER_CONFIG=/registry-auth

# Additional protected container/host paths, separated by ':'.
# LUDOCK_SENSITIVE_PATHS=/srv/private:/data/private

# Optional helper image override; by default helpers use Ludock's own image.
# Pin it by digest and validate it on linux/amd64 and linux/arm64.
# LUDOCK_HELPER_IMAGE=registry.example.com/ludock:tested-version@sha256:<verified-digest>
