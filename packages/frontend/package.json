{
  "name": "@ludock/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/dev.mjs --frontend",
    "build": "bun run typecheck && bun run build:assets",
    "build:assets": "bun scripts/build.ts",
    "typecheck": "bun check -b",
    "lint": "oxlint .",
    "preview": "bun scripts/preview.ts",
    "test": "bun test --isolate --preload ./test/setup.ts ./test",
    "test:e2e": "bun check -p e2e/tsconfig.json && playwright test",
    "screenshots": "bun check -p e2e/tsconfig.json && playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@ludock/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0"
  }
}
