{
  "name": "@ludock/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run typecheck && bun run build:assets",
    "build:assets": "bun scripts/build.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "preview": "bun scripts/preview.ts",
    "test": "bun test --isolate --preload ./test/setup.ts ./test",
    "test:e2e": "tsc --project e2e/tsconfig.json && playwright test",
    "screenshots": "tsc --project e2e/tsconfig.json && playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@ludock/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  }
}
