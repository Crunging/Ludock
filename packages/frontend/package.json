{
  "name": "@ludock/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "tsc -b && bun scripts/build.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "bun scripts/preview.ts",
    "test": "bun test --isolate --preload ./test/setup.ts ./test && bun test ./scripts/test",
    "test:e2e": "tsc --project e2e/tsconfig.json && playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@ludock/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "jsdom": "^29.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1"
  }
}
