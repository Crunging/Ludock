{
  "name": "@ludock/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/watch-backend.mjs",
    "build": "bun build src/index.ts src/recovery.ts --target=bun --outdir=dist --sourcemap=linked --packages=external",
    "lint": "eslint .",
    "test": "bun test --isolate ./test",
    "recover": "bun src/recovery.ts",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.typechecks.json"
  },
  "dependencies": {
    "@ludock/shared": "workspace:*",
    "dockerode": "^5.0.1",
    "tar-stream": "3.2.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.13.4",
    "@types/tar-stream": "^3.1.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "@types/bun": "^1.4.2"
  }
}
