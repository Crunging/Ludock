{
  "name": "@ludock/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/dev.mjs --backend",
    "build": "bun ../../scripts/build-backend.mjs",
    "lint": "oxlint .",
    "lint:scripts": "cd ../.. && oxlint --config scripts/.oxlintrc.json scripts",
    "test": "bun test --parallel ./test",
    "recover": "bun src/recovery.ts",
    "start": "bun --disallow-code-generation-from-strings=strict dist/index.js",
    "typecheck": "bun check && bun check -p tsconfig.test.json"
  },
  "dependencies": {
    "@ludock/shared": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004"
  }
}
