// AuditKeys are the recorded actions whose names contain text, so a search
// finds what the page shows. Server work recorded with a result also matches.
func AuditKeys(text string) []string {
	text = strings.ToLower(strings.TrimSpace(text))
	var keys []string
	if text == "" {
		return nil
	}
	for key, label := range auditLabels {
		if strings.Contains(strings.ToLower(label), text) {
			keys = append(keys, key)
		}
	}
	for action, label := range playerActionLabels {
		if strings.Contains(strings.ToLower(label), text) {
			keys = append(keys, "server.player-action#"+action)
		}
	}
	if strings.Contains("outage", text) {
		keys = append(keys, outages...)
	}
	slices.Sort(keys)
	return keys
}

// AuditLabel names a recorded action, or shows it as recorded when it is
// new to this list.
func AuditLabel(action string) string {
	if label := auditLabels[action]; label != "" {
		return label
	}
	if kind, ok := strings.CutPrefix(action, "server."); ok {
		for _, status := range append([]string{"started"}, operationStatuses...) {
			kind = strings.TrimSuffix(kind, "."+status)
		}
		if label := auditLabels["server."+kind]; label != "" {
			return label
		}
		if !strings.Contains(kind, ".") {
			return Capitalize(kind)
		}
	}
	return Capitalize(strings.ReplaceAll(action, ".", " "))
}

// ludockUpdateLabel says which versions an update of Ludock went between and
// how it ended.
func ludockUpdateLabel(action string, details map[string]any) string {
	from, _ := details["from"].(string)
	to, _ := details["to"].(string)
	reason, _ := details["reason"].(string)
	outcome, _ := details["outcome"].(string)
	versions := " from version " + from
	if to != "" {
		versions += " to version " + to
	}
	reason = strings.TrimSuffix(reason, ".")
	switch {
	case action == "ludock.update.succeeded":
		return "Updated Ludock" + versions
	case action == "ludock.update.already_current":
		return "Updated Ludock: it already ran the newest image"
	case action == "ludock.update.started":
		return "Updating Ludock" + versions
	case outcome == "put_back":
		return "Updated Ludock" + versions + ", put back: " + reason
	case outcome == "interrupted":
		return "Updated Ludock" + versions + ", stopped partway"
	}
	return "Updated Ludock" + versions + ", failed: " + reason
}

var playerActionLabels = map[string]string{"kick": "Kicked", "ban": "Banned", "unban": "Unbanned",
	"allow": "Added to the allowlist:", "disallow": "Removed from the allowlist:"}

// entryLabel names an entry, saying what was done to which player.
func entryLabel(entry history.AuditEntry) string {
	details, _ := entry.Details.(map[string]any)
	if strings.HasPrefix(entry.Action, "server.player-action.") && details != nil {
		action, _ := details["action"].(string)
		player, _ := details["player"].(string)
		if label := playerActionLabels[action]; label != "" && player != "" {
			return label + " " + player
		}
	}
	if from, _ := details["from"].(string); entry.Action == "server.taken-over" && from != "" {
		return "Moved " + from + "’s backups, schedules, and sharing here"
	}
	if strings.HasPrefix(entry.Action, "ludock.update.") && details != nil {
		return ludockUpdateLabel(entry.Action, details)
	}
	return AuditLabel(entry.Action)
}

// outageStarts are the actions Ludock logs as an outage is alerted;
// outages, all it logs about outages, which a search for "outage" finds.
var (
	outageStarts = []string{"server.outage.alerted", "server.silence.alerted", "server.unreachable.alerted"}
	outages      = append(slices.Clone(outageStarts), "server.outage.ended", "server.silence.ended", "server.unreachable.ended")
)

// outageSince is when the outage an entry announced began, or 0.
func outageSince(entry history.AuditEntry) int64 {
	details, _ := entry.Details.(map[string]any)
	since, _ := details["since"].(float64)
	if !slices.Contains(outageStarts, entry.Action) {
		return 0
	}
	return int64(since)
}

// addedName is what an added server was called when it was added; the
// entry is written before the server has an ID. Entries from before names
// were recorded have only the container's.
func addedName(entry history.AuditEntry) string {
	details, _ := entry.Details.(map[string]any)
	if entry.Action != "server.added" || details == nil {
		return ""
	}
	if name, _ := details["name"].(string); name != "" {
		return name
	}
	name, _ := details["container"].(string)
	return name
}

templ auditList(h HistoryView) {
	<div class="audit-list">
		for _, entry := range h.Entries {
			<article class="audit-entry">
				<div>
					<strong>{ entryLabel(entry) }</strong>
					if since := outageSince(entry); since > 0 {
						<span>Since @Time(since, "", "")</span>
					}
					<span>{ auditActor(entry) }</span>
					if by := cancelledBy(entry, h.Users); by != "" {
						<span>Cancelled by { by }</span>
					}
					if entry.Status != "" {
						<span>
							@Pip(OperationTones[entry.Status])
							{ OperationStatusLabels[entry.Status] }
						</span>
					} else if strings.HasSuffix(entry.Action, ".started") {
						// Work whose outcome was never recorded: still running, or
						// cut off by a restart.
						<span>
							@Pip("active")
							No result yet
						</span>
					}
				</div>
				<div>
					if entry.TargetType == "server" && entry.TargetID != "" {
						<a class="text-link" href={ templ.SafeURL("/activity?serverId=" + url.QueryEscape(entry.TargetID)) }>
							if name := h.Names[entry.TargetID]; name != "" {
								{ name }
							} else {
								A server Ludock no longer has
							}
						</a>
					} else if entry.TargetType == "user" && entry.TargetID != "" {
						if name := h.Users[entry.TargetID]; name != "" {
							<span>{ name }</span>
						} else {
							<span>A deleted user</span>
						}
					} else if name := addedName(entry); name != "" {
						<span>{ name }</span>
					} else {
						<span>—</span>
					}
					@Time(entry.CreatedAt, "", "")
					if entry.OperationID != "" {
						<div class="history-entry-links">
							<a class="text-link" href={ templ.SafeURL("/activity/" + entry.OperationID) }>Details</a>
						</div>
					}
				</div>
			</article>
		}
		if h.Error == "" && len(h.Entries) == 0 {
			<div class="empty-state">
				<div class="empty-state__title">
					if h.filtered() {
						Nothing matches these filters
					} else {
						Nothing recorded yet
					}
				</div>
			</div>
		}
	</div>
}

type OperationDetailView struct {
	Operation   *ops.Job
	Actor       *history.Actor
	CancelledBy *history.Actor
	CanCancel   bool
	ServerName  string
	Admin       bool
	// Archives offers the download of a backup the operation made.
	Archives bool
	Error    string
}

templ OperationDetailPage(page Page, o OperationDetailView) {
	@Shell(page) {
		<div class="page history-page">
			<div class="page__header page__header--actions">
				<div>
					<h1 class="page__title">Activity details</h1>
					<p class="page__subtitle">Progress and the recorded result.</p>
				</div>
				if o.Operation != nil {
					<a class="secondary-btn" href={ templ.SafeURL("/activity/" + o.Operation.ID) }>Refresh</a>
				}
			</div>
			if o.Error != "" {
				@Alert("error", o.Error)
				<p><a class="text-link" href="/activity">Activity</a></p>
			} else {
				<div id="operation-status" aria-live="polite"></div>
				@OperationSummary(o)
			}
		</div>
	}
}

// OperationSummary reloads itself while the operation is active.
templ OperationSummary(o OperationDetailView) {
	{{ operation := o.Operation }}
	<div
		id="operation-summary"
		if ActiveStatus(operation.Status) {
			hx-get={ "/fragments/activity/" + operation.ID }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		<dl class="metadata-list operation-detail-summary">
			<dt>Action</dt>
			<dd>{ Capitalize(operation.Kind) }</dd>
			if item, _ := operation.Input["item"].(string); item != "" && o.Archives {
				<dt>Restored item</dt>
				<dd>{ item }</dd>
			}
			<dt>Status</dt>
			<dd
				if ActiveStatus(operation.Status) {
					role="status"
				}
			>
				@Pip(OperationTones[operation.Status])
				{ OperationStatusLabels[operation.Status] }
			</dd>
			<dt>Server</dt>
			<dd>
				<a class="text-link" href={ templ.SafeURL("/servers/" + operation.ServerID) }>
					if o.ServerName != "" {
						{ o.ServerName }
					} else {
						{ operation.ServerID }
					}
				</a>
			</dd>
			<dt>By</dt>
			<dd>{ ActorLabel(o.Actor) }</dd>
			<dt>When</dt>
			<dd>@Time(operation.CreatedAt, "", "")</dd>
			<dt>Last updated</dt>
			<dd>@Time(operation.UpdatedAt, "", "")</dd>
			if ActiveStatus(operation.Status) {
				<dt>Progress</dt>
				<dd>{ OperationLabel(operation.Status, operation.Phase) }</dd>
			}
		</dl>
		if o.CanCancel {
			<p class="inline-actions">
				@CancelButton(operation.ServerID, operation.ID, operation.Kind, "#operation-status")
			</p>
		}
		if operation.Status == "cancelled" {
			<p class="section-note">{ CancelledNote(o.CancelledBy) }</p>
		}
		if operation.Error != "" {
			<p class="operation-error">{ operation.Error }</p>
		}
		if detail := SaveDetail(operation.Result); detail != "" {
			<p class="section-note">{ detail }</p>
		}
		if detail := WarnDetail(operation.Result); detail != "" {
			<p class="section-note">{ detail }</p>
		}
		if detail := MovedDetail(operation.Result); detail != "" {
			<p class="section-note">{ detail }</p>
		}
		if detail := LeftOutDetail(operation.Result); detail != "" {
			<p class="section-note">{ detail }</p>
		}
		if detail := ACLsLostDetail(operation.Result); detail != "" {
			<p class="section-note">{ detail }</p>
		}
		if detail := DockerWaitDetail(operation.Result); detail != "" {
			<p class="section-note">{ detail }</p>
		}
		if text := guidance(operation.Result); text != "" {
			<p class="section-note">{ text }</p>
		}
		if o.Archives {
			@backupDownload(operation)
		}
		<div class="inline-actions operation-detail-actions history-entry-links">
			<a class="text-link" href={ templ.SafeURL("/activity?serverId=" + url.QueryEscape(operation.ServerID)) }>More from this server</a>
			if o.Admin {
				<a class="text-link" href={ templ.SafeURL("/activity?show=" + ShowEverything + "&operationId=" + url.QueryEscape(operation.ID)) }>Everything recorded about it</a>
			}
		</div>
	</div>
}
