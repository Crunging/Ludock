package views

import (
	"slices"
	"strconv"

	"github.com/Crunging/Ludock/internal/authz"
	"github.com/Crunging/Ludock/internal/db"
)

type UsersView struct {
	Users     []db.User
	CurrentID string
	Error     string
	Notice    string
	// Draft keeps the create form's username and role after an error.
	DraftName string
	DraftRole db.Role
	// DraftPassword keeps "Set a password now" chosen after an error.
	DraftPassword bool
	// Reach lists the servers shared with each member.
	Reach map[string][]Reach
	// Link is a link just made, shown this once.
	Link *LinkResult
}

// Reach is one server shared with a member.
type Reach struct {
	ServerID, Name string
	Level          authz.Level
}

// LinkResult is a new invite or reset link for the administrator to send.
type LinkResult struct {
	Username, URL string
	Purpose       db.LinkPurpose
	ExpiresAt     int64
}

func (l LinkResult) noun() string {
	if l.Purpose == db.LinkInvite {
		return "Invite link"
	}
	return "Password reset link"
}

var roleHelp = map[db.Role]string{
	db.RoleAdmin:  "Administrators can use every server and change users and settings.",
	db.RoleMember: "Members use only the servers you share with them, from each server’s Sharing tab.",
}

var roles = []struct {
	Value db.Role
	Label string
}{{db.RoleMember, "Member"}, {db.RoleAdmin, "Administrator"}}

templ UsersPage(page Page, u UsersView) {
	@Shell(page) {
		<div class="page users-page">
			<div class="page__header">
				<h1 class="page__title">Users</h1>
				<p class="page__subtitle">Everyone who can sign in, and what each can use. To share a server, open it and choose Sharing.</p>
			</div>
			@UsersContent(u)
		</div>
	}
}

// UsersContent is replaced after every account change.
templ UsersContent(u UsersView) {
	<div id="users">
		if u.Error != "" {
			@Alert("error", u.Error)
		}
		if u.Notice != "" {
			@Alert("success", u.Notice)
		}
		if u.Link != nil {
			@linkResult(*u.Link)
		}
		<form class="settings-card create-user" hx-post="/users" hx-target="#users" hx-swap="outerHTML">
			<h2>Add a person</h2>
			<div class="form-grid">
				<label>
					<span>Username</span>
					<input name="username" value={ u.DraftName } minlength="3" maxlength="32" pattern="[a-zA-Z0-9._\-]+" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="create-user-username-help" required/>
				</label>
				<label>
					<span>Account</span>
					<select name="role" aria-describedby="create-user-role-help" id="create-user-role">
						for _, role := range roles {
							<option value={ string(role.Value) } selected?={ draftRole(u) == role.Value }>{ role.Label }</option>
						}
					</select>
				</label>
				<label data-shown-when="access=password" hidden?={ !u.DraftPassword }>
					<span>Initial password</span>
					// No minlength: the field stays in the form while hidden, and a
					// partial password would block an invite.
					<input type="password" name="password" maxlength="128" autocomplete="new-password" aria-describedby="create-user-access-help"/>
				</label>
				<button class="primary-btn" type="submit" data-busy-label="Creating…">Create user</button>
			</div>
			<fieldset class="create-user__access">
				<legend>First sign-in</legend>
				<label>
					<input type="radio" name="access" value="link" checked?={ !u.DraftPassword } aria-describedby="create-user-access-help"/>
					Make an invite link
				</label>
				<label>
					<input type="radio" name="access" value="password" checked?={ u.DraftPassword } aria-describedby="create-user-access-help"/>
					Set a password now
				</label>
			</fieldset>
			<div class="admin-form-help">
				<p id="create-user-username-help">Usernames use 3–32 letters, numbers, periods, hyphens, or underscores.</p>
				<p id="create-user-role-help">
					for _, role := range roles {
						<span data-shown-when={ "role=" + string(role.Value) } hidden?={ draftRole(u) != role.Value }>
							{ roleHelp[role.Value] }
						</span>
					}
				</p>
				<p id="create-user-access-help">
					<span data-shown-when="access=link" hidden?={ u.DraftPassword }>
						You get a one-time link to send them. They choose their own password; the account can’t sign in until they do.
					</span>
					<span data-shown-when="access=password" hidden?={ !u.DraftPassword }>
						Use at least { strconv.Itoa(passwordMin) } characters. Share the password securely; the user can change it in Account after signing in.
					</span>
				</p>
			</div>
		</form>
		<div class="settings-list">
			for _, user := range u.Users {
				@userRow(u, user)
			}
		</div>
	</div>
}

func draftRole(u UsersView) db.Role {
	if u.DraftRole == "" {
		return db.RoleMember
	}
	return u.DraftRole
}

templ userRow(u UsersView, user db.User) {
	<section class={ "settings-card user-row", templ.KV("user-row--two-factor", user.TwoFactor && user.ID != u.CurrentID) }>
		<div class="user-row__identity">
			<strong>{ user.Username }</strong>
			<span>
				Created @Time(user.CreatedAt, "date", "")
				if user.Disabled {
					<strong class="user-row__disabled">Disabled</strong>
				}
				if user.TwoFactor {
					<span class="user-row__two-factor">Two-factor on</span>
				}
				if !user.PasswordSet && user.Link == nil {
					<strong class="user-row__disabled user-row__no-password">No password yet</strong>
				}
			</span>
		</div>
		<div class="user-row__reach">
			if user.Role == db.RoleAdmin {
				<span>Administrator · every server and setting</span>
			} else if len(u.Reach[user.ID]) == 0 {
				<span class="muted">Nothing shared yet</span>
			} else {
				<ul aria-label={ "Servers shared with " + user.Username }>
					for _, reach := range u.Reach[user.ID] {
						<li><a href={ "/servers/" + reach.ServerID + "?tab=sharing" }>{ reach.Name }</a> <span class="muted">{ LevelName(reach.Level) }</span></li>
					}
				</ul>
			}
		</div>
		{{ last := u.lastAdmin(user) }}
		if !last {
			<button class="secondary-btn" type="button" hx-post={ "/users/" + user.ID + "/access" } hx-vals={ accessValues(user) } hx-target="#users" hx-swap="outerHTML" data-busy-label="Working…">
				if user.Disabled {
					Enable
				} else {
					Disable
				}
			</button>
		}
		if !user.Disabled && !last {
			if user.Role == db.RoleAdmin {
				<button
					class="secondary-btn"
					type="button"
					hx-post={ "/users/" + user.ID + "/access" }
					hx-vals={ roleValues(db.RoleMember) }
					hx-target="#users"
					hx-swap="outerHTML"
					hx-confirm={ "Make " + user.Username + " a member?" }
					data-confirm-detail="They keep their account but no longer manage users or settings, and start with no servers shared. Share servers with them from each server’s Sharing tab."
					data-confirm-action="Make member"
				>Make member</button>
			} else {
				<button
					class="secondary-btn"
					type="button"
					hx-post={ "/users/" + user.ID + "/access" }
					hx-vals={ roleValues(db.RoleAdmin) }
					hx-target="#users"
					hx-swap="outerHTML"
					hx-confirm={ "Make " + user.Username + " an administrator?" }
					data-confirm-detail="They can use and update every server, and manage users and settings, including yours."
					data-confirm-action="Make administrator"
				>Make administrator</button>
			}
		}
		<div class="password-reset">
			if user.ID != u.CurrentID && !user.Disabled {
				<button class="secondary-btn" type="button" hx-post={ "/users/" + user.ID + "/link" } hx-target="#users" hx-swap="outerHTML" data-busy-label="Working…">
					if user.PasswordSet {
						Reset link
					} else {
						Invite link
					}
				</button>
			}
			<details class="password-reset__manual">
				<summary>Set password</summary>
				<form hx-post={ "/users/" + user.ID + "/reset-password" } hx-target="#users" hx-swap="outerHTML">
					<input type="password" name="password" placeholder="New password" aria-label={ "New password for " + user.Username } autocomplete="new-password" minlength={ strconv.Itoa(passwordMin) } maxlength="128" required/>
					<button class="secondary-btn" type="submit" data-busy-label="Working…">Save</button>
				</form>
			</details>
		</div>
		if user.TwoFactor && user.ID != u.CurrentID {
			<button
				class="secondary-btn"
				type="button"
				hx-post={ "/users/" + user.ID + "/reset-two-factor" }
				hx-target="#users"
				hx-swap="outerHTML"
				hx-confirm={ "Turn off two-factor sign-in for " + user.Username + "?" }
				data-confirm-detail="Use this when they lost their phone and recovery codes. It signs them out everywhere; they sign in with just their password and can set it up again."
				data-confirm-action="Turn off two-factor"
			>Turn off two-factor</button>
		}
		if user.ID != u.CurrentID && !last {
			<button
				class="secondary-btn secondary-btn--danger"
				type="button"
				hx-post={ "/users/" + user.ID + "/delete" }
				hx-target="#users"
				hx-swap="outerHTML"
				hx-confirm={ "Delete " + user.Username + "?" }
				data-confirm-detail="This signs them out everywhere and can’t be undone."
				data-confirm-action="Delete user"
				data-confirm-danger
			>Delete</button>
		}
		if user.Link != nil {
			<div class="user-row__link">
				<p>
					if user.Link.Purpose == db.LinkInvite {
						Invite link waiting to be used.
					} else {
						Password reset link waiting to be used.
					}
					It expires @Time(user.Link.ExpiresAt, "plain", "")<span>.</span>
				</p>
				<button
					class="secondary-btn"
					type="button"
					hx-post={ "/users/" + user.ID + "/link/revoke" }
					hx-target="#users"
					hx-swap="outerHTML"
					data-busy-label="Revoking…"
				>Revoke link</button>
			</div>
		}
	</section>
}

templ linkResult(link LinkResult) {
	<section class="settings-card link-result" aria-labelledby="link-result-title">
		<h2 id="link-result-title">{ link.noun() + " for " + link.Username }</h2>
		<p>
			Send this to { link.Username } privately: anyone who opens it can set the password. It works once and expires @Time(link.ExpiresAt, "", "")<span>.</span>
			Ludock won’t show it again; make a new link if you lose it.
		</p>
		<div class="link-result__field">
			<input type="text" value={ link.URL } readonly aria-label={ link.noun() + " for " + link.Username } spellcheck="false"/>
			<button class="primary-btn" type="button" data-copy={ link.URL } data-copied-label="Copied">Copy link</button>
		</div>
	</section>
}

// lastAdmin reports whether user is the only enabled administrator who can
// sign in, whom Ludock refuses to disable, demote, or delete.
func (u UsersView) lastAdmin(user db.User) bool {
	if user.Role != db.RoleAdmin || user.Disabled || !user.PasswordSet {
		return false
	}
	return !slices.ContainsFunc(u.Users, func(other db.User) bool {
		return other.ID != user.ID && other.Role == db.RoleAdmin && !other.Disabled && other.PasswordSet
	})
}

func accessValues(user db.User) string {
	return `{"disabled":"` + strconv.FormatBool(!user.Disabled) + `"}`
}

func roleValues(role db.Role) string {
	return `{"role":"` + string(role) + `"}`
}
