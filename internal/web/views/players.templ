package views

import (
	"encoding/hex"
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/games"
	"github.com/Crunging/Ludock/internal/players"
)

type PlayersView struct {
	// Listed: Ludock can read this server's players over its console or
	// status query.
	Listed bool
	// Running: the server is running and its live state is known.
	Running bool
	// Console names the console players are read over, and Query the
	// status query that counts them; either may be "".
	Console string
	Query   string
	// Reading is nil until the first one after the server started.
	Reading *players.Reading
	// Moderation is set when the viewer may act on this server's players
	// through its console.
	ServerID   string
	Moderation *games.Moderation
}

// Limits on the names a page shows; the rest are counted.
const (
	rowNames    = 3
	detailNames = 50
	// maxSlots is the largest capacity drawn as one block per player.
	maxSlots = 64
)

// playersKnown: the view has a player count to show.
func playersKnown(p PlayersView) bool {
	return p.Listed && p.Running && p.Reading != nil && !p.Reading.Failed
}

// unlisted counts players beyond the first limit names, including any the
// game didn't name.
func unlisted(reading *players.Reading, limit int) int {
	return max(reading.Online, len(reading.Names)) - min(limit, len(reading.Names))
}

func someNames(reading *players.Reading, limit int) []string {
	return reading.Names[:min(limit, len(reading.Names))]
}

func capacity(reading *players.Reading) string {
	if reading.Max == 0 {
		return ""
	}
	return "/" + strconv.Itoa(reading.Max)
}

func onlineText(reading *players.Reading) string {
	if reading.Max == 0 {
		return "online"
	}
	return "of " + strconv.Itoa(reading.Max) + " online"
}

func playerShare(reading *players.Reading) string {
	return "width: " + strconv.FormatFloat(min(100, float64(reading.Online)/float64(reading.Max)*100), 'f', 1, 64) + "%"
}

// PlayersCell is the server list's players column.
templ PlayersCell(p PlayersView) {
	<div class={ "server-row__players", templ.KV("server-row__players--quiet", !p.Listed || !p.Running) }>
		<span class="server-row__label">Players</span>
		switch {
			case !p.Listed:
				<span class="muted" title="Ludock can’t list players for this server">—<span class="sr-only">Not available</span></span>
			case !p.Running:
				<span class="muted">—<span class="sr-only">Not running</span></span>
			case p.Reading == nil:
				<span class="muted">Checking…</span>
			case p.Reading.Failed:
				<span class="muted" title="Ludock couldn’t read the server’s players">Unknown</span>
			default:
				<span class={ "player-count", templ.KV("player-count--empty", p.Reading.Online == 0) }>
					// One line, so the count and capacity read as "2/10".
					<strong>{ strconv.Itoa(p.Reading.Online) }</strong><span aria-hidden="true">{ capacity(p.Reading) }</span><span class="sr-only">{ " " + onlineText(p.Reading) }</span>
				</span>
				if len(p.Reading.Names) > 0 {
					<span class="server-row__player-names">
						{ strings.Join(someNames(p.Reading, rowNames), ", ") }
						if more := unlisted(p.Reading, rowNames); more > 0 {
							<span class="muted">+{ strconv.Itoa(more) }</span>
						}
					</span>
				}
		}
	</div>
}

// PlayersFact is the overview's players entry: a count, the server's
// capacity drawn as one block per player slot, and the names.
templ PlayersFact(p PlayersView) {
	<div class="overview-players">
		<dt>Players</dt>
		<dd>
			switch {
				case !p.Listed:
					<span class="muted">Not available. Ludock lists players for supported games that can tell it who’s online.</span>
				case !p.Running:
					<span class="muted">Shown while the server is running</span>
				case p.Reading == nil:
					<span class="muted">Checking who’s online…</span>
				case p.Reading.Failed:
					<span>Couldn’t read players</span>
					if p.Console != "" {
						<span class="muted">Ludock reads them over the game console. Check that it’s on and works. Checked @Time(p.Reading.CheckedAt, "plain", "")</span>
					} else {
						<span class="muted">Ludock counts them with the game’s status query, which hasn’t said how many are online. Checked @Time(p.Reading.CheckedAt, "plain", "")</span>
					}
				default:
					<span class="overview-figure">{ strconv.Itoa(p.Reading.Online) }</span>
					<span class="muted">{ onlineText(p.Reading) }</span>
					if p.Reading.Max > 0 && p.Reading.Max <= maxSlots {
						<span class="player-slots" aria-hidden="true">
							for slot := range p.Reading.Max {
								<span class={ "player-slot", templ.KV("player-slot--taken", slot < p.Reading.Online) }></span>
							}
						</span>
					} else if p.Reading.Max > 0 {
						<span class="overview-meter overview-meter--players" aria-hidden="true"><span style={ playerShare(p.Reading) }></span></span>
					}
					if len(p.Reading.Names) > 0 {
						<ul class="player-names" aria-label="Online players">
							for _, name := range someNames(p.Reading, detailNames) {
								if players.Actionable(p.Moderation, p.Reading, name) {
									<li id={ playerID(name, players.OnlineKey(p.Reading, name)) }>
										@playerMenu(p, name)
									</li>
								} else {
									<li><span class="player-name">{ name }</span></li>
								}
							}
						</ul>
					}
					if more := unlisted(p.Reading, detailNames); more > 0 && len(p.Reading.Names) > 0 {
						<span class="muted">and { strconv.Itoa(more) } more</span>
					}
					if p.Reading.Via == players.ViaQuery {
						<span class="overview-players__checked muted">Counted by the game’s status query @Time(p.Reading.CheckedAt, "plain", "")</span>
					} else {
						<span class="overview-players__checked muted">Checked @Time(p.Reading.CheckedAt, "plain", "")</span>
					}
			}
		</dd>
	</div>
}

// GameView is whether the game answers its status query, or the image's
// health check in its place.
type GameView struct {
	// Query is the check's name, or "" when the game isn't checked.
	Query string
	// Health: the check is the image's own health check.
	Health bool
	// Off is why the game's status query is off in this setup, or "".
	Off        string
	Running    bool
	State      players.Game
	AnsweredAt int64
}

// GameFact is the overview's entry for whether the game itself answers.
templ GameFact(g GameView) {
	<div class="overview-game">
		<dt>Game</dt>
		<dd>
			switch {
				case g.Query == "" && g.Off != "":
					<span>Not checked</span>
					<span class="muted">{ g.Off }</span>
				case g.Query == "":
					<span>Not checked</span>
					<span class="muted">Ludock checks supported games that can answer, and ones whose image has a health check.</span>
				case !g.Running:
					<span class="muted">Checked while the server is running</span>
				case g.State == players.Answering && g.Health:
					@Pip("ok")
					<span>Answering</span>
					<span class="muted">Its image’s health check passed @Time(g.AnsweredAt, "plain", "")</span>
				case g.State == players.Answering:
					@Pip("ok")
					<span>Answering</span>
					<span class="muted">Over its status query, @Time(g.AnsweredAt, "plain", "")</span>
				case g.State == players.NotAnswering && g.Health:
					@Pip("failed")
					<span>Not answering</span>
					<span class="muted">The container is running, but its image’s health check keeps failing. It last passed @Time(g.AnsweredAt, "plain", "")</span>
				case g.State == players.NotAnswering:
					@Pip("failed")
					<span>Not answering</span>
					<span class="muted">The container is running, but the game stopped answering its status query. It last answered @Time(g.AnsweredAt, "plain", "")</span>
				case g.State == players.Unknown:
					<span>Not checked recently</span>
					<span class="muted">It last answered its status query @Time(g.AnsweredAt, "plain", "")</span>
				case g.Health:
					<span>Not answered yet</span>
					<span class="muted">Its image’s health check hasn’t passed since it started. A game that’s still starting doesn’t pass it.</span>
				default:
					<span>Not answered yet</span>
					<span class="muted">Ludock asks over its status query. A game that’s still starting, or whose query port is wrong or off, doesn’t answer.</span>
			}
		</dd>
	</div>
}

// playerID keys a player's chip by name and account, so a refresh that
// reorders the list, or gives the name to another account, never leaves an
// open menu acting on someone else.
func playerID(name, key string) string {
	return "player-" + hex.EncodeToString([]byte(name)) + "-" + key
}

// playerMenu is an online player's name, which opens what can be done to
// them. Results show in the page's status area, outside the live overview.
templ playerMenu(p PlayersView, name string) {
	{{ id := playerID(name, players.OnlineKey(p.Reading, name)) + "-actions" }}
	<div class="action-menu player-menu" data-action-menu>
		<button type="button" class="player-menu__trigger" aria-label={ name + ": actions" } aria-expanded="false" aria-controls={ id }>
			<span class="player-name">{ name }</span>
			<svg class="chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5"></path></svg>
		</button>
		<div class="action-menu__content action-menu__content--start" id={ id } hidden>
			if p.Moderation.Offers(games.Kick) {
				<form hx-post={ playerActionURL(p.ServerID, games.Kick) } hx-target="#detail-status">
					<input type="hidden" name="player" value={ name }/>
					<input type="hidden" name="key" value={ players.OnlineKey(p.Reading, name) }/>
					<button type="submit" class="action-menu__action">Kick</button>
				</form>
			}
			if p.Moderation.Offers(games.Ban) {
				<form
					hx-post={ playerActionURL(p.ServerID, games.Ban) }
					hx-target="#detail-status"
					hx-confirm={ "Ban " + name + "?" }
					data-confirm-detail={ banDetail(p.Moderation) }
					data-confirm-action="Ban player"
					data-confirm-danger
				>
					<input type="hidden" name="player" value={ name }/>
					<input type="hidden" name="key" value={ players.OnlineKey(p.Reading, name) }/>
					<button type="submit" class="action-menu__action action-menu__action--danger">Ban…</button>
				</form>
			}
		</div>
	</div>
}

func playerActionURL(serverID string, action games.PlayerAction) string {
	return "/servers/" + serverID + "/players/" + string(action)
}

func banDetail(moderation *games.Moderation) string {
	detail := "They’re removed from the server and can’t join again until the ban is lifted."
	if moderation.Offers(games.Unban) {
		detail += " You can lift it under Allowlist and bans."
	} else {
		detail += " Lifting it takes the game’s console."
	}
	return detail
}

// PlayerAlert is the result of a player action. Reply is the game's own
// words when Ludock doesn't recognize them.
type PlayerAlert struct {
	Kind, Message, Reply string
}

templ PlayerResult(a PlayerAlert) {
	<div class={ "alert", "alert--" + a.Kind } role={ map[bool]string{true: "alert", false: "status"}[a.Kind == "error"] }>
		{ a.Message }
		if a.Reply != "" {
			<span class="player-result__reply">The game replied: <q>{ a.Reply }</q></span>
		}
	</div>
}

// PlayerListsView is a game's allowlist and ban list.
type PlayerListsView struct {
	ServerID   string
	Moderation *games.Moderation
	Running    bool
	Lists      *players.Lists
	Error      string
	Alert      PlayerAlert
}

// PlayerListsDisclosure reads the lists the first time it opens.
templ PlayerListsDisclosure(serverID string) {
	<details
		class="disclosure player-lists"
		hx-get={ "/fragments/servers/" + serverID + "/player-lists" }
		hx-trigger="toggle once, player-lists-changed from:document, servers-changed from:document"
		hx-target="#player-lists-body"
		hx-swap="outerHTML"
	>
		<summary>Allowlist and bans</summary>
		<div id="player-lists-body" class="player-lists__body">
			<p class="muted">Reading the server’s lists…</p>
		</div>
	</details>
}

templ PlayerLists(v PlayerListsView) {
	<div id="player-lists-body" class="player-lists__body">
		<div aria-live="polite">
			if v.Alert.Message != "" {
				@PlayerResult(v.Alert)
			}
		</div>
		if v.Error != "" {
			<p class="muted">{ v.Error }. They’re read from the server’s data folder.</p>
		} else if v.Lists != nil {
			<section class="player-list" aria-labelledby="allowlist-title">
				<h3 id="allowlist-title">Allowlist</h3>
				if state := allowlistState(v.Lists); state != "" {
					<p class="muted">{ state }</p>
				}
				@listedPlayers(v, v.Lists.Allowed, games.Disallow, "Remove", "Nobody is on the allowlist.")
				<form class="player-add" hx-post={ playerActionURL(v.ServerID, games.Allow) } hx-target="#player-lists-body" hx-swap="outerHTML">
					<label>
						Player name
						<input type="text" name="player" required maxlength="16" pattern={ v.Moderation.Pattern() } autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="player-add-help" disabled?={ !v.Running }/>
					</label>
					<button type="submit" class="secondary-btn" disabled?={ !v.Running } data-busy-label="Adding…">Add to allowlist</button>
					<p class="muted" id="player-add-help">Their Minecraft name: letters, digits, and _, up to 16.</p>
				</form>
			</section>
			<section class="player-list" aria-labelledby="banlist-title">
				<h3 id="banlist-title">Banned</h3>
				@listedPlayers(v, v.Lists.Banned, games.Unban, "Lift ban", "Nobody is banned.")
			</section>
		}
		if !v.Running {
			<p class="muted">Start the server to change these lists.</p>
		}
	</div>
}

templ listedPlayers(v PlayerListsView, list games.ListedPlayers, action games.PlayerAction, label, empty string) {
	if len(list.Names) == 0 && list.Others == 0 {
		<p class="muted">{ empty }</p>
	} else {
		<ul class="player-list__names">
			for _, name := range list.Names {
				<li>
					<span class="player-name">{ name }</span>
					<form hx-post={ playerActionURL(v.ServerID, action) } hx-target="#player-lists-body" hx-swap="outerHTML">
						<input type="hidden" name="player" value={ name }/>
						<button type="submit" class="secondary-btn player-list__action" aria-label={ label + ": " + name } disabled?={ !v.Running } data-busy-label="Working…">{ label }</button>
					</form>
				</li>
			}
		</ul>
		if list.Others > 0 {
			<p class="muted">And { strconv.Itoa(list.Others) } more that Ludock can’t change here.</p>
		}
	}
}

func allowlistState(lists *players.Lists) string {
	switch {
	case !lists.AllowlistKnown:
		return ""
	case lists.AllowlistOn:
		return "On: only players on this list, and operators, can join."
	}
	return "Off in the server’s settings, so anyone can join. The list takes effect when the server turns it on."
}
