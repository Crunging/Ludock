package views

import (
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/games"
	"github.com/Crunging/Ludock/internal/servers"
)

type SystemView struct {
	DockerConnected bool
	Diagnostics     []servers.Diagnostic
}

func dashIfEmpty(text string) string {
	if text == "" {
		return "—"
	}
	return text
}

func consoleText(f games.Features) string {
	if f.AnnouncePort != 0 {
		return f.Console + ", with warnings over its REST API"
	}
	return dashIfEmpty(f.Console)
}

// statusCheckText names the status check; without one, a health check the
// image has stands in, which the images Ludock knows are listed as having.
func statusCheckText(f games.Features) string {
	switch {
	case f.StatusCheck != "":
		return f.StatusCheck + ", port " + strconv.Itoa(f.StatusPort)
	case f.ImageHealthCheck:
		return "The image’s health check"
	}
	return "The image’s health check, if it has one"
}

// settingsTabs moves between Settings and System, which share the menu entry.
templ settingsTabs(current string) {
	<nav class="section-tabs" aria-label="Settings pages">
		for _, tab := range []DetailTab{{ID: "/settings", Label: "General"}, {ID: "/settings/system", Label: "System"}} {
			<a href={ templ.SafeURL(tab.ID) } aria-current={ map[bool]string{true: "page"}[tab.ID == current] }>{ tab.Label }</a>
		}
	</nav>
}

templ SystemPage(page Page, d SystemView) {
	@Shell(page) {
		<div class="page">
			<div class="page__header page__header--actions">
				<div>
					<h1 class="page__title">Settings</h1>
					<p class="page__subtitle">Ludock’s connection to Docker, problems with container labels, and the games it recognizes.</p>
				</div>
				<a class="secondary-btn" href="/settings/system">Refresh</a>
			</div>
			@settingsTabs("/settings/system")
			<dl class="metadata-list">
				<dt>Docker</dt>
				<dd>
					if d.DockerConnected {
						Connected
					} else {
						Can’t reach Docker
					}
				</dd>
			</dl>
			if !d.DockerConnected {
				<section class="help-panel system-help" aria-labelledby="docker-help-title">
					<h2 id="docker-help-title">Connect Ludock to Docker</h2>
					<p>Check that Docker is running on the host where Ludock is installed. The Ludock container needs its Docker socket mounted:</p>
					<pre><code>/var/run/docker.sock:/var/run/docker.sock:ro</code></pre>
					<p>
						In <code>compose.yaml</code>, change the socket mount’s <code>source</code> to the socket path on the Docker host.
						For rootless Docker, this is usually <code>/run/user/1000/docker.sock</code>; replace <code>1000</code> with the Docker user’s ID.
					</p>
					<p>
						Run <code>docker compose up -d --force-recreate ludock</code> from Ludock’s Compose folder, then refresh this page.
						Custom deployments must match the mount’s container path to <code>LUDOCK_DOCKER_SOCKET</code>.
						<code>docker compose logs ludock</code> shows what Ludock reported.
					</p>
				</section>
			}
			<section class="settings-section">
				<h2>Container label problems</h2>
				<div class="table-scroll">
					<table class="data-table">
						<thead>
							<tr>
								<th>Container</th>
								<th>Problem</th>
							</tr>
						</thead>
						<tbody>
							if len(d.Diagnostics) == 0 {
								<tr>
									<td colspan="2" class="muted">
										if d.DockerConnected {
											None.
										} else {
											Shown once Ludock can reach Docker.
										}
									</td>
								</tr>
							}
							for _, diagnostic := range d.Diagnostics {
								<tr>
									<td>
										if diagnostic.Name != "" {
											{ diagnostic.Name }
										} else {
											—
										}
									</td>
									<td>{ diagnostic.Message }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
			<section class="settings-section">
				<h2>Supported games</h2>
				<p class="section-note">Ludock adds servers on these images by itself, unless the container can control the host. To add another container, choose it under <strong>Missing a server?</strong> on the server list, or label it <code>ludock.enable: "true"</code>.</p>
				<div class="table-scroll">
					<table class="data-table">
						<thead>
							<tr>
								<th>Game</th>
								<th>Images</th>
								<th>Console</th>
								<th>Status check</th>
								<th>Who’s online</th>
								<th>Kick and ban</th>
								<th>Warnings to players</th>
								<th>Restart updates the game</th>
							</tr>
						</thead>
						<tbody>
							for _, game := range games.Integrations {
								{{ f := game.Features() }}
								<tr>
									<td>{ game.Name }</td>
									<td>{ strings.Join(game.Repositories, ", ") }</td>
									<td>{ consoleText(f) }</td>
									<td>{ statusCheckText(f) }</td>
									<td>{ dashIfEmpty(f.Players) }</td>
									<td>{ dashIfEmpty(f.Moderation) }</td>
									<td>{ map[bool]string{true: "Yes", false: "—"}[f.Warnings] }</td>
									<td>{ map[bool]string{true: "Yes", false: "—"}[f.RestartUpdates] }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<p class="section-note">Names need the console’s password; a count comes from the status check. Restart updates the game unless the image’s own settings pin a version or skip updates.</p>
			</section>
		</div>
	}
}
