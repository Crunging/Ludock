package views

import (
	"strconv"

	"github.com/Crunging/Ludock/internal/backups"
	"github.com/Crunging/Ludock/internal/notify"
)

// SettingsView is the settings page.
type SettingsView struct {
	Connection        ConnectionSettings
	Backups           BackupSettingsView
	Notifications     NotificationSettingsView
}

// ConnectionSettings is the public address form.
type ConnectionSettings struct {
	Host, PageHost string
	Error, Notice  string
}

// BackupSettingsView is the backup storage form. Sizes are GiB text so an
// untouched value saves the exact byte count.
type BackupSettingsView struct {
	Configured                    bool
	Destination                   string
	Retention, MaxGiB, ReserveGiB string
	Roots                         []string
	Error                         string
	Saved                         bool
}

// NotificationSettingsView is the Discord form.
type NotificationSettingsView struct {
	Configured, Enabled bool
	Error, Notice       string
}

templ SettingsPage(page Page, s SettingsView) {
	@Shell(page) {
		<div class="page settings-page">
			<div class="page__header">
				<h1 class="page__title">Settings</h1>
				<p class="page__subtitle">Server controls work without any setup. Changes here take effect when saved.</p>
			</div>
			<nav class="settings-jump-links" aria-label="Settings sections">
				<a class="text-link" href="#connection-settings-title">Server address</a>
				<a class="text-link" href="#backup-settings-title">Backup storage</a>
				<a class="text-link" href="#notification-settings-title">Discord notifications</a>
			</nav>
			<section class="settings-section settings-section--divided" aria-labelledby="connection-settings-title">
				<h2 id="connection-settings-title" tabindex="-1">Server address</h2>
				@ConnectionForm(s.Connection)
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="backup-settings-title">
				<h2 id="backup-settings-title" tabindex="-1">Backup storage</h2>
				@BackupSettingsForm(s.Backups)
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="notification-settings-title">
				<h2 id="notification-settings-title" tabindex="-1">Discord notifications</h2>
				@NotificationForm(s.Notifications)
				<div id="notification-deliveries" hx-get="/fragments/settings/deliveries" hx-trigger="load, notifications-changed from:body" hx-swap="innerHTML">
					<p class="muted" role="status">Loading notification deliveries…</p>
				</div>
			</section>
		</div>
	}
}

templ ConnectionForm(c ConnectionSettings) {
	<form class="stack-form" id="connection-form" hx-post="/settings/connection" hx-target="this" hx-swap="outerHTML" hx-disinherit="*">
		<p class="section-lede">The name or IP address players use to reach this host. Ludock adds each server’s port and shows the result with a copy button.</p>
		<label class="narrow-field">
			Public address
			<input name="host" value={ c.Host } placeholder={ c.PageHost } maxlength="253" autocapitalize="none" autocomplete="off" spellcheck="false" aria-describedby="connection-host-help"/>
		</label>
		<p class="muted" id="connection-host-help">
			For example, play.example.com or 203.0.113.10. Leave it empty to use the address you opened Ludock with ({ c.PageHost }). To give one server its own address, add a <code>ludock.address</code> label to it.
		</p>
		if c.Error != "" {
			@Alert("error", c.Error)
		}
		if c.Notice != "" {
			@Alert("success", c.Notice)
		}
		<button class="primary-btn" type="submit" data-busy-label="Saving…">Save address</button>
	</form>
}

templ BackupSettingsForm(b BackupSettingsView) {
	<form class="stack-form" id="backup-settings-form" hx-post="/settings/backups" hx-target="this" hx-swap="outerHTML" hx-disinherit="*">
		<p>
			if b.Configured {
				Backups are on. You can change the destination and limits below.
			} else {
				Review the destination and limits, then save to enable backups.
			}
			Backups run only when started manually or by a schedule. Every backup stops its server for the entire copy.
		</p>
		if b.Configured {
			<section class="backup-storage" aria-labelledby="backup-storage-summary-title" id="backup-storage" hx-get="/fragments/settings/backup-storage" hx-trigger="load" hx-swap="outerHTML">
				<div class="backup-storage__header">
					<h3 id="backup-storage-summary-title">Current storage</h3>
				</div>
				<p class="muted" role="status">Checking backup storage…</p>
			</section>
		}
		<div class="admin-setup-help">
			if len(b.Roots) > 0 {
				<p>Configured backup folders (checked when you save):</p>
				<div class="admin-root-options">
					for _, root := range b.Roots {
						<button type="button" class="secondary-btn" data-fill="backup-destination" data-fill-value={ root }>Use <code>{ root }</code></button>
					}
				</div>
			} else {
				<h3>Mount a backup folder first</h3>
				<ol>
					<li>Create a separate backup folder on the Docker host and mount it writable into Ludock, for example <code>/srv/ludock-backups:/backups</code>.</li>
					<li>Set <code>LUDOCK_BACKUP_ROOTS=/backups</code> in Ludock’s <code>.env</code>, then run <code>docker compose up -d --force-recreate ludock</code> from its Compose folder to apply the mount and setting.</li>
					<li>Enter that mounted path below, choose the limits, and save. You can then create a backup from a server’s Backups tab.</li>
				</ol>
			}
		</div>
		<label>
			Mounted destination path
			<input id="backup-destination" name="destination" value={ b.Destination } placeholder="/backups" autocapitalize="none" spellcheck="false" aria-describedby="backup-destination-help" required/>
		</label>
		<p class="muted" id="backup-destination-help">An existing folder inside Ludock, separate from game data.</p>
		<div class="form-columns">
			<div>
				<label>
					Backups per server
					<input type="number" name="retentionCount" min="1" max="1000" inputmode="numeric" value={ b.Retention } aria-describedby="backup-retention-help" required/>
				</label>
				<p class="muted" id="backup-retention-help">Older backups are removed after a new backup succeeds.</p>
			</div>
			<div>
				<label>
					Total backup limit (GiB)
					<input type="number" name="maxGiB" min="0.000000001" step="any" inputmode="decimal" value={ b.MaxGiB } aria-describedby="backup-limit-help" required/>
				</label>
				<p class="muted" id="backup-limit-help">Combined size of backups across all servers. Leave room for the next backup before older backups are removed.</p>
			</div>
			<div>
				<label>
					Minimum free space (GiB)
					<input type="number" name="reserveGiB" min="0" step="any" inputmode="decimal" value={ b.ReserveGiB } aria-describedby="backup-reserve-help" required/>
				</label>
				<p class="muted" id="backup-reserve-help">Space to leave free on the backup disk and on game-data disks during restores. Use 0 for no reserve.</p>
			</div>
		</div>
		<p class="muted">Allow extra disk space for temporary files during backups and restores.</p>
		if b.Error != "" {
			@Alert("error", b.Error)
		}
		if b.Saved {
			<div class="alert alert--success admin-settings-feedback" role="status">
				<p>Backup settings saved.</p>
				<a href="/">Choose a server and open Backups to create a backup.</a>
			</div>
		}
		<button class="primary-btn" type="submit" data-busy-label="Saving backup settings…">Save backup settings</button>
	</form>
}

templ BackupStorage(status backups.StorageStatus) {
	<section class="backup-storage" aria-labelledby="backup-storage-summary-title" id="backup-storage" hx-disinherit="*">
		<div class="backup-storage__header">
			<h3 id="backup-storage-summary-title">Current storage</h3>
			<button type="button" class="secondary-btn" hx-get="/fragments/settings/backup-storage" hx-target="#backup-storage" hx-swap="outerHTML" data-busy-label="Checking…">Refresh storage</button>
		</div>
		<p class="muted">Uses saved settings. Unsaved changes below do not affect these values.</p>
		<dl class="backup-storage__values">
			<div><dt>Archive usage</dt><dd>{ FormatBytes(status.ArchiveBytes) }</dd></div>
			<div>
				<dt>Configured limit</dt>
				<dd>
					if status.Configured {
						{ FormatBytes(status.MaxBytes) }
					} else {
						Not configured
					}
				</dd>
			</div>
			<div>
				<dt>Available disk space</dt>
				<dd>
					if status.AvailableBytes >= 0 {
						{ FormatBytes(status.AvailableBytes) }
					} else {
						Unavailable
					}
				</dd>
			</div>
			<div>
				<dt>Free-space reserve</dt>
				<dd>
					if status.Configured {
						{ FormatBytes(status.ReserveBytes) }
					} else {
						Not configured
					}
				</dd>
			</div>
		</dl>
		if len(status.Issues) > 0 {
			<ul class="backup-storage__issues">
				for _, issue := range status.Issues {
					<li>{ issue.Message }</li>
				}
			</ul>
		}
		<p class="muted">Available disk space is measured before the reserve. Storage and server data roots are checked again when a backup runs.</p>
	</section>
}

templ NotificationForm(n NotificationSettingsView) {
	<form class="stack-form" id="notification-form" hx-post="/settings/notifications" hx-target="this" hx-swap="outerHTML" hx-disinherit="*">
		<p>Receive outage and recovery alerts, backup or schedule failures, and restore and update results. Enable availability monitoring separately on each server’s Overview for outage alerts.</p>
		if !n.Configured {
			<p class="muted" id="discord-webhook-setup">
				In Discord, open your server’s Settings → Integrations, create a webhook, choose the channel, and copy its URL here. Enable delivery and save, then send a test notification below.
				<a class="text-link" href="https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks" target="_blank" rel="noreferrer">Discord webhook guide</a>
			</p>
		}
		<label class="check-label">
			<input type="checkbox" name="enabled" value="true" checked?={ n.Enabled }/>
			Enable Discord delivery
		</label>
		<label>
			if n.Configured {
				Replace webhook URL
			} else {
				Webhook URL
			}
			<input
				type="password"
				name="webhookUrl"
				autocomplete="new-password"
				autocapitalize="none"
				spellcheck="false"
				maxlength="1024"
				aria-describedby="discord-webhook-help"
				placeholder={ map[bool]string{true: "Saved — leave blank to keep existing URL", false: "https://discord.com/api/webhooks/…"}[n.Configured] }
			/>
		</label>
		<p class="muted" id="discord-webhook-help">Ludock keeps the saved URL private. Leave the replacement field blank to keep it. Turning delivery off pauses notifications without deleting the URL.</p>
		if n.Error != "" {
			@Alert("error", n.Error)
		}
		if n.Notice != "" {
			@Alert("success", n.Notice)
		}
		<button class="primary-btn" type="submit" data-busy-label="Saving…">Save notifications</button>
	</form>
}

// DeliveriesView is the recent notification list.
type DeliveriesView struct {
	Deliveries          []notify.Delivery
	Configured, Enabled bool
	Error, Notice       string
}

func (d DeliveriesView) canSend() bool { return d.Configured && d.Enabled }

func (d DeliveriesView) pending() bool {
	for _, delivery := range d.Deliveries {
		if delivery.State == "queued" {
			return true
		}
	}
	return false
}

func deliveryStatus(delivery notify.Delivery, enabled bool) string {
	switch {
	case delivery.State == "delivered":
		return "Delivered"
	case delivery.State == "failed":
		return "Failed"
	case !enabled:
		return "Paused"
	case delivery.Attempts > 0:
		return "Pending retry"
	}
	return "Queued"
}

func deliveryTone(delivery notify.Delivery, enabled bool) string {
	switch {
	case delivery.State == "delivered":
		return "ok"
	case delivery.State == "failed":
		return "failed"
	case enabled:
		return "active"
	}
	return "idle"
}

templ Deliveries(d DeliveriesView) {
	<div
		class="notification-deliveries"
		hx-disinherit="*"
		if d.pending() && d.canSend() {
			hx-get="/fragments/settings/deliveries"
			hx-trigger="every 5s"
			hx-target="#notification-deliveries"
		}
	>
		<div class="notification-deliveries__test">
			<button type="button" class="secondary-btn" disabled?={ !d.canSend() } aria-describedby="notification-test-help" hx-post="/settings/notifications/test" hx-target="#notification-deliveries" data-busy-label="Queuing test…">Send test notification</button>
			<p class="muted" id="notification-test-help">
				if !d.canSend() {
					Save a webhook URL and enable Discord delivery before sending a test or retrying a delivery.
				} else {
					Send a test to the saved Discord webhook. Delivery may take a few seconds.
				}
			</p>
		</div>
		if d.Error != "" {
			@Alert("error", d.Error)
		}
		if d.Notice != "" {
			@Alert("success", d.Notice)
		}
		<div class="section-heading notification-deliveries__heading">
			<h3>Recent deliveries</h3>
			<button type="button" class="secondary-btn" hx-get="/fragments/settings/deliveries" hx-target="#notification-deliveries" data-busy-label="Refreshing…">Refresh deliveries</button>
		</div>
		<p class="muted notification-deliveries__help">
			The latest 50 notifications.
			if d.Enabled {
				Pending deliveries refresh every five seconds.
			} else {
				Discord delivery is disabled. Queued notifications resume when delivery is enabled.
			}
			Failed deliveries can be retried after fixing and saving the configuration.
		</p>
		<div class="table-scroll">
			<table class="data-table notification-deliveries-table" aria-label="Recent notification deliveries" role="table">
				<thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Notification</th><th scope="col" role="columnheader">Delivery</th><th scope="col" role="columnheader">Action</th></tr></thead>
				<tbody role="rowgroup">
					if len(d.Deliveries) == 0 {
						<tr role="row"><td role="cell" colspan="3" class="muted">No notifications have been queued yet. Send a test to check delivery.</td></tr>
					}
					for _, delivery := range d.Deliveries {
						<tr role="row">
							<td role="cell">
								if delivery.Kind == "test" {
									Test notification
								} else {
									Server notification
								}
								<span class="table-detail">Queued @Time(delivery.CreatedAt, "", "")</span>
							</td>
							<td role="cell">
								<strong class={ "notification-delivery-status", "notification-delivery-status--" + delivery.State }>
									@Pip(deliveryTone(delivery, d.Enabled))
									{ deliveryStatus(delivery, d.Enabled) }
								</strong>
								<span class="table-detail">{ strconv.Itoa(delivery.Attempts) } { map[bool]string{true: "attempt", false: "attempts"}[delivery.Attempts == 1] }</span>
								if delivery.DeliveredAt != 0 {
									<span class="table-detail">Delivered @Time(delivery.DeliveredAt, "", "")</span>
								} else if delivery.LastAttemptAt != 0 {
									<span class="table-detail">Last attempt @Time(delivery.LastAttemptAt, "", "")</span>
								}
								if delivery.NextAttemptAt != 0 && d.Enabled {
									<span class="table-detail">
										if delivery.Attempts > 0 {
											Next retry
										} else {
											Next attempt
										}
										@Time(delivery.NextAttemptAt, "", "")
									</span>
								}
								if delivery.LastFailure != "" {
									<p class="notification-delivery-failure">{ delivery.LastFailure }</p>
								}
							</td>
							<td role="cell">
								if delivery.Retryable {
									<button type="button" class="secondary-btn" disabled?={ !d.canSend() } aria-label="Retry notification" aria-describedby="notification-test-help" hx-post={ "/settings/notifications/deliveries/" + delivery.ID + "/retry" } hx-target="#notification-deliveries" data-busy-label="Queuing…">Retry</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
