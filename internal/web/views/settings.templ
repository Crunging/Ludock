package views

import (
	"slices"
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/backups"
	"github.com/Crunging/Ludock/internal/notify"
)

type SettingsView struct {
	Connection        ConnectionSettings
	Backups           BackupSettingsView
	Notifications     []NotificationDestinationView
	ImageUpdates      ImageUpdateSettings
	Advanced          AdvancedSettings
}

type AdvancedSettings struct {
	Upload  UploadLimitSettings
	Logging LoggingSettings
	Proxies ProxySettings
}

// UploadLimitSettings is the upload size form. Fixed shows a limit set by
// the environment instead of the field.
type UploadLimitSettings struct {
	Limit         string
	Fixed         bool
	Error, Notice string
}

// LoggingSettings is the verbose logging form; Level is the environment's
// level when Fixed.
type LoggingSettings struct {
	Verbose       bool
	Until         int64
	Level         string
	Fixed         bool
	Error, Notice string
}

// ProxySettings is the reverse proxy form. Forwarded is an untrusted private
// peer that recently sent X-Forwarded-For.
type ProxySettings struct {
	Trusted       string
	Fixed         bool
	Forwarded     string
	Error, Notice string
}

type ImageUpdateSettings struct {
	Enabled       bool
	Error, Notice string
}

type ConnectionSettings struct {
	Host, PageHost string
	Error, Notice  string
}

// BackupSettingsView is the backup storage form. Sizes are GiB text so an
// untouched value saves the exact byte count; an empty MaxGiB is no limit.
type BackupSettingsView struct {
	Configured         bool
	Destination        string
	MaxGiB, ReserveGiB string
	// CopyTo is the folder that gets a second copy of every backup, if any.
	CopyTo string
	Roots  []string
	Error              string
	Saved              bool
}

// copyRoots are the approved folders a second copy can go to.
func (b BackupSettingsView) copyRoots() []string {
	var roots []string
	for _, root := range b.Roots {
		if root != b.Destination || root == b.CopyTo {
			roots = append(roots, root)
		}
	}
	// A saved folder that is away stays chosen.
	if b.CopyTo != "" && !slices.Contains(roots, b.CopyTo) {
		roots = append(roots, b.CopyTo)
	}
	return roots
}

// NotificationDestinationView is one destination's card.
type NotificationDestinationView struct {
	notify.Configuration
	Open bool
	// NoAlerts shows a save rejected for choosing no alert type as it was sent.
	NoAlerts bool
	// Error and Notice report a save; the Test ones report a test send.
	Error, Notice         string
	TestError, TestNotice string
}

templ SettingsPage(page Page, s SettingsView) {
	@Shell(page) {
		<div class="page settings-page">
			<div class="page__header">
				<h1 class="page__title">Settings</h1>
				<p class="page__subtitle">Server controls work without any setup. Changes here take effect when saved.</p>
			</div>
			<nav class="settings-jump-links" aria-label="Settings sections">
				<a class="text-link" href="#connection-settings-title">Server address</a>
				<a class="text-link" href="#backup-settings-title">Backup storage</a>
				<a class="text-link" href="#image-update-settings-title">Image updates</a>
				<a class="text-link" href="#notification-settings-title">Notifications</a>
				<a class="text-link" href="#advanced-settings-title">Advanced</a>
			</nav>
			<section class="settings-section settings-section--divided" aria-labelledby="connection-settings-title">
				<h2 id="connection-settings-title" tabindex="-1">Server address</h2>
				@ConnectionForm(s.Connection)
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="backup-settings-title">
				<h2 id="backup-settings-title" tabindex="-1">Backup storage</h2>
				@BackupSettingsForm(s.Backups)
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="image-update-settings-title">
				<h2 id="image-update-settings-title" tabindex="-1">Image updates</h2>
				@ImageUpdateSettingsForm(s.ImageUpdates)
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="notification-settings-title">
				<h2 id="notification-settings-title" tabindex="-1">Notifications</h2>
				<p class="section-lede">Receive outage, full disk, and memory alerts and their recoveries, backup or schedule failures, and restore and update results. Turn on as many destinations as you like; each can choose its alert types, and notices of newer server images are off until chosen. Enable availability monitoring separately on each server’s Overview for outage, disk, and memory alerts.</p>
				<div class="notification-destinations">
					for _, n := range s.Notifications {
						@NotificationDestination(n)
					}
				</div>
				<div id="notification-deliveries" hx-get="/fragments/settings/deliveries" hx-trigger="load, notifications-changed from:document" hx-swap="innerHTML">
					<p class="muted" role="status">Loading notification deliveries…</p>
				</div>
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="advanced-settings-title">
				<h2 id="advanced-settings-title" tabindex="-1">Advanced</h2>
				<details class="disclosure" id="advanced-settings" open?={ s.Advanced.Proxies.Forwarded != "" }>
					<summary>Upload size limit, verbose logging, and reverse proxy</summary>
					<div class="advanced-settings">
						@UploadLimitForm(s.Advanced.Upload)
						@LoggingForm(s.Advanced.Logging)
						@ProxyForm(s.Advanced.Proxies)
					</div>
				</details>
			</section>
		</div>
	}
}

templ fixedByDeployment(variable string) {
	<p class="muted">Ludock’s deployment sets this with <code>{ variable }</code>, which wins over the panel. Remove it from Ludock’s Compose file to change it here.</p>
}

templ settingFeedback(errorText, notice string) {
	if errorText != "" {
		@Alert("error", errorText)
	}
	if notice != "" {
		@Alert("success", notice)
	}
}

templ UploadLimitForm(u UploadLimitSettings) {
	<form class="stack-form" id="upload-limit-form" hx-post="/settings/upload-limit" hx-target="this" hx-swap="outerHTML">
		<h3>Upload size limit</h3>
		<p class="muted">Without a limit, any file that leaves the server’s disk 1 GiB to spare can be uploaded.</p>
		if u.Fixed {
			<p>Each uploaded file can be up to <strong>{ u.Limit }</strong>.</p>
			@fixedByDeployment("LUDOCK_MAX_UPLOAD_SIZE")
		} else {
			<div>
				<label class="narrow-field">
					Largest file
					<input name="limit" value={ u.Limit } placeholder="No limit" maxlength="32" autocomplete="off" spellcheck="false" aria-describedby="upload-limit-help"/>
				</label>
				<p class="muted" id="upload-limit-help">For example 500 MB or 4 GiB. Leave it empty for no limit.</p>
			</div>
			@settingFeedback(u.Error, u.Notice)
			<button class="primary-btn" type="submit" data-busy-label="Saving…">Save upload limit</button>
		}
	</form>
}

templ LoggingForm(l LoggingSettings) {
	<form class="stack-form" id="logging-form" hx-post="/settings/logging" hx-target="this" hx-swap="outerHTML">
		<h3>Verbose logging</h3>
		<p class="muted">Adds detail to <a href="/logs">Ludock logs</a> to help with a bug report. It turns itself off after 24 hours.</p>
		if l.Fixed {
			<p>Ludock logs at the <strong>{ l.Level }</strong> level.</p>
			@fixedByDeployment("LUDOCK_LOG_LEVEL")
		} else {
			<label class="check-label">
				<input type="checkbox" name="verbose" value="true" checked?={ l.Verbose }/>
				Log extra detail
			</label>
			if l.Verbose && l.Notice == "" {
				<p class="muted">On until @Time(l.Until, "", "")</p>
			}
			@settingFeedback(l.Error, l.Notice)
			<button class="primary-btn" type="submit" data-busy-label="Saving…">Save logging</button>
		}
	</form>
}

templ ProxyForm(p ProxySettings) {
	<form class="stack-form" id="proxy-form" hx-post="/settings/proxies" hx-target="this" hx-swap="outerHTML">
		<h3>Reverse proxy</h3>
		<p class="muted">Behind Traefik, Caddy, Nginx Proxy Manager, or another proxy, trust the proxy’s address so sign-in limits and the audit log see each visitor’s own address. A trusted address can claim to be any visitor, so trust only your own proxy.</p>
		if p.Fixed {
			if p.Trusted == "" {
				<p>Ludock trusts no proxy.</p>
			} else {
				<p>Ludock trusts <code>{ p.Trusted }</code>.</p>
			}
			@fixedByDeployment("LUDOCK_TRUSTED_PROXIES")
		} else {
			if p.Forwarded != "" {
				<div class="alert alert--info proxy-hint" role="status">
					<div>
						<p>You’re reaching Ludock through a proxy at <strong>{ p.Forwarded }</strong> that it doesn’t trust, so every visitor shares that address.</p>
						<button class="secondary-btn" type="submit" name="trust" value={ p.Forwarded } data-busy-label="Trusting…">Trust { p.Forwarded }</button>
					</div>
				</div>
			}
			<div>
				<label>
					Trusted proxy addresses
					<input name="trusted" value={ p.Trusted } placeholder="None" maxlength="2048" autocapitalize="none" autocomplete="off" spellcheck="false" aria-describedby="proxy-help"/>
				</label>
				<p class="muted" id="proxy-help">IP addresses or ranges separated by commas, such as 172.18.0.2 or 172.18.0.0/16. Leave it empty to trust none.</p>
			</div>
			@settingFeedback(p.Error, p.Notice)
			<button class="primary-btn" type="submit" data-busy-label="Saving…">Save proxies</button>
		}
	</form>
}

templ ConnectionForm(c ConnectionSettings) {
	<form class="stack-form" id="connection-form" hx-post="/settings/connection" hx-target="this" hx-swap="outerHTML">
		<p class="section-lede">The name or IP address players use to reach this host. Ludock adds each server’s port and shows the result with a copy button.</p>
		<label class="narrow-field">
			Public address
			<input name="host" value={ c.Host } placeholder={ c.PageHost } maxlength="253" autocapitalize="none" autocomplete="off" spellcheck="false" aria-describedby="connection-host-help"/>
		</label>
		<p class="muted" id="connection-host-help">
			For example, play.example.com or 203.0.113.10. Leave it empty to use the address you opened Ludock with ({ c.PageHost }). To give one server its own address, add a <code>ludock.address</code> label to it.
		</p>
		if c.Error != "" {
			@Alert("error", c.Error)
		}
		if c.Notice != "" {
			@Alert("success", c.Notice)
		}
		<button class="primary-btn" type="submit" data-busy-label="Saving…">Save address</button>
	</form>
}

templ ImageUpdateSettingsForm(u ImageUpdateSettings) {
	<form class="stack-form" id="image-update-settings-form" hx-post="/settings/image-updates" hx-target="this" hx-swap="outerHTML">
		<p class="section-lede">A few times a day, Ludock asks each server’s registry, through Docker, whether its image tag points to a newer image, without pulling it. Administrators see the result on the server list and the server’s Update tab, and notifications announce each new version once. Nothing updates automatically.</p>
		<label class="check-label">
			<input type="checkbox" name="enabled" value="true" checked?={ u.Enabled }/>
			Check for newer server images
		</label>
		if u.Error != "" {
			@Alert("error", u.Error)
		}
		if u.Notice != "" {
			@Alert("success", u.Notice)
		}
		<button class="primary-btn" type="submit" data-busy-label="Saving…">Save image update settings</button>
	</form>
}

templ BackupSettingsForm(b BackupSettingsView) {
	<form class="stack-form" id="backup-settings-form" hx-post="/settings/backups" hx-target="this" hx-swap="outerHTML">
		if b.Configured {
			<section class="backup-storage" aria-labelledby="backup-storage-summary-title" id="backup-storage" hx-get="/fragments/settings/backup-storage" hx-trigger="load" hx-swap="outerHTML">
				<p class="muted" role="status">Checking backup storage…</p>
			</section>
		} else if len(b.Roots) == 0 {
			<div class="admin-setup-help">
				<h3>Mount a backup folder first</h3>
				<ol>
					<li>Create a separate backup folder on the Docker host and mount it writable into Ludock, for example <code>/srv/ludock-backups:/backups</code>.</li>
					<li>In Ludock’s Compose file, remove the empty <code>LUDOCK_BACKUP_ROOTS</code> setting or set it to <code>/backups</code>, then run <code>docker compose up -d</code> from its folder to apply the mount and setting.</li>
					<li>Enter that mounted path below and save. You can then create a backup from a server’s Backups tab.</li>
				</ol>
			</div>
		} else {
			<p>Backups are off. Choose a backup folder below and save to turn them on.</p>
		}
		<p class="muted">Backups run when you start one or a schedule does, and each one stops its server while it copies. Ludock keeps a spread of recent and older backups for each server and removes the rest; each server’s Backups tab says which.</p>
		<details class="disclosure" id="backup-advanced" open?={ !b.Configured || b.Error != "" }>
			<summary>Advanced</summary>
			<div class="stack-form">
				if len(b.Roots) > 1 {
					<div class="admin-root-options">
						for _, root := range b.Roots {
							<button type="button" class="secondary-btn" data-fill="backup-destination" data-fill-value={ root }>Use <code>{ root }</code></button>
						}
					</div>
				}
				<div>
					<label>
						Backup folder
						<input id="backup-destination" name="destination" value={ b.Destination } placeholder="/backups" autocapitalize="none" spellcheck="false" aria-describedby="backup-destination-help" required/>
					</label>
					<p class="muted" id="backup-destination-help">A folder mounted into Ludock and listed in <code>LUDOCK_BACKUP_ROOTS</code>, separate from game data.</p>
				</div>
				<div class="form-columns">
					<div>
						<label>
							Minimum free space (GiB)
							<input type="number" name="reserveGiB" min="0" step="any" inputmode="decimal" value={ b.ReserveGiB } aria-describedby="backup-reserve-help" required/>
						</label>
						<p class="muted" id="backup-reserve-help">Backups and restores never fill the backup disk or a game-data disk past this, leaving room for temporary files. Use 0 for none.</p>
					</div>
					<div>
						<label>
							Total limit for all backups (GiB)
							<input type="number" name="maxGiB" min="0.000000001" step="any" inputmode="decimal" value={ b.MaxGiB } placeholder="No limit" aria-describedby="backup-limit-help"/>
						</label>
						<p class="muted" id="backup-limit-help">Optional. Leave empty to let backups use the disk down to the free-space minimum.</p>
					</div>
				</div>
				if roots := b.copyRoots(); len(roots) > 0 {
					<div>
						<label>
							Also copy backups to
							<select name="copyTo" aria-describedby="backup-copy-help">
								<option value="" selected?={ b.CopyTo == "" }>No second copy</option>
								for _, root := range roots {
									<option value={ root } selected?={ root == b.CopyTo }>{ root }</option>
								}
							</select>
						</label>
						<p class="muted" id="backup-copy-help">Each backup is copied there after its server is back, so a lost backup disk doesn’t take every backup with it. Choose a folder on another disk or a NAS.</p>
					</div>
				} else {
					<p class="muted" id="backup-copy-help">To keep a second copy of every backup on another disk, mount a folder from that disk at <code>/backups-copy</code> in Ludock’s Compose file, for example <code>/mnt/nas/ludock:/backups-copy</code>, recreate Ludock, and choose it here.</p>
				}
				<button class="primary-btn" type="submit" data-busy-label="Saving backup settings…">Save backup settings</button>
			</div>
		</details>
		if b.Error != "" {
			@Alert("error", b.Error)
		}
		if b.Saved {
			<div class="alert alert--success admin-settings-feedback" role="status">
				<p>Backup settings saved.</p>
				<a href="/">Choose a server and open Backups to create a backup.</a>
			</div>
		}
	</form>
}

templ BackupStorage(status backups.StorageStatus) {
	<section class="backup-storage" aria-labelledby="backup-storage-summary-title" id="backup-storage">
		<div class="backup-storage__header">
			<h3 id="backup-storage-summary-title">Current storage</h3>
			<button type="button" class="secondary-btn" hx-get="/fragments/settings/backup-storage" hx-target="#backup-storage" hx-swap="outerHTML" data-busy-label="Checking…">Refresh</button>
		</div>
		<dl class="backup-storage__values">
			<div class="backup-storage__folder"><dt>Saved in</dt><dd><code>{ status.Destination }</code></dd></div>
			<div><dt>Backups use</dt><dd>{ FormatBytes(status.ArchiveBytes) }</dd></div>
			<div><dt>Kept backups</dt><dd>{ FormatBytes(status.KeptBytes) }</dd></div>
			<div>
				<dt>Free on disk</dt>
				<dd>
					if status.AvailableBytes >= 0 {
						{ FormatBytes(status.AvailableBytes) }
					} else {
						Unavailable
					}
				</dd>
			</div>
			if status.MaxBytes > 0 {
				<div><dt>Total limit</dt><dd>{ FormatBytes(status.MaxBytes) }</dd></div>
			}
			if status.CopyTo != "" {
				<div class="backup-storage__folder"><dt>Second copy in</dt><dd><code>{ status.CopyTo }</code></dd></div>
				if status.CopyAvailableBytes >= 0 {
					<div><dt>Free there</dt><dd>{ FormatBytes(status.CopyAvailableBytes) }</dd></div>
				}
			}
		</dl>
		if len(status.Issues) > 0 || status.CopyIssue != "" {
			<ul class="backup-storage__issues">
				for _, issue := range status.Issues {
					<li>{ issue.Message }</li>
				}
				if status.CopyIssue != "" {
					<li>{ status.CopyIssue }</li>
				}
			</ul>
		}
	</section>
}

func destinationID(d notify.Destination, part string) string {
	return "notification-" + string(d) + "-" + part
}

func destinationSummary(d notify.Destination) string {
	return map[notify.Destination]string{
		notify.Discord:  "A channel in your Discord server, through a webhook.",
		notify.Ntfy:     "Push notifications to phones and desktops from ntfy.sh or your own ntfy server.",
		notify.Gotify:   "Push notifications from your self-hosted Gotify server.",
		notify.Telegram: "Messages from a Telegram bot to you, a group, or a channel.",
		notify.Email:    "Email through any SMTP mail server or provider.",
		notify.Webhook:  "A JSON POST to any URL, for Home Assistant, n8n, or your own scripts.",
	}[d]
}

func destinationState(n NotificationDestinationView) (string, string) {
	switch {
	case n.Ready():
		return "On", "ok"
	case n.Configured:
		return "Off", "idle"
	}
	return "Not set up", "idle"
}

func enableLabel(d notify.Destination) string {
	switch d {
	case notify.Email:
		return "Send alerts by email"
	case notify.Webhook:
		return "Send alerts to the webhook"
	}
	return "Send alerts to " + d.Label()
}

func portText(port int) string {
	if port == 0 {
		return ""
	}
	return strconv.Itoa(port)
}

// NotificationDestination is one destination's settings and test button.
templ NotificationDestination(n NotificationDestinationView) {
	<details class="notification-destination" id={ destinationID(n.Destination, "card") } open?={ n.Open }>
		<summary>
			<span class="notification-destination__name">{ n.Destination.Label() }</span>
			<span class="notification-destination__summary">{ destinationSummary(n.Destination) }</span>
			{{ state, tone := destinationState(n) }}
			<span class="notification-destination__state">
				@Pip(tone)
				{ state }
			</span>
		</summary>
		<div class="notification-destination__body">
			<form class="stack-form" hx-post={ "/settings/notifications/" + string(n.Destination) } hx-target="closest .notification-destination" hx-swap="outerHTML">
				@destinationFields(n)
				<label class="check-label">
					<input type="checkbox" name="enabled" value="true" checked?={ n.Enabled }/>
					{ enableLabel(n.Destination) }
				</label>
				@alertTypes(n)
				<p class="muted">Ludock keeps tokens, topics, passwords, and webhook URLs private: they are never shown again. Leave a saved field blank to keep it. Turning a destination off pauses its alerts without deleting its settings.</p>
				if n.Error != "" {
					@Alert("error", n.Error)
				}
				if n.Notice != "" {
					@Alert("success", n.Notice)
				}
				<button class="primary-btn" type="submit" data-busy-label="Saving…">{ "Save " + n.Destination.Label() }</button>
			</form>
			@NotificationTest(n)
		</div>
	</details>
}

func alertDescription(a notify.Alert) string {
	return map[notify.Alert]string{
		notify.ServerProblems: "A server goes down or recovers, its game stops answering, or it runs low on disk or memory.",
		notify.FailedWork:     "A backup fails, or a scheduled action fails or can’t run.",
		notify.Results:        "A restore or update finishes or fails.",
		notify.NewerImages:    "A newer image is published for a server. The server list shows this too.",
	}[a]
}

// alertChoice summarizes the alert types a destination gets.
func alertChoice(chosen notify.Alert) string {
	var labels []string
	for _, a := range notify.AlertTypes {
		if chosen.Includes(a) {
			labels = append(labels, a.Label())
		}
	}
	switch {
	case len(labels) == len(notify.AlertTypes):
		return "Everything"
	case chosen == 0 || chosen == notify.DefaultAlerts:
		return "Everything except newer images"
	}
	return strings.Join(labels, ", ")
}

templ alertTypes(n NotificationDestinationView) {
	<details class="disclosure notification-alerts" open?={ n.NoAlerts }>
		<summary>
			Alert types
			if !n.NoAlerts {
				<span class="notification-alerts__choice">{ alertChoice(n.Config.Alerts) }</span>
			}
		</summary>
		<fieldset class="notification-alerts__options">
			<legend class="sr-only">{ "Alert types to send to " + n.Destination.Label() }</legend>
			for _, alert := range notify.AlertTypes {
				<label class="check-label notification-alerts__option">
					<input type="checkbox" name="alerts" value={ alert.Name() } checked?={ !n.NoAlerts && n.Config.Alerts.Includes(alert) }/>
					<span>
						{ alert.Label() }
						<span class="muted">{ alertDescription(alert) }</span>
					</span>
				</label>
			}
		</fieldset>
	</details>
}

// NotificationTest is a destination's test button and its result.
templ NotificationTest(n NotificationDestinationView) {
	<div class="notification-destination__test" id={ destinationID(n.Destination, "test") }>
		<div class="inline-actions">
			<button type="button" class="secondary-btn" disabled?={ !n.Ready() } aria-describedby={ destinationID(n.Destination, "test-help") } hx-post={ "/settings/notifications/" + string(n.Destination) + "/test" } hx-target={ "#" + destinationID(n.Destination, "test") } hx-swap="outerHTML" data-busy-label="Queuing test…">Send test notification</button>
			<p class="muted" id={ destinationID(n.Destination, "test-help") }>
				if n.Ready() {
					Sends a test with the saved settings. Its result appears in Recent deliveries.
				} else {
					Save the settings with this destination turned on to send a test.
				}
			</p>
		</div>
		if n.TestError != "" {
			@Alert("error", n.TestError)
		}
		if n.TestNotice != "" {
			@Alert("success", n.TestNotice)
		}
	</div>
}

// secretField is a write-only input: a saved value is never sent back.
templ secretField(n NotificationDestinationView, name, label, placeholder, help string, maxlength int) {
	<label>
		if n.Saved[name] {
			{ "Replace " + strings.ToLower(label[:1]) + label[1:] }
		} else {
			{ label }
		}
		<input
			type="password"
			name={ name }
			autocomplete="new-password"
			autocapitalize="none"
			spellcheck="false"
			maxlength={ strconv.Itoa(maxlength) }
			if help != "" {
				aria-describedby={ destinationID(n.Destination, name+"-help") }
			}
			placeholder={ map[bool]string{true: "Saved — leave blank to keep it", false: placeholder}[n.Saved[name]] }
		/>
	</label>
	if help != "" {
		<p class="muted" id={ destinationID(n.Destination, name+"-help") }>{ help }</p>
	}
}

templ clearTokenField(n NotificationDestinationView, label string) {
	if n.Saved["token"] {
		<label class="check-label">
			<input type="checkbox" name="clearToken" value="true"/>
			{ label }
		</label>
	}
}

templ destinationFields(n NotificationDestinationView) {
	switch n.Destination {
		case notify.Discord:
			if !n.Configured {
				<p class="muted">
					In Discord, open your server’s Settings → Integrations, create a webhook, choose the channel, and copy its URL here.
					<a class="text-link" href="https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks" target="_blank" rel="noreferrer">Discord webhook guide</a>
				</p>
			}
			@secretField(n, "url", "Webhook URL", "https://discord.com/api/webhooks/…", "", 1024)
		case notify.Ntfy:
			<label>
				Server URL
				<input name="url" type="url" value={ n.Config.URL } placeholder={ notify.DefaultNtfyServer } maxlength="1024" autocapitalize="none" spellcheck="false" aria-describedby={ destinationID(n.Destination, "url-help") }/>
			</label>
			<p class="muted" id={ destinationID(n.Destination, "url-help") }>Leave empty for ntfy.sh, or enter your own server’s address. Subscribe to the topic in the ntfy app.</p>
			@secretField(n, "topic", "Topic", "ludock-alerts-7f3k", "Anyone who knows a topic on a public server can read it, so choose one that is hard to guess.", 64)
			@secretField(n, "token", "Access token (optional)", "tk_…", "Needed only when the topic is protected.", 256)
			@clearTokenField(n, "Remove the saved access token")
		case notify.Gotify:
			<label>
				Server URL
				<input name="url" type="url" value={ n.Config.URL } placeholder="https://gotify.example.com" maxlength="1024" autocapitalize="none" spellcheck="false"/>
			</label>
			@secretField(n, "token", "Application token", "A…", "In Gotify, open Apps, create an application for Ludock, and copy its token.", 256)
		case notify.Telegram:
			@secretField(n, "token", "Bot token", "123456789:AA…", "Create a bot with @BotFather and copy the token it gives you.", 100)
			<label>
				Chat ID
				<input name="chatId" value={ n.Config.ChatID } placeholder="123456789" maxlength="33" autocapitalize="none" spellcheck="false" aria-describedby={ destinationID(n.Destination, "chat-help") }/>
			</label>
			<p class="muted" id={ destinationID(n.Destination, "chat-help") }>Your user, group, or channel ID, or a public channel’s { "@name" }. Send the bot a message, or add it to the group or channel, before testing.</p>
		case notify.Email:
			<div class="form-columns">
				<label>
					Mail server
					<input name="host" value={ n.Config.Host } placeholder="smtp.example.com" maxlength="255" autocapitalize="none" spellcheck="false"/>
				</label>
				<label>
					Security
					<select name="security">
						<option value="starttls" selected?={ n.Config.Security == "" || n.Config.Security == "starttls" }>STARTTLS (port 587)</option>
						<option value="tls" selected?={ n.Config.Security == "tls" }>TLS (port 465)</option>
						<option value="none" selected?={ n.Config.Security == "none" }>None (local relay)</option>
					</select>
				</label>
				<label>
					Port
					<input name="port" type="number" min="1" max="65535" inputmode="numeric" value={ portText(n.Config.Port) } placeholder="Default"/>
				</label>
			</div>
			<div class="form-columns">
				<label>
					Username (optional)
					<input name="username" value={ n.Config.Username } maxlength="256" autocomplete="off" autocapitalize="none" spellcheck="false"/>
				</label>
				<div>
					@secretField(n, "password", "Password", "", "", 256)
				</div>
			</div>
			<div class="form-columns">
				<label>
					From
					<input name="sender" value={ n.Config.From } placeholder="ludock@example.com" maxlength="320" autocapitalize="none" spellcheck="false"/>
				</label>
				<label>
					To
					<input name="recipients" value={ n.Config.To } placeholder="you@example.com" maxlength="2000" autocapitalize="none" spellcheck="false" aria-describedby={ destinationID(n.Destination, "to-help") }/>
				</label>
			</div>
			<p class="muted" id={ destinationID(n.Destination, "to-help") }>Separate up to 10 recipients with commas. Leave the username empty when the server needs no sign-in. Many providers need an app password.</p>
		case notify.Webhook:
			@secretField(n, "url", "Webhook URL", "https://example.com/hooks/ludock", "Ludock sends a POST with a JSON body: source (\"ludock\"), id, kind (\"event\" or \"test\"), message, and createdAt. The id stays the same when a delivery is retried.", 1024)
			@secretField(n, "token", "Authorization header (optional)", "Bearer …", "Sent as the request’s Authorization header.", 1024)
			@clearTokenField(n, "Remove the saved Authorization header")
	}
}

type DeliveriesView struct {
	Deliveries    []notify.Delivery
	Error, Notice string
}

func (d DeliveriesView) pending() bool {
	for _, delivery := range d.Deliveries {
		if delivery.State == "queued" && !delivery.Paused {
			return true
		}
	}
	return false
}

func deliveryStatus(delivery notify.Delivery) string {
	switch {
	case delivery.State == "delivered":
		return "Delivered"
	case delivery.State == "failed":
		return "Failed"
	case delivery.Paused:
		return "Paused"
	case delivery.Attempts > 0:
		return "Pending retry"
	}
	return "Queued"
}

func deliveryTone(delivery notify.Delivery) string {
	switch {
	case delivery.State == "delivered":
		return "ok"
	case delivery.State == "failed":
		return "failed"
	case !delivery.Paused:
		return "active"
	}
	return "idle"
}

templ Deliveries(d DeliveriesView) {
	<div
		class="notification-deliveries"
		if d.pending() {
			hx-get="/fragments/settings/deliveries"
			hx-trigger="every 5s"
			hx-target="#notification-deliveries"
		}
	>
		if d.Error != "" {
			@Alert("error", d.Error)
		}
		if d.Notice != "" {
			@Alert("success", d.Notice)
		}
		<div class="section-heading notification-deliveries__heading">
			<h3>Recent deliveries</h3>
			<button type="button" class="secondary-btn" hx-get="/fragments/settings/deliveries" hx-target="#notification-deliveries" data-busy-label="Refreshing…">Refresh deliveries</button>
		</div>
		<p class="muted notification-deliveries__help" id="notification-deliveries-help">
			The latest 50 notifications, one row for each destination. Pending deliveries refresh every five seconds; a destination that is turned off holds its deliveries until it is turned on again. Failed deliveries can be retried after fixing and saving the destination.
		</p>
		<div class="table-scroll">
			<table class="data-table notification-deliveries-table" aria-label="Recent notification deliveries" role="table">
				<thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Notification</th><th scope="col" role="columnheader">Destination</th><th scope="col" role="columnheader">Delivery</th><th scope="col" role="columnheader">Action</th></tr></thead>
				<tbody role="rowgroup">
					if len(d.Deliveries) == 0 {
						<tr role="row"><td role="cell" colspan="4" class="muted">No notifications have been queued yet. Send a test to check delivery.</td></tr>
					}
					for _, delivery := range d.Deliveries {
						<tr role="row">
							<td role="cell">
								if delivery.Kind == "test" {
									Test notification
								} else {
									Server notification
								}
								<span class="table-detail">Queued @Time(delivery.CreatedAt, "", "")</span>
							</td>
							<td role="cell">{ delivery.Destination.Label() }</td>
							<td role="cell">
								<strong class={ "notification-delivery-status", "notification-delivery-status--" + delivery.State }>
									@Pip(deliveryTone(delivery))
									{ deliveryStatus(delivery) }
								</strong>
								<span class="table-detail">{ strconv.Itoa(delivery.Attempts) } { map[bool]string{true: "attempt", false: "attempts"}[delivery.Attempts == 1] }</span>
								if delivery.DeliveredAt != 0 {
									<span class="table-detail">Delivered @Time(delivery.DeliveredAt, "", "")</span>
								} else if delivery.LastAttemptAt != 0 {
									<span class="table-detail">Last attempt @Time(delivery.LastAttemptAt, "", "")</span>
								}
								if delivery.NextAttemptAt != 0 && !delivery.Paused {
									<span class="table-detail">
										if delivery.Attempts > 0 {
											Next retry
										} else {
											Next attempt
										}
										@Time(delivery.NextAttemptAt, "", "")
									</span>
								}
								if delivery.LastFailure != "" {
									<p class="notification-delivery-failure">{ delivery.LastFailure }</p>
								}
							</td>
							<td role="cell">
								if delivery.Retryable {
									<button type="button" class="secondary-btn" aria-label={ "Retry " + delivery.Destination.Label() + " notification" } aria-describedby="notification-deliveries-help" hx-post={ "/settings/notifications/deliveries/" + delivery.ID + "/retry" } hx-target="#notification-deliveries" data-busy-label="Queuing…">Retry</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
