package views

import (
	"encoding/json"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/Crunging/Ludock/internal/backups"
	"github.com/Crunging/Ludock/internal/notify"
	"github.com/Crunging/Ludock/internal/selfupdate"
	"github.com/Crunging/Ludock/internal/update"
)

type SettingsView struct {
	Connection        ConnectionSettings
	Backups           BackupSettingsView
	Notifications     []NotificationDestinationView
	ImageUpdates      ImageUpdateSettings
	Advanced          AdvancedSettings
	// Ludock is the check of Ludock's own image, or nil when there is none.
	Ludock *update.CheckStatus
	// Offer is whether Ludock can update itself from here.
	Offer selfupdate.Offer
}

type AdvancedSettings struct {
	Upload  UploadLimitSettings
	Logging LoggingSettings
	Proxies ProxySettings
}

// UploadLimitSettings is the upload size form. Fixed shows a limit set by
// the environment instead of the field.
type UploadLimitSettings struct {
	Limit         string
	Fixed         bool
	Error, Notice string
}

// LoggingSettings is the verbose logging form; Level is the environment's
// level when Fixed.
type LoggingSettings struct {
	Verbose       bool
	Until         int64
	Level         string
	Fixed         bool
	Error, Notice string
}

// ProxySettings is the reverse proxy form. Forwarded is an untrusted private
// peer that recently sent X-Forwarded-For.
type ProxySettings struct {
	Trusted       string
	Fixed         bool
	Forwarded     string
	Error, Notice string
}

type ImageUpdateSettings struct {
	Enabled       bool
	Error, Notice string
}

type ConnectionSettings struct {
	Host, PageHost string
	Error, Notice  string
}

// BackupSettingsView is the backup storage form. Sizes are GiB text so an
// untouched value saves the exact byte count; an empty MaxGiB is no limit.
type BackupSettingsView struct {
	Configured         bool
	Destination        string
	MaxGiB, ReserveGiB string
	// CopyTo is the folder that gets a second copy of every backup, if any.
	CopyTo string
	Roots  []string
	Error              string
	Saved              bool
}

// copyRoots are the approved folders a second copy can go to.
func (b BackupSettingsView) copyRoots() []string {
	var roots []string
	for _, root := range b.Roots {
		if root != b.Destination || root == b.CopyTo {
			roots = append(roots, root)
		}
	}
	// A saved folder that is away stays chosen.
	if b.CopyTo != "" && !slices.Contains(roots, b.CopyTo) {
		roots = append(roots, b.CopyTo)
	}
	return roots
}

// NotificationDestinationView is one destination's card.
type NotificationDestinationView struct {
	notify.Configuration
	Health notify.Health
	// Test is the test just sent, while its result shows by the button.
	Test *notify.Delivery
	Open bool
	// NoAlerts shows a save rejected for choosing no alert type as it was sent.
	NoAlerts bool
	// Error and Notice report a save; the Test ones report a test send.
	Error, Notice string
	TestError     string
}

// advancedOpen opens Advanced when something there needs the administrator.
func (s SettingsView) advancedOpen() bool {
	return s.Advanced.Proxies.Forwarded != "" || s.Backups.Error != "" || (!s.Backups.Configured && len(s.Backups.Roots) > 0)
}

templ SettingsPage(page Page, s SettingsView) {
	@Shell(page) {
		<div class="page settings-page">
			<div class="page__header">
				<h1 class="page__title">Settings</h1>
			</div>
			@settingsTabs("/settings")
			@LudockNotice(s.Ludock, s.Offer)
			<section class="settings-section settings-section--divided" aria-labelledby="connection-settings-title">
				<h2 id="connection-settings-title" tabindex="-1">Server address</h2>
				@ConnectionForm(s.Connection)
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="notification-settings-title">
				<h2 id="notification-settings-title" tabindex="-1">Notifications</h2>
				<p class="section-lede">Get alerts when a server goes down, runs short of space, or a backup fails. Turn on as many destinations as you like.</p>
				<div class="notification-destinations">
					for _, n := range s.Notifications {
						@NotificationDestination(n)
					}
				</div>
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="backup-settings-title">
				<h2 id="backup-settings-title" tabindex="-1">Backups</h2>
				@BackupSummary(s.Backups)
			</section>
			<section class="settings-section settings-section--divided" aria-labelledby="advanced-settings-title">
				<details class="disclosure settings-advanced" id="advanced-settings" open?={ s.advancedOpen() }>
					<summary><h2 id="advanced-settings-title">Advanced</h2></summary>
					<p class="muted">Image checks, backup folder and limits, a second copy, uploads, logging, reverse proxy, and notification history.</p>
					<div class="advanced-settings">
						<section class="settings-group" aria-labelledby="image-update-settings-title">
							<h3 id="image-update-settings-title" tabindex="-1">Image updates</h3>
							@ImageUpdateSettingsForm(s.ImageUpdates)
							@LudockCheck(s.Ludock, s.Offer)
						</section>
						<section class="settings-group" aria-labelledby="backup-storage-settings-title">
							<h3 id="backup-storage-settings-title" tabindex="-1">Backup folder and limits</h3>
							@BackupSettingsForm(s.Backups)
						</section>
						@UploadLimitForm(s.Advanced.Upload)
						@LoggingForm(s.Advanced.Logging)
						@ProxyForm(s.Advanced.Proxies)
						<section class="settings-group" aria-labelledby="notification-deliveries-title">
							<h3 id="notification-deliveries-title" tabindex="-1">Recent deliveries</h3>
							<div id="notification-deliveries" hx-get="/fragments/settings/deliveries" hx-trigger="load, notifications-changed from:document, every 30s" hx-sync="this:queue last" hx-swap="innerHTML">
								<p class="muted" role="status">Loading notification deliveries…</p>
							</div>
						</section>
					</div>
				</details>
			</section>
		</div>
	}
}

templ fixedByDeployment(variable string) {
	<p class="muted">Set by <code>{ variable }</code> in Ludock’s environment, which wins over this page.</p>
}

templ settingFeedback(errorText, notice string) {
	if errorText != "" {
		@Alert("error", errorText)
	}
	if notice != "" {
		@Alert("success", notice)
	}
}

// saveRow is the Save of an Advanced section, enabled while the section has
// an unsaved change, or while its last save failed, with the outcome beside
// it. label names the section for screen readers.
templ saveRow(label, errorText, notice string, unsaved bool) {
	<div class="settings-save">
		<button class="primary-btn" type="submit" aria-label={ label } disabled?={ !unsaved } data-unsaved?={ unsaved } data-save-changes data-busy-label="Saving…">Save</button>
		@settingFeedback(errorText, notice)
	</div>
}

templ UploadLimitForm(u UploadLimitSettings) {
	<form class="stack-form settings-group" id="upload-limit-form" hx-post="/settings/upload-limit" hx-target="this" hx-swap="outerHTML" data-lock-while-saving>
		<h3>Upload size limit</h3>
		if u.Fixed {
			<p>Each uploaded file can be up to <strong>{ u.Limit }</strong>.</p>
			@fixedByDeployment("LUDOCK_MAX_UPLOAD_SIZE")
		} else {
			<div>
				<label class="narrow-field">
					Largest file
					<input name="limit" value={ u.Limit } placeholder="No limit" maxlength="32" autocomplete="off" spellcheck="false" aria-describedby="upload-limit-help"/>
				</label>
				<p class="muted" id="upload-limit-help">For example 500 MB or 4 GiB. Empty allows any file that leaves the server’s disk room to spare.</p>
			</div>
			@saveRow("Save upload limit", u.Error, u.Notice, u.Error != "")
		}
	</form>
}

templ LoggingForm(l LoggingSettings) {
	<form class="stack-form settings-group" id="logging-form" hx-post="/settings/logging" hx-target="this" hx-swap="outerHTML" hx-disable="find input">
		<h3>Verbose logging</h3>
		if l.Fixed {
			<p>Ludock logs at the <strong>{ l.Level }</strong> level.</p>
			@fixedByDeployment("LUDOCK_LOG_LEVEL")
		} else {
			<label class="check-label">
				<input type="checkbox" id="logging-verbose" name="verbose" value="true" checked?={ l.Verbose } aria-describedby="logging-help" data-autosubmit/>
				Log extra detail
			</label>
			<p class="muted check-help" id="logging-help">For a bug report; it turns itself off after 24 hours. Read it with <code>docker compose logs ludock</code>.</p>
			if l.Verbose && l.Notice == "" {
				<p class="muted">On until @Time(l.Until, "", "")</p>
			}
			@settingFeedback(l.Error, l.Notice)
		}
	</form>
}

// trustValues trusts peer. Trust is a button of its own, not a submit, so
// Enter in the field saves what is typed and never trusts the proxy; the two
// share one request at a time.
func trustValues(peer string) string {
	values, _ := json.Marshal(map[string]string{"trust": peer})
	return string(values)
}

templ ProxyForm(p ProxySettings) {
	<form class="stack-form settings-group" id="proxy-form" hx-post="/settings/proxies" hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" data-lock-while-saving>
		<h3>Reverse proxy</h3>
		if p.Fixed {
			if p.Trusted == "" {
				<p>Ludock trusts no proxy.</p>
			} else {
				<p>Ludock trusts <code>{ p.Trusted }</code>.</p>
			}
			@fixedByDeployment("LUDOCK_TRUSTED_PROXIES")
		} else {
			if p.Forwarded != "" {
				<div class="alert alert--info proxy-hint" role="status">
					<div>
						<p>You’re reaching Ludock through a proxy at <strong>{ p.Forwarded }</strong> that it doesn’t trust, so every visitor shares that address.</p>
						<button class="secondary-btn" type="button" hx-post="/settings/proxies" hx-vals={ trustValues(p.Forwarded) } hx-target="#proxy-form" hx-swap="outerHTML" hx-sync="#proxy-form:drop" data-lock-while-saving data-busy-label="Trusting…">Trust { p.Forwarded }</button>
					</div>
				</div>
			}
			<div>
				<label>
					Trusted proxy addresses
					<input name="trusted" value={ p.Trusted } placeholder="None" maxlength="2048" autocapitalize="none" autocomplete="off" spellcheck="false" aria-describedby="proxy-help"/>
				</label>
				<p class="muted" id="proxy-help">Only your own proxy, such as 172.18.0.2 or 172.18.0.0/16, so sign-in limits see each visitor’s address.</p>
			</div>
			@saveRow("Save proxies", p.Error, p.Notice, p.Error != "")
		}
	</form>
}

templ ConnectionForm(c ConnectionSettings) {
	<form class="stack-form" id="connection-form" hx-post="/settings/connection" hx-target="this" hx-swap="outerHTML" data-lock-while-saving>
		<p class="section-lede">The name or IP address players use to reach this host. Ludock adds each server’s port.</p>
		<label class="narrow-field">
			Public address
			<input name="host" value={ c.Host } placeholder={ c.PageHost } maxlength="253" autocapitalize="none" autocomplete="off" spellcheck="false" aria-describedby="connection-host-help"/>
		</label>
		<p class="muted" id="connection-host-help">For example, play.example.com. Leave it empty to use the address you opened Ludock with ({ c.PageHost }).</p>
		if c.Error != "" {
			@Alert("error", c.Error)
		}
		if c.Notice != "" {
			@Alert("success", c.Notice)
		}
		<button class="primary-btn" type="submit" data-busy-label="Saving…">Save address</button>
	</form>
}

templ ImageUpdateSettingsForm(u ImageUpdateSettings) {
	<form class="stack-form" id="image-update-settings-form" hx-post="/settings/image-updates" hx-target="this" hx-swap="outerHTML" hx-disable="find input">
		<label class="check-label">
			<input type="checkbox" id="image-update-enabled" name="enabled" value="true" checked?={ u.Enabled } aria-describedby="image-update-help" data-autosubmit/>
			Check for newer server images
		</label>
		<p class="muted check-help" id="image-update-help">For your servers and for Ludock itself, a few times a day, without downloading or installing anything.</p>
		if u.Error != "" {
			@Alert("error", u.Error)
		}
		if u.Notice != "" {
			@Alert("success", u.Notice)
		}
	</form>
}

// ImageUpdateSettingsSaved is the saved form and the Ludock check, which the
// setting turns on or off with the server checks.
templ ImageUpdateSettingsSaved(u ImageUpdateSettings, ludock *update.CheckStatus, offer selfupdate.Offer) {
	@ImageUpdateSettingsForm(u)
	@Partial("#ludock-check", "outerHTML") {
		@LudockCheck(ludock, offer)
	}
	@Partial("#ludock-notice", "outerHTML") {
		@LudockNotice(ludock, offer)
	}
}

// LudockCheckSaved is a fresh Ludock check and the notice above Settings.
templ LudockCheckSaved(check *update.CheckStatus, offer selfupdate.Offer) {
	@LudockCheck(check, offer)
	@Partial("#ludock-notice", "outerHTML") {
		@LudockNotice(check, offer)
	}
}

// LudockNotice tops Settings while a newer Ludock is available, while it
// updates, and with how the last update ended: a success until the next
// check, a failure until it is dismissed. While it updates the page polls
// it, and reloads once Ludock answers again after a restart.
templ LudockNotice(check *update.CheckStatus, offer selfupdate.Offer) {
	<div id="ludock-notice">
		if offer.Updating {
			<div class="alert alert--info" role="status" data-await-restart hx-get="/fragments/settings/ludock-update" hx-trigger="every 3s" hx-target="#ludock-notice" hx-swap="outerHTML">
				<div>
					<p><strong>Ludock is updating.</strong> It restarts on the new version while your game servers keep running. This page comes back by itself once it has, usually within a few minutes; downloading a large image can take longer.</p>
				</div>
			</div>
		} else {
			if failed := offer.Failed; failed != nil {
				<div class="alert alert--error" role="alert">
					<div>
						<p><strong>{ ludockFailed(*failed) }</strong></p>
						if failed.State == selfupdate.StateInterrupted && failed.Finished {
							if failed.Copy {
								<p class="muted">The copy of its data from before the update, { selfupdate.CopyName }, is beside its database. The next update replaces it.</p>
							}
						} else if failed.State == selfupdate.StateInterrupted && failed.Unchecked {
							<p>Ludock couldn’t check with Docker just now which containers are left, so it gives no command yet. Reload this page in a moment.</p>
						} else if failed.State == selfupdate.StateInterrupted {
							if failed.OnLeftover && failed.OriginalGone {
								// Removing it could orphan an anonymous volume that holds the data.
								<p>This Ludock runs in the new container, still under its temporary name { failed.Leftover }. Give it Ludock’s name:</p>
								<pre><code>docker rename { failed.Leftover } { failed.Name }</code></pre>
							} else {
								if failed.OnLeftover {
									<p>This Ludock runs in the new container, still under its temporary name { failed.Leftover }. The commands below remove it and start Ludock again under its own name, on the new version; this page is away for a moment meanwhile.</p>
								}
								<p>In the folder with its compose.yaml, run:</p>
								<pre><code>
									docker compose pull ludock{ "\n" }
									if failed.Leftover != "" {
										docker rm -f { failed.Leftover }{ "\n" }
									}
									docker compose up -d ludock
								</code></pre>
							}
							if failed.Copy {
								<p class="muted">The copy of its data from before the update, { selfupdate.CopyName }, is beside its database. The next update replaces it.</p>
							}
						} else if offer.NoCommands {
							// Recreating Ludock now would do harm, so no commands; the
							// notice below says why.
							<p>Try again later.</p>
						} else {
							<p>Try again later. If it keeps failing, <a href="https://github.com/Crunging/Ludock/issues">report it</a>.</p>
						}
						// One that left something behind shows until that is gone.
						if failed.State != selfupdate.StateInterrupted || failed.Finished {
							<div class="inline-actions">
								<button class="secondary-btn" type="button" hx-post="/settings/ludock-update/dismiss" hx-vals={ dismissValues(failed.ID) } hx-target="#ludock-notice" hx-swap="outerHTML" data-busy-label="Dismissing…">Dismiss</button>
							</div>
						}
					</div>
				</div>
			} else if last := offer.Last; updatedSince(last, check) {
				if last.State == selfupdate.StateCurrent {
					@Alert("success", "Ludock already runs the newest image its tag points to.")
				} else {
					@Alert("success", ludockUpdated(*last))
				}
			}
			if offer.Refused && offer.Reason != "" {
				@Alert("error", offer.Reason)
			}
			if check != nil && check.State == update.CheckAvailable {
				<div class="alert alert--info" role="status">
					<div>
						if offer.Available {
							<p><strong>A newer Ludock is available.</strong></p>
							<div class="inline-actions">
								<button
									class="primary-btn"
									type="button"
									hx-post="/settings/ludock-update"
									hx-target="#ludock-notice"
									hx-swap="outerHTML"
									hx-confirm="Update Ludock?"
									data-confirm-detail={ confirmUpdate(offer) }
									data-confirm-action="Update Ludock"
									data-busy-label="Starting…"
								>Update Ludock</button>
							</div>
						} else {
							if offer.NoCommands {
								<p><strong>A newer Ludock is available.</strong> { offerReason(offer) }</p>
							} else {
								<p><strong>A newer Ludock is available.</strong> { offerReason(offer) }</p>
								<p>Where you started it, in the folder with its compose.yaml, run:</p>
								<pre><code>docker compose pull ludock{ "\n" }docker compose up -d ludock</code></pre>
							}
						}
					</div>
				</div>
			}
		}
	</div>
}

// LudockCheck shows whether Ludock's own image tag points to a newer image.
// Images Ludock can't compare show nothing, unless pinned.
templ LudockCheck(check *update.CheckStatus, offer selfupdate.Offer) {
	<div class="image-check ludock-check" id="ludock-check">
		if check == nil && offer.Pinned {
			<p class="muted">{ offer.Reason }</p>
		}
		if check != nil && check.State != update.CheckUnknown && check.State != update.CheckPlatform {
			<p class="muted">
				switch check.State {
					case update.CheckAvailable:
						<strong>A newer Ludock is available.</strong>
					case update.CheckCurrent:
						Ludock runs the newest image its tag points to.
					default:
						Ludock hasn’t checked for a newer version of itself yet.
				}
				if check.CheckedAt != 0 {
					Last checked @Time(check.CheckedAt, "plain", "")
				}
			</p>
			if check.Failed {
				<p class="muted">
					if check.ConfigProblem {
						Ludock could not read registry credentials from LUDOCK_DOCKER_CONFIG for the last check.
					} else {
						The last check couldn’t reach the registry, or the registry refused it.
					}
					Ludock will try again later. Last tried @Time(check.TriedAt, "plain", "")
				</p>
			}
			<div class="inline-actions">
				<button class="secondary-btn" type="button" hx-post="/settings/ludock-check" hx-target="#ludock-check" hx-swap="outerHTML" data-busy-label="Checking…">Check now</button>
			</div>
		}
	</div>
}

// BackupSummary is where backups go and how much they use, or what turns
// them on.
templ BackupSummary(b BackupSettingsView) {
	<div id="backup-summary">
		if b.Configured {
			<section class="backup-storage" aria-label="Backup storage" id="backup-storage" hx-get="/fragments/settings/backup-storage" hx-trigger="load" hx-swap="outerHTML">
				<p class="muted" role="status">Checking backup storage…</p>
			</section>
		} else if len(b.Roots) == 0 {
			<div class="admin-setup-help">
				<h3>Mount a backup folder first</h3>
				<ol>
					<li>Create a separate backup folder on the Docker host and mount it writable into Ludock, for example <code>/srv/ludock-backups:/backups</code>.</li>
					<li>In Ludock’s Compose file, remove the empty <code>LUDOCK_BACKUP_ROOTS</code> setting, then run <code>docker compose up -d</code> from its folder.</li>
					<li>Ludock turns backups on by itself once it finds the folder.</li>
				</ol>
			</div>
		} else {
			<p>Backups are off: Ludock couldn’t turn them on by itself with <code>{ b.Roots[0] }</code>. If no folder is mounted there, mount one where Ludock is defined and recreate Ludock. Otherwise choose the folder under <a class="text-link" href="#backup-storage-settings-title">Advanced</a> and save, and Ludock says what’s wrong with it.</p>
		}
	</div>
}

templ BackupSettingsForm(b BackupSettingsView) {
	<form class="stack-form" id="backup-settings-form" hx-post="/settings/backups" hx-target="this" hx-swap="outerHTML" data-lock-while-saving>
		if len(b.Roots) > 1 {
			<div class="admin-root-options">
				for _, root := range b.Roots {
					<button type="button" class="secondary-btn" data-fill="backup-destination" data-fill-value={ root }>Use <code>{ root }</code></button>
				}
			</div>
		}
		<div>
			<label>
				Backup folder
				<input id="backup-destination" name="destination" value={ b.Destination } placeholder="/backups" autocapitalize="none" spellcheck="false" aria-describedby="backup-destination-help" required/>
			</label>
			<p class="muted" id="backup-destination-help">A folder mounted into Ludock and listed in <code>LUDOCK_BACKUP_ROOTS</code>, separate from game data.</p>
		</div>
		<div class="form-columns">
			<div>
				<label>
					Minimum free space (GiB)
					<input type="number" name="reserveGiB" min="0" step="any" inputmode="decimal" value={ b.ReserveGiB } aria-describedby="backup-reserve-help" required/>
				</label>
				<p class="muted" id="backup-reserve-help">Backups and restores leave this much free on each disk; 0 for none.</p>
			</div>
			<div>
				<label>
					Total limit for all backups (GiB)
					<input type="number" name="maxGiB" min="0.000000001" step="any" inputmode="decimal" value={ b.MaxGiB } placeholder="No limit" aria-describedby="backup-limit-help"/>
				</label>
				<p class="muted" id="backup-limit-help">Empty for no limit but the free space.</p>
			</div>
		</div>
		if roots := b.copyRoots(); len(roots) > 0 {
			<div>
				<label>
					Also copy backups to
					<select name="copyTo" aria-describedby="backup-copy-help">
						<option value="" selected?={ b.CopyTo == "" }>No second copy</option>
						for _, root := range roots {
							<option value={ root } selected?={ root == b.CopyTo }>{ root }</option>
						}
					</select>
				</label>
				<p class="muted" id="backup-copy-help">A folder on another disk or a NAS, so losing one disk doesn’t lose every backup.</p>
			</div>
		} else {
			<p class="muted" id="backup-copy-help">For a second copy of every backup, mount a folder from another disk at <code>/backups-copy</code> in Ludock’s Compose file. Ludock starts copying to it by itself.</p>
		}
		@saveRow("Save backup settings", b.Error, map[bool]string{true: "Backup settings saved."}[b.Saved], b.Error != "" || !b.Configured)
	</form>
}

// BackupSettingsSaved is the saved form and a fresh summary.
templ BackupSettingsSaved(b BackupSettingsView) {
	@BackupSettingsForm(b)
	@Partial("#backup-summary", "outerHTML") {
		@BackupSummary(b)
	}
}

// BackupStorage follows backups and copies made while the page is open.
templ BackupStorage(status backups.StorageStatus) {
	<section class="backup-storage" aria-label="Backup storage" id="backup-storage" hx-get="/fragments/settings/backup-storage" hx-trigger="every 60s" hx-swap="outerMorph">
		<dl class="backup-storage__values">
			<div class="backup-storage__folder"><dt>Saved in</dt><dd><code>{ status.Destination }</code></dd></div>
			<div>
				<dt>Backups use</dt>
				<dd>
					{ FormatBytes(status.ArchiveBytes) }
					if status.Unlisted {
						<small class="backup-storage__found">As recorded; a folder can’t be read</small>
					}
				</dd>
			</div>
			if status.KeptBytes > 0 {
				<div><dt>Kept backups</dt><dd>{ FormatBytes(status.KeptBytes) }</dd></div>
			}
			<div>
				<dt>Free on disk</dt>
				<dd>
					if status.AvailableBytes >= 0 {
						{ FormatBytes(status.AvailableBytes) }
					} else {
						Unavailable
					}
				</dd>
			</div>
			if status.MaxBytes > 0 {
				<div><dt>Total limit</dt><dd>{ FormatBytes(status.MaxBytes) }</dd></div>
			}
			if status.CopyTo != "" {
				<div class="backup-storage__folder">
					<dt>Second copy in</dt>
					<dd>
						<code>{ status.CopyTo }</code>
						if status.CopyAvailableBytes >= 0 {
							<span class="muted">({ FormatBytes(status.CopyAvailableBytes) } free)</span>
						}
						if status.CopyFound {
							<small class="backup-storage__found">Ludock found this folder mounted, so it copies every backup there. Change that under <a class="text-link" href="#backup-storage-settings-title">Advanced</a>.</small>
						}
					</dd>
				</div>
			}
			if status.Destination != "" {
				<div class="backup-storage__folder" id="ludock-data-save">
					<dt>Ludock’s own data</dt>
					<dd>
						if status.DataSavedAt > 0 {
							Saved @Time(status.DataSavedAt, "plain", "")
						} else {
							Saved here every day and after changes, starting shortly
						}
					</dd>
				</div>
			}
		</dl>
		if len(status.Removed) > 0 {
			<p class="backup-storage__removed">
				Servers removed from Ludock still have backups here. Delete them on each server’s Backups tab when you no longer need them:
				for index, server := range status.Removed {
					<a class="text-link" href={ templ.SafeURL("/servers/" + server.ID + "?tab=backups") }>{ server.Name }</a> ({ counted(server.Backups, "backup", "backups") }){ map[bool]string{true: ".", false: ","}[index == len(status.Removed)-1] }
				}
			</p>
		}
		if len(status.Issues) > 0 || status.CopyIssue != "" || status.DataProblem != "" {
			<ul class="backup-storage__issues">
				for _, issue := range status.Issues {
					<li>{ issue.Message }</li>
				}
				if status.CopyIssue != "" {
					<li>{ status.CopyIssue }</li>
				}
				if status.DataProblem != "" {
					<li>{ status.DataProblem }</li>
				}
			</ul>
		}
	</section>
}

func destinationID(d notify.Destination, part string) string {
	return "notification-" + string(d) + "-" + part
}

func destinationSummary(d notify.Destination) string {
	return map[notify.Destination]string{
		notify.Discord:  "A channel in your Discord server, through a webhook.",
		notify.Ntfy:     "Push notifications to phones and desktops from ntfy.sh or your own ntfy server.",
		notify.Gotify:   "Push notifications from your self-hosted Gotify server.",
		notify.Telegram: "Messages from a Telegram bot to you, a group, or a channel.",
		notify.Email:    "Email through any SMTP mail server or provider.",
		notify.Webhook:  "A JSON POST to any URL, for Home Assistant, n8n, or your own scripts.",
	}[d]
}

// DestinationURL opens a destination's card on the Settings page.
func DestinationURL(d notify.Destination) string {
	return "/settings?destination=" + string(d) + "#" + destinationID(d, "card")
}

func (n NotificationDestinationView) failing() bool { return n.Ready() && n.Health.Failing }

// failureReason is why alerts fail, unless a failed test below says it.
func (n NotificationDestinationView) failureReason() string {
	if n.Health.Reason == "" || n.Test != nil && n.Test.LastFailure == n.Health.Reason {
		return ""
	}
	return " " + n.Health.Reason
}

func destinationState(n NotificationDestinationView) (string, string) {
	switch {
	case n.failing():
		return "Failing", "failed"
	case n.Ready():
		return "On", "ok"
	case n.Configured:
		return "Off", "idle"
	}
	return "Not set up", "idle"
}

func enableLabel(d notify.Destination) string {
	switch d {
	case notify.Email:
		return "Send alerts by email"
	case notify.Webhook:
		return "Send alerts to the webhook"
	}
	return "Send alerts to " + d.Label()
}

func portText(port int) string {
	if port == 0 {
		return ""
	}
	return strconv.Itoa(port)
}

// NotificationDestination is one destination's settings and test button.
templ NotificationDestination(n NotificationDestinationView) {
	<details class="notification-destination" id={ destinationID(n.Destination, "card") } open?={ n.Open }>
		<summary>
			<span class="notification-destination__name">{ n.Destination.Label() }</span>
			<span class="notification-destination__summary">{ destinationSummary(n.Destination) }</span>
			@destinationStateLabel(n)
		</summary>
		<div class="notification-destination__body">
			@destinationHealth(n)
			<form class="stack-form" id={ destinationID(n.Destination, "form") } hx-post={ "/settings/notifications/" + string(n.Destination) } hx-target="closest .notification-destination" hx-swap="outerHTML" data-lock-while-saving>
				@destinationFields(n)
				<label class="check-label">
					// A destination never saved is on once saved. A rejected save
					// shows the choice as sent.
					<input type="checkbox" name="enabled" value="true" checked?={ n.Enabled || (!n.Stored && n.Error == "") }/>
					{ enableLabel(n.Destination) }
				</label>
				@alertTypes(n)
				<p class="muted">Ludock keeps tokens, topics, passwords, and webhook URLs private: they are never shown again. Leave a saved field blank to keep it. Turning a destination off pauses its alerts without deleting its settings.</p>
				if n.Error != "" {
					@Alert("error", n.Error)
				}
				if n.Notice != "" {
					@Alert("success", n.Notice)
				}
				<button class="primary-btn" type="submit" data-busy-label="Saving…">{ "Save " + n.Destination.Label() }</button>
			</form>
			@NotificationTest(n)
		</div>
	</details>
}

templ destinationStateLabel(n NotificationDestinationView) {
	{{ state, tone := destinationState(n) }}
	<span class="notification-destination__state" id={ destinationID(n.Destination, "state") }>
		@Pip(tone)
		{ state }
	</span>
}

// destinationHealth says when alerts to a destination that is on aren't
// getting through.
templ destinationHealth(n NotificationDestinationView) {
	<div class="notification-destination__health" id={ destinationID(n.Destination, "health") }>
		if n.failing() {
			<div class="alert alert--error" role="alert">
				<p>{ "Alerts aren’t reaching " + n.Destination.Label() + "." + n.failureReason() } Last tried @Time(n.Health.LastTried, "", "")<span>.</span> Fix the settings below, then send a test.</p>
			</div>
		}
	</div>
}

func alertDescription(a notify.Alert) string {
	return map[notify.Alert]string{
		notify.ServerProblems: "A server goes down or recovers, its game stops answering, or it runs low on disk or memory.",
		notify.FailedWork:     "A backup, second copy, save of Ludock’s data, or scheduled action fails or can’t run.",
		notify.Results:        "A restore or update fails. Ones that succeed show their result in the panel.",
		notify.NewerImages:    "A newer image is published for a server or for Ludock. The server list or Settings shows this too.",
	}[a]
}

// alertChoice summarizes the alert types a destination gets.
func alertChoice(chosen notify.Alert) string {
	var labels []string
	for _, a := range notify.AlertTypes {
		if chosen.Includes(a) {
			labels = append(labels, a.Label())
		}
	}
	switch {
	case len(labels) == len(notify.AlertTypes):
		return "Everything"
	case chosen == 0 || chosen == notify.DefaultAlerts:
		return "Everything except newer images"
	}
	return strings.Join(labels, ", ")
}

templ alertTypes(n NotificationDestinationView) {
	<details class="disclosure notification-alerts" open?={ n.NoAlerts }>
		<summary>
			Alert types
			if !n.NoAlerts {
				<span class="notification-alerts__choice">{ alertChoice(n.Config.Alerts) }</span>
			}
		</summary>
		<fieldset class="notification-alerts__options">
			<legend class="sr-only">{ "Alert types to send to " + n.Destination.Label() }</legend>
			for _, alert := range notify.AlertTypes {
				<label class="check-label notification-alerts__option">
					<input type="checkbox" name="alerts" value={ alert.Name() } checked?={ !n.NoAlerts && n.Config.Alerts.Includes(alert) }/>
					<span>
						{ alert.Label() }
						<span class="muted">{ alertDescription(alert) }</span>
					</span>
				</label>
			}
		</fieldset>
	</details>
}

// NotificationTest is a destination's test button and its result.
templ NotificationTest(n NotificationDestinationView) {
	<div class="notification-destination__test" id={ destinationID(n.Destination, "test") }>
		<div class="inline-actions">
			<button type="button" class="secondary-btn" disabled?={ !n.Ready() } aria-describedby={ destinationID(n.Destination, "test-help") } hx-post={ "/settings/notifications/" + string(n.Destination) + "/test" } hx-target={ "#" + destinationID(n.Destination, "test") } hx-swap="outerHTML" data-busy-label="Sending…">Send test notification</button>
			<p class="muted" id={ destinationID(n.Destination, "test-help") }>
				if n.Ready() {
					Sends a test with the saved settings. Its result shows here.
				} else {
					Save the settings with this destination turned on to send a test.
				}
			</p>
		</div>
		if n.TestError != "" {
			@Alert("error", n.TestError)
		}
		if n.Test != nil {
			@NotificationTestResult(n)
		}
	</div>
}

// testWait is how long a test may wait to be sent before the result stops
// waiting for it.
const testWait = 60_000

func testSending(t *notify.Delivery) bool {
	return t.State == "queued" && t.Attempts == 0 && !t.Paused && time.Now().UnixMilli()-t.CreatedAt < testWait
}

// NotificationTestResult follows a test until it is delivered or fails.
templ NotificationTestResult(n NotificationDestinationView) {
	{{ label := n.Destination.Label() }}
	<div
		class="notification-test-result"
		id={ destinationID(n.Destination, "test-result") }
		aria-live="polite"
		if testSending(n.Test) {
			hx-get={ "/fragments/settings/notifications/" + string(n.Destination) + "/tests/" + n.Test.ID }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		switch {
			case n.Test.State == "delivered":
				@Alert("success", testDelivered(n.Destination))
			case n.Test.State == "failed" || n.Test.LastFailure != "":
				@Alert("error", "The test didn’t arrive. "+n.Test.LastFailure)
			case n.Test.Paused:
				@Alert("info", label+" was turned off before the test was sent.")
			case testSending(n.Test):
				<p class="muted" role="status">{ "Sending the test to " + label + "…" }</p>
			default:
				@Alert("info", "The test is still waiting to be sent. Recent deliveries, under Advanced, shows when it goes.")
		}
	</div>
}

// NotificationTestSent is a test's button and result; a test can settle
// before the response, so the destination's state comes too.
templ NotificationTestSent(n NotificationDestinationView) {
	@NotificationTest(n)
	@destinationHealthUpdate(n)
}

// NotificationTestUpdate is a test's result and, once it is settled, the
// destination's state it may have changed.
templ NotificationTestUpdate(n NotificationDestinationView) {
	@NotificationTestResult(n)
	if !testSending(n.Test) {
		@destinationHealthUpdate(n)
	}
}

// destinationHealthUpdate refreshes a card's state and failure warning.
templ destinationHealthUpdate(n NotificationDestinationView) {
	@Partial("#"+destinationID(n.Destination, "state"), "outerHTML") {
		@destinationStateLabel(n)
	}
	@Partial("#"+destinationID(n.Destination, "health"), "outerHTML") {
		@destinationHealth(n)
	}
}

// secretField is a write-only input: a saved value is never sent back.
templ secretField(n NotificationDestinationView, name, label, placeholder, help string, maxlength int) {
	<div class="secret-field">
		<label>
			if n.Saved[name] {
				{ "Replace " + strings.ToLower(label[:1]) + label[1:] }
			} else {
				{ label }
			}
			<input
				type="password"
				id={ destinationID(n.Destination, name+"-field") }
				name={ name }
				autocomplete="new-password"
				autocapitalize="none"
				spellcheck="false"
				maxlength={ strconv.Itoa(maxlength) }
				if help != "" {
					aria-describedby={ destinationID(n.Destination, name+"-help") }
				}
				placeholder={ map[bool]string{true: "Saved (leave blank to keep it)", false: placeholder}[n.Saved[name]] }
			/>
		</label>
		// Shows only what is typed: a saved value is never put in the field.
		<button class="text-link secret-reveal" type="button" data-reveal={ destinationID(n.Destination, name+"-field") } aria-controls={ destinationID(n.Destination, name+"-field") } aria-pressed="false">Show what you typed</button>
	</div>
	if help != "" {
		<p class="muted" id={ destinationID(n.Destination, name+"-help") }>{ help }</p>
	}
}

templ clearTokenField(n NotificationDestinationView, label string) {
	if n.Saved["token"] {
		<label class="check-label">
			<input type="checkbox" name="clearToken" value="true"/>
			{ label }
		</label>
	}
}

templ destinationFields(n NotificationDestinationView) {
	switch n.Destination {
		case notify.Discord:
			if !n.Configured {
				<p class="muted">
					In Discord, open your server’s Settings → Integrations, create a webhook, choose the channel, and copy its URL here.
					<a class="text-link" href="https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks" target="_blank" rel="noreferrer">Discord webhook guide</a>
				</p>
			}
			@secretField(n, "url", "Webhook URL", "https://discord.com/api/webhooks/…", "", 1024)
		case notify.Ntfy:
			<label>
				Server URL
				<input name="url" type="url" value={ n.Config.URL } placeholder={ notify.DefaultNtfyServer } maxlength="1024" autocapitalize="none" spellcheck="false" aria-describedby={ destinationID(n.Destination, "url-help") }/>
			</label>
			<p class="muted" id={ destinationID(n.Destination, "url-help") }>Leave empty for ntfy.sh, or enter your own server’s address. Subscribe to the topic in the ntfy app.</p>
			@secretField(n, "topic", "Topic", "ludock-alerts-7f3k", "Anyone who knows a topic on a public server can read it, so choose one that is hard to guess.", 64)
			@secretField(n, "token", "Access token (optional)", "tk_…", "Needed only when the topic is protected.", 256)
			@clearTokenField(n, "Remove the saved access token")
		case notify.Gotify:
			<label>
				Server URL
				<input name="url" type="url" value={ n.Config.URL } placeholder="https://gotify.example.com" maxlength="1024" autocapitalize="none" spellcheck="false"/>
			</label>
			@secretField(n, "token", "Application token", "A…", "In Gotify, open Apps, create an application for Ludock, and copy its token.", 256)
		case notify.Telegram:
			@secretField(n, "token", "Bot token", "123456789:AA…", "Create a bot with @BotFather and copy the token it gives you.", 100)
			<label>
				Chat ID
				<input name="chatId" value={ n.Config.ChatID } placeholder="123456789" maxlength="33" autocapitalize="none" spellcheck="false" aria-describedby={ destinationID(n.Destination, "chat-help") }/>
			</label>
			<p class="muted" id={ destinationID(n.Destination, "chat-help") }>Your user, group, or channel ID, or a public channel’s { "@name" }. Send the bot a message, or add it to the group or channel, before testing.</p>
		case notify.Email:
			<div class="form-columns">
				<label>
					Mail server
					<input name="host" value={ n.Config.Host } placeholder="smtp.example.com" maxlength="255" autocapitalize="none" spellcheck="false"/>
				</label>
				<label>
					Security
					<select name="security">
						<option value="starttls" selected?={ n.Config.Security == "" || n.Config.Security == "starttls" }>STARTTLS (port 587)</option>
						<option value="tls" selected?={ n.Config.Security == "tls" }>TLS (port 465)</option>
						<option value="none" selected?={ n.Config.Security == "none" }>None (local relay)</option>
					</select>
				</label>
				<label>
					Port
					<input name="port" type="number" min="1" max="65535" inputmode="numeric" value={ portText(n.Config.Port) } placeholder="Default"/>
				</label>
			</div>
			<div class="form-columns">
				<label>
					Username (optional)
					<input name="username" value={ n.Config.Username } maxlength="256" autocomplete="off" autocapitalize="none" spellcheck="false"/>
				</label>
				<div>
					@secretField(n, "password", "Password", "", "", 256)
				</div>
			</div>
			<div class="form-columns">
				<label>
					From
					<input name="sender" value={ n.Config.From } placeholder="ludock@example.com" maxlength="320" autocapitalize="none" spellcheck="false"/>
				</label>
				<label>
					To
					<input name="recipients" value={ n.Config.To } placeholder="you@example.com" maxlength="2000" autocapitalize="none" spellcheck="false" aria-describedby={ destinationID(n.Destination, "to-help") }/>
				</label>
			</div>
			<p class="muted" id={ destinationID(n.Destination, "to-help") }>Separate up to 10 recipients with commas. Leave the username empty when the server needs no sign-in. Many providers need an app password.</p>
		case notify.Webhook:
			@secretField(n, "url", "Webhook URL", "https://example.com/hooks/ludock", "Ludock sends a POST with a JSON body: source (\"ludock\"), id, kind (\"event\" or \"test\"), alert (the alert type, on events), message, and createdAt. The id stays the same when a delivery is retried.", 1024)
			@secretField(n, "token", "Authorization header (optional)", "Bearer …", "Sent as the request’s Authorization header.", 1024)
			@clearTokenField(n, "Remove the saved Authorization header")
	}
}

type DeliveriesView struct {
	Deliveries []notify.Delivery
	// Destinations refresh the cards above, which a delivery may change.
	Destinations  []NotificationDestinationView
	Error, Notice string
}

func (d DeliveriesView) pending() bool {
	for _, delivery := range d.Deliveries {
		if delivery.State == "queued" && !delivery.Paused {
			return true
		}
	}
	return false
}

func deliveryType(delivery notify.Delivery) string {
	switch {
	case delivery.Kind == "test":
		return "Test notification"
	case delivery.Alert != 0:
		return delivery.Alert.Label()
	}
	return "Alert"
}

func deliveryStatus(delivery notify.Delivery) string {
	switch {
	case delivery.State == "delivered":
		return "Delivered"
	case delivery.State == "failed":
		return "Failed"
	case delivery.Paused:
		return "Paused"
	case delivery.Attempts > 0:
		return "Pending retry"
	}
	return "Queued"
}

func deliveryTone(delivery notify.Delivery) string {
	switch {
	case delivery.State == "delivered":
		return "ok"
	case delivery.State == "failed":
		return "failed"
	case !delivery.Paused:
		return "active"
	}
	return "idle"
}

templ Deliveries(d DeliveriesView) {
	<div
		class="notification-deliveries"
		if d.pending() {
			hx-get="/fragments/settings/deliveries"
			hx-trigger="every 5s"
			hx-sync="#notification-deliveries:queue last"
			hx-target="#notification-deliveries"
		}
	>
		if d.Error != "" {
			@Alert("error", d.Error)
		}
		if d.Notice != "" {
			@Alert("success", d.Notice)
		}
		<p class="muted notification-deliveries__help" id="notification-deliveries-help">The latest 50 notifications. Retry a failed one after fixing its destination.</p>
		<div class="table-scroll">
			<table class="data-table notification-deliveries-table" aria-label="Recent notification deliveries" role="table">
				<thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Notification</th><th scope="col" role="columnheader">Destination</th><th scope="col" role="columnheader">Delivery</th><th scope="col" role="columnheader">Action</th></tr></thead>
				<tbody role="rowgroup">
					if len(d.Deliveries) == 0 {
						<tr role="row"><td role="cell" colspan="4" class="muted">No notifications have been queued yet. Send a test to check delivery.</td></tr>
					}
					for _, delivery := range d.Deliveries {
						<tr role="row">
							<td role="cell">
								<span class="notification-delivery-message">{ delivery.Message }</span>
								<span class="table-detail">{ deliveryType(delivery) + " · Queued " }@Time(delivery.CreatedAt, "", "")</span>
							</td>
							<td role="cell">{ delivery.Destination.Label() }</td>
							<td role="cell">
								<strong class={ "notification-delivery-status", "notification-delivery-status--" + delivery.State }>
									@Pip(deliveryTone(delivery))
									{ deliveryStatus(delivery) }
								</strong>
								<span class="table-detail">{ strconv.Itoa(delivery.Attempts) } { map[bool]string{true: "attempt", false: "attempts"}[delivery.Attempts == 1] }</span>
								if delivery.DeliveredAt != 0 {
									<span class="table-detail">Delivered @Time(delivery.DeliveredAt, "", "")</span>
								} else if delivery.LastAttemptAt != 0 {
									<span class="table-detail">Last tried @Time(delivery.LastAttemptAt, "", "")</span>
								}
								if delivery.NextAttemptAt != 0 && !delivery.Paused {
									<span class="table-detail">
										if delivery.Attempts > 0 {
											{ "Next retry " }
										} else {
											{ "Next attempt " }
										}
										@Time(delivery.NextAttemptAt, "", "")
									</span>
								}
								if delivery.LastFailure != "" {
									<p class="notification-delivery-failure">{ delivery.LastFailure }</p>
								}
							</td>
							<td role="cell">
								if delivery.Retryable {
									<button type="button" class="secondary-btn" aria-label={ "Retry " + delivery.Destination.Label() + " notification" } aria-describedby="notification-deliveries-help" hx-post={ "/settings/notifications/deliveries/" + delivery.ID + "/retry" } hx-target="#notification-deliveries" hx-sync="#notification-deliveries:replace" data-busy-label="Queuing…">Retry</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
	for _, n := range d.Destinations {
		@destinationHealthUpdate(n)
	}
}
