package views

import (
	"net/url"
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/backups"
	"github.com/Crunging/Ludock/internal/update"
	"github.com/Crunging/Ludock/internal/servers"
)

type BackupsView struct {
	// Operation is a backup or restore the tab follows.
	Operation            ActivityView
	ServerID, ServerName string
	Admin                bool
	CanRead, CanCreate   bool
	CanRestore           bool
	CanDelete            bool
	// Blocked: the binding needs review or Docker state is unavailable.
	Blocked      bool
	Active       bool
	LatestBackup *servers.BackupSummary
	Backups      []backups.Backup
	HistoryError string
	Restore      *backups.Backup
	// Browse, when set, replaces the tab with one folder of a backup.
	Browse *BackupBrowser
}

func (b BackupsView) archives() bool { return b.Admin && b.CanRead }

templ BackupsTab(b BackupsView) {
	if b.Operation.SelectedID != "" {
		@SelectedOperation(b.Operation)
	}
	// The rest reloads when the followed operation finishes, so readiness,
	// the create button, and the list catch up.
	<div id="backups-tab" hx-get={ string(detailURL(b.ServerID, "tab=backups")) } hx-select="#backups-tab" hx-trigger="operation-finished from:document" hx-swap="outerHTML">
		if b.Browse != nil {
			@BackupBrowserView(*b.Browse)
		} else {
			@backupsTabBody(b)
		}
	</div>
}

templ backupsTabBody(b BackupsView) {
	<div class="section-heading">
		<h2>Backups</h2>
		if b.CanCreate {
			@CreateBackupButton(b.ServerID, b.ServerName, false)
		}
	</div>
	<p class="section-lede">The server stops while a backup copies, then goes back to how it was.</p>
	if b.CanCreate && !b.Blocked && !b.Active {
		<section class="backup-readiness" id="backup-readiness" aria-labelledby="backup-readiness-title" hx-get={ "/fragments/servers/" + b.ServerID + "/backups/preflight" } hx-trigger="load" hx-swap="outerHTML">
			<div class="backup-readiness__status">
				<h3 id="backup-readiness-title" class="sr-only">Backup readiness</h3>
				<p role="status">
					@Pip("active")
					Checking backup destination and data roots…
				</p>
			</div>
		</section>
	}
	if !b.archives() {
		<p class="section-note">
			Last backup:
			if b.LatestBackup != nil {
				@Time(b.LatestBackup.CreatedAt, "plain", "")
				({ FormatBytes(b.LatestBackup.Size) })
			} else {
				never
			}
		</p>
	}
	<details class="disclosure">
		<summary>How backups work</summary>
		<p>A backup stops the server for the whole copy, then restores its previous running state. A server that was already stopped stays stopped.</p>
		<p>The readiness check doesn’t copy anything or stop the server. Space and data can change before the backup runs, so Ludock checks them again then.</p>
		if b.Admin {
			<p>Choose where backups go and how many to keep in <a class="text-link" href="/settings">backup settings</a>.</p>
		}
	</details>
	if b.archives() {
		@BackupList(b)
	} else if b.Admin {
		<p class="section-note">Archive access is unavailable for this server.</p>
	} else {
		<p class="section-note">You can create backups using the administrator’s policy. Archive access and restoration require an administrator.</p>
	}
	if b.archives() && b.CanRestore && b.Restore != nil {
		@RestoreForm(b)
	}
}

// CreateBackupButton is replaced once readiness is known.
templ CreateBackupButton(serverID, serverName string, ready bool) {
	<button
		id="create-backup"
		class="primary-btn"
		type="button"
		disabled?={ !ready }
		hx-post={ "/servers/" + serverID + "/backups" }
		hx-target="#detail-status"
		hx-confirm={ "Back up " + serverName + "?" }
		data-confirm-detail="The server stops for the whole copy, then returns to how it was."
		data-confirm-action="Create backup"
		data-busy-label="Working…"
	>Create backup</button>
}

type ReadinessView struct {
	ServerID, ServerName string
	Admin                bool
	Preflight            *backups.Preflight
	Error                string
}

templ BackupReadiness(r ReadinessView) {
	{{ ready := r.Preflight != nil && r.Preflight.Ready }}
	<section
		class={ "backup-readiness", templ.KV("backup-readiness--ready", r.Preflight != nil && ready), templ.KV("backup-readiness--blocked", r.Preflight != nil && !ready) }
		id="backup-readiness"
		aria-labelledby="backup-readiness-title"
	>
		<div class="backup-readiness__status">
			<h3 id="backup-readiness-title" class="sr-only">Backup readiness</h3>
			if r.Preflight != nil {
				<p>
					if ready {
						@Pip("ok")
						<strong>Ready to back up.</strong>
					} else {
						@Pip("attention")
						<strong>Not ready to back up.</strong>
					}
				</p>
			}
			<button class="text-link" type="button" hx-get={ "/fragments/servers/" + r.ServerID + "/backups/preflight" } hx-target="#backup-readiness" hx-swap="outerHTML" data-busy-label="Checking…">Check again</button>
		</div>
		if r.Error != "" {
			<p class="alert alert--error" role="alert">{ r.Error }</p>
		}
		if r.Preflight != nil && len(r.Preflight.Issues) > 0 {
			<ul>
				for _, issue := range r.Preflight.Issues {
					<li>{ issue.Message }</li>
				}
			</ul>
		}
		if r.Preflight != nil && !ready {
			<p class="muted">
				if r.Admin {
					Fix these in <a class="text-link" href="/settings">backup settings</a> or the server’s mounts, then check again.
				} else {
					Ask an administrator to fix these, then check again.
				}
			</p>
		}
	</section>
	@Partial("#create-backup", "outerHTML") {
		@CreateBackupButton(r.ServerID, r.ServerName, ready)
	}
}

// BackupList is the archive table; it reloads after a deletion.
templ BackupList(b BackupsView) {
	<div class="table-scroll" id="backup-list" hx-get={ "/fragments/servers/" + b.ServerID + "/backups" } hx-trigger="backups-changed from:document" hx-swap="outerHTML">
		<table class="data-table">
			<thead>
				<tr>
					<th>Created</th>
					<th>Size</th>
					<th>State</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				if len(b.Backups) == 0 {
					<tr>
						<td colspan="4" class="muted">
							if b.HistoryError != "" {
								Backup history is unavailable.
							} else {
								No backups yet.
							}
						</td>
					</tr>
				}
				for _, backup := range b.Backups {
					<tr>
						<td>
							@Time(backup.CreatedAt, "", "")
							<small class="table-detail">@Time(backup.CreatedAt, "sentence", "")</small>
						</td>
						<td>{ FormatBytes(backup.Size) }</td>
						<td>
							@Pip(map[bool]string{true: "ok", false: "failed"}[backup.State == "complete"])
							{ backup.State }
						</td>
						<td>
							<div class="inline-actions">
								if backup.State == "complete" {
									<a class="secondary-btn" href={ detailURL(b.ServerID, "tab=backups&browse="+backup.ID) } { inPage()... }>Browse</a>
									<a class="secondary-btn" href={ templ.SafeURL("/servers/" + b.ServerID + "/backups/" + backup.ID + "/download") } download>Download</a>
								}
								if b.CanRestore && !b.Blocked && !b.Active && backup.State == "complete" {
									<a class="secondary-btn secondary-btn--danger" href={ detailURL(b.ServerID, "tab=backups&restore="+backup.ID) } { inPage()... }>Restore…</a>
								} else {
									<button class="secondary-btn secondary-btn--danger" type="button" disabled>Restore…</button>
								}
								<button
									class="secondary-btn secondary-btn--danger"
									type="button"
									disabled?={ !b.CanDelete || b.Active }
									hx-post={ "/servers/" + b.ServerID + "/backups/" + backup.ID + "/delete" }
									hx-target="#detail-status"
									hx-confirm="Delete this backup?"
									data-confirm-detail="The archive is deleted permanently."
									data-confirm-action="Delete backup"
									data-confirm-danger
									data-busy-label="Deleting…"
								>Delete</button>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ RestoreForm(b BackupsView) {
	<form class="danger-panel stack-form" hx-post={ "/servers/" + b.ServerID + "/restores" } hx-target="#restore-status">
		<h3>Restore backup from @Time(b.Restore.CreatedAt, "", "")</h3>
		<p>This replaces the server’s current game data. Ludock stops the server and takes a safety backup first; if that fails, nothing is replaced.</p>
		<details class="disclosure">
			<summary>More about restoring</summary>
			<p>Ludock checks the backup before replacing anything. The server returns to its previous running state only after the data is safe. Restoring game data doesn’t roll back the container image or its settings.</p>
		</details>
		<input type="hidden" name="backupId" value={ b.Restore.ID }/>
		<label>
			<span>Type <strong>{ b.ServerName }</strong> to confirm</span>
			<input name="confirmation" autocomplete="off" required data-confirm-value={ b.ServerName }/>
		</label>
		<div id="restore-status" aria-live="polite"></div>
		<div class="inline-actions">
			<button class="secondary-btn secondary-btn--danger" type="submit" data-busy-label="Working…">Restore game data</button>
			<a class="secondary-btn" href={ detailURL(b.ServerID, "tab=backups") } { inPage()... }>Cancel</a>
		</div>
	</form>
}

// BackupBrowser is one folder of a backup, for administrators.
type BackupBrowser struct {
	ServerID, ServerName string
	Backup               backups.Backup
	Roots                []backups.Root
	Root                 backups.Root
	Path                 string
	// Entries holds the first Limit of the folder's Total items.
	Entries      []backups.ArchiveEntry
	Total, Limit int
	Error        string
	CanRestore   bool
	// Pick is the item of this folder chosen for restoring.
	Pick *backups.ArchiveEntry
}

func (b BackupBrowser) values(path string) url.Values {
	values := url.Values{"browse": {b.Backup.ID}, "root": {b.Root.ID}}
	if path != "" {
		values.Set("path", path)
	}
	return values
}

func (b BackupBrowser) folderURL(path string) templ.SafeURL {
	return detailURL(b.ServerID, "tab=backups&"+b.values(path).Encode())
}

func (b BackupBrowser) rootURL(root backups.Root) templ.SafeURL {
	b.Root = root
	return b.folderURL("")
}

func (b BackupBrowser) pickURL(name string) templ.SafeURL {
	values := b.values(b.Path)
	values.Set("pick", name)
	return detailURL(b.ServerID, "tab=backups&"+values.Encode())
}

func (b BackupBrowser) moreURL() string {
	values := b.values(b.Path)
	values.Set("limit", strconv.Itoa(b.Limit+FilePage))
	return "/fragments/servers/" + b.ServerID + "/backups/" + b.Backup.ID + "/folder?" + values.Encode()
}

func (b BackupBrowser) child(name string) string {
	if b.Path == "" {
		return name
	}
	return b.Path + "/" + name
}

func (b BackupBrowser) fileURL(name string) templ.SafeURL {
	values := url.Values{"root": {b.Root.ID}, "path": {b.child(name)}}
	return templ.SafeURL("/servers/" + b.ServerID + "/backups/" + b.Backup.ID + "/file?" + values.Encode())
}

func (b BackupBrowser) crumbs() [][2]string {
	return FilesView{Path: b.Path}.breadcrumbs()
}

// livePath is where an item of this folder lives in the server's data.
func (b BackupBrowser) livePath(name string) string {
	return strings.TrimSuffix(b.Root.Path, "/") + "/" + b.child(name)
}

func itemCount(count int) string {
	if count == 1 {
		return "1 item"
	}
	return intText(count) + " items"
}

templ BackupBrowserView(b BackupBrowser) {
	<section class="file-manager backup-browser" aria-labelledby="backup-browser-title">
		<div class="section-heading">
			<h2 id="backup-browser-title">
				if b.Backup.ID != "" {
					Backup from @Time(b.Backup.CreatedAt, "", "")
				} else {
					Backup
				}
			</h2>
			<a class="secondary-btn" href={ detailURL(b.ServerID, "tab=backups") } { inPage()... }>All backups</a>
		</div>
		<p class="section-lede">Look through what this backup holds without changing anything. Download a file, or restore one file or folder in place of the server’s current copy.</p>
		if b.Error != "" {
			<p class="alert alert--error" role="alert">Unable to open this backup: { b.Error }</p>
		} else {
			if len(b.Roots) > 1 {
				<nav class="inline-actions" aria-label="Data folders">
					for _, root := range b.Roots {
						<a
							class="secondary-btn"
							href={ b.rootURL(root) }
							if root.ID == b.Root.ID {
								aria-current="page"
							}
							{ inPage()... }
						>{ root.Path }</a>
					}
				</nav>
			}
			<div class="file-toolbar">
				<nav class="file-breadcrumbs" aria-label="Current folder">
					<a
						href={ b.folderURL("") }
						if b.Path == "" {
							aria-current="page"
						}
						{ inPage()... }
					>{ b.Root.Path }</a>
					for index, crumb := range b.crumbs() {
						<span>
							<b aria-hidden="true">/</b>
							<a
								href={ b.folderURL(crumb[1]) }
								if index == len(b.crumbs())-1 {
									aria-current="page"
								}
								{ inPage()... }
							>{ crumb[0] }</a>
						</span>
					}
				</nav>
			</div>
			if b.Pick != nil && b.CanRestore {
				@RestoreItemForm(b, *b.Pick)
			}
			@BackupFolder(b)
		}
	</section>
}

// BackupFolder is a backup folder's items; Show more replaces it.
templ BackupFolder(b BackupBrowser) {
	<div id="backup-folder">
		if b.Error != "" {
			<p class="alert alert--error" role="alert">Unable to open this backup: { b.Error }</p>
		} else {
			<div class="file-filter-summary">
				<p>Folders first</p>
				<p role="status">Showing { intText(len(b.Entries)) } of { intText(b.Total) } items</p>
			</div>
			<div class="file-list">
				<div class="file-list__header">
					<span>Name</span>
					<span>Size</span>
					<span>Modified</span>
					<span>Actions</span>
				</div>
				if b.Total == 0 {
					<p class="file-list__empty">This folder is empty.</p>
				}
				for index, entry := range b.Entries {
					<div class="file-row">
						<div class="file-row__name">
							@fileIcon(entry.Type)
							if entry.Type == "directory" {
								<a href={ b.folderURL(b.child(entry.Name)) } { inPage()... }>{ entry.Name }</a>
								<small>{ itemCount(entry.Items) }</small>
							} else {
								<span>{ entry.Name }</span>
							}
						</div>
						<span>{ FormatBytes(entry.Size) }</span>
						<span>
							if entry.ModifiedAt > 0 {
								@Time(int64(entry.ModifiedAt*1000), "", "")
							} else {
								—
							}
						</span>
						<div class="file-row__actions">
							if entry.Type == "file" || b.CanRestore {
								<div class="action-menu" data-action-menu>
									<button type="button" class="secondary-btn action-menu__trigger action-menu__trigger--compact" aria-label={ "Actions for " + entry.Name } aria-expanded="false" aria-controls={ "backup-item-" + intText(index) }>
										<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="3" cy="8" r="1.5"></circle><circle cx="8" cy="8" r="1.5"></circle><circle cx="13" cy="8" r="1.5"></circle></svg>
									</button>
									<div class="action-menu__content" id={ "backup-item-" + intText(index) } hidden>
										if entry.Type == "file" {
											<a class="action-menu__action" href={ b.fileURL(entry.Name) } download>Download</a>
										}
										if b.CanRestore {
											<a class="action-menu__action action-menu__action--danger" href={ b.pickURL(entry.Name) } { inPage()... }>Restore…</a>
										}
									</div>
								</div>
							}
						</div>
					</div>
				}
				if remaining := b.Total - len(b.Entries); remaining > 0 {
					<div class="file-list__more">
						<button class="secondary-btn" type="button" hx-get={ b.moreURL() } hx-target="#backup-folder" hx-swap="outerMorph" hx-sync="#backup-folder:queue last" data-busy-label="Loading…">Show { intText(min(remaining, FilePage)) } more</button>
					</div>
				}
			</div>
		}
	</div>
}

// RestoreItemForm confirms replacing one file or folder with its copy in
// the backup.
templ RestoreItemForm(b BackupBrowser, item backups.ArchiveEntry) {
	{{ kind := map[bool]string{true: "folder", false: "file"}[item.Type == "directory"] }}
	<form class="danger-panel stack-form" id="restore-item" hx-post={ "/servers/" + b.ServerID + "/restores" } hx-target="#restore-status">
		<h3>Restore the { kind } “{ item.Name }”?</h3>
		<p>
			The backup’s copy replaces <code>{ b.livePath(item.Name) }</code> in the server’s data, or brings it back if it was deleted.
			if item.Type == "directory" {
				Everything now inside that folder is replaced.
			}
			The rest of the server’s data stays as it is.
		</p>
		<dl class="metadata-list">
			<dt>Backup’s copy</dt>
			<dd>
				{ FormatBytes(item.Size) }
				if item.Type == "directory" {
					in { itemCount(item.Items) }
				}
			</dd>
			if item.ModifiedAt > 0 {
				<dt>Modified</dt>
				<dd>@Time(int64(item.ModifiedAt*1000), "", "")</dd>
			}
		</dl>
		<p>Ludock stops the server while it swaps the copies, then returns it to how it was. If the swap fails, the current copy is put back. Once the restore succeeds the current copy isn’t kept, so back up the server first if you might want it again.</p>
		<input type="hidden" name="backupId" value={ b.Backup.ID }/>
		<input type="hidden" name="root" value={ b.Root.ID }/>
		<input type="hidden" name="item" value={ b.child(item.Name) }/>
		<label>
			<span>Type <strong>{ b.ServerName }</strong> to confirm</span>
			<input name="confirmation" autocomplete="off" required data-confirm-value={ b.ServerName }/>
		</label>
		<div id="restore-status" aria-live="polite"></div>
		<div class="inline-actions">
			<button class="secondary-btn secondary-btn--danger" type="submit" data-busy-label="Working…">Restore { kind }</button>
			<a class="secondary-btn" href={ b.folderURL(b.Path) } { inPage()... }>Cancel</a>
		</div>
	</form>
}

type UpdateView struct {
	ServerID, ServerName string
	Admin, CanBackup     bool
	Blocked, Active      bool
	Recreate             bool
	Capability           *update.Capability
	Error                string
	// Check is the newest-image check, nil before it applies; ChecksOff
	// means an administrator turned the checks off.
	Check     *update.CheckStatus
	ChecksOff bool
}

templ UpdateTab(serverID string, recreate bool) {
	<div id="update-panel" hx-get={ "/fragments/servers/" + serverID + "/update" + map[bool]string{true: "?recreate=1"}[recreate] } hx-trigger="load" hx-swap="outerHTML">
		<p role="status">Loading server settings…</p>
	</div>
}

templ UpdatePanel(u UpdateView) {
	<div id="update-panel">
		if u.Capability == nil {
			<div>
				<p role="alert">Unable to load server settings. Reload them before making changes.</p>
				@reloadUpdate(u.ServerID, "Reload server settings")
			</div>
		} else {
			{{ capability := u.Capability }}
			<h2>{ capability.ActionLabel }</h2>
			if capability.UpdatesOnStart {
				<div class="startup-update-note">
					<h3>Game updates</h3>
					<p class="section-lede">This image downloads the latest game version when it starts, so Restart updates the game.</p>
					<p class="muted">
						Version pins in the image’s settings still apply.
						if u.CanBackup {
							To back up first, choose Take a backup first when you restart.
						}
					</p>
				</div>
			}
			if !u.Admin {
				if capability.UpdatesOnStart {
					<p class="section-note">Pulling a newer image needs an administrator.</p>
				} else {
					<p class="section-note">This image is not known to update the game on startup. Update it through its owning manager.</p>
				}
			} else {
				<h3>Update container image</h3>
				if !capability.Available {
					<p class="section-note">{ capability.UnavailableReason }</p>
					<div class="inline-actions">
						@reloadUpdate(u.ServerID, "Check again")
					</div>
				} else {
					@ImageCheck(u)
					@UpdateForm(u)
				}
			}
		}
	</div>
}

// ImageCheck is what the background check last learned about a newer image.
templ ImageCheck(u UpdateView) {
	<div class="image-check" id="image-check">
		if u.ChecksOff {
			<p class="muted">Checks for newer images are off. Turn them on in <a class="text-link" href="/settings#image-update-settings-title">Settings</a>.</p>
		} else {
			{{ check := u.Check }}
			if check != nil && check.State == update.CheckAvailable {
				<div class="alert alert--info image-check__available" role="status">
					<div>
						<p><strong>A newer image is available.</strong> Update the server below to use it.</p>
						if u.Capability.UpdatesOnStart {
							<p>This is the container image itself, such as its startup scripts and system packages. The game already updates on every restart.</p>
						}
					</div>
				</div>
			}
			<p class="muted image-check__status">
				switch {
					case check != nil && check.State == update.CheckPending && check.CheckedAt != 0:
						Ludock is waiting for a fresh answer from the registry.
					case check == nil || check.State == update.CheckPending:
						Ludock hasn’t checked the registry for a newer image yet.
					case check.State == update.CheckCurrent:
						This server runs the newest image its tag points to.
					case check.State == update.CheckUnknown:
						Ludock can’t tell which registry version this server’s image came from, so it can’t compare it with the registry.
					case check.State == update.CheckPlatform:
						The newest image for this tag doesn’t offer this server’s platform, so updating wouldn’t change it.
				}
			</p>
			if check != nil && check.CheckedAt != 0 {
				<p class="muted image-check__checked">Last checked @Time(check.CheckedAt, "plain", "")</p>
			}
			if check != nil && check.Failed {
				<p class="muted image-check__failed">
					if check.ConfigProblem {
						Ludock could not read registry credentials from LUDOCK_DOCKER_CONFIG for the last check.
					} else {
						The last check couldn’t reach the registry, or the registry refused it.
					}
					Ludock will try again later. Last tried @Time(check.TriedAt, "plain", "")
				</p>
			}
			<div class="inline-actions">
				<button class="secondary-btn" type="button" hx-post={ "/servers/" + u.ServerID + "/update-check" } hx-target="#image-check" hx-swap="outerHTML" data-busy-label="Checking…">Check now</button>
			</div>
		}
	</div>
}

templ reloadUpdate(serverID, label string) {
	<button class="secondary-btn" type="button" hx-get={ "/fragments/servers/" + serverID + "/update" } hx-target="#update-panel" hx-swap="outerHTML" data-busy-label="Checking…">{ label }</button>
}

templ UpdateForm(u UpdateView) {
	{{ capability := u.Capability }}
	<form class="stack-form" hx-post={ "/servers/" + u.ServerID + "/updates" } hx-target="#update-status">
		<p class="section-lede">
			Pull the newest version of this server’s image and recreate its container with the same settings. This updates the image itself, including its system packages and startup scripts.
		</p>
		<dl class="metadata-list">
			<dt>Configured image</dt>
			<dd>{ capability.Image }</dd>
		</dl>
		<details class="disclosure">
			<summary>What gets replaced</summary>
			<p>The new container keeps the old one’s settings, ports, networks, mounted folders, and volumes, including unnamed ones. Files changed inside the container outside those are lost. Other containers aren’t touched, and the tool that created this one still owns its settings.</p>
			<p>If the new container stops or reports itself unhealthy right after starting, Ludock restores the previous container and leaves it stopped, since the new version may already have changed the game data.</p>
		</details>
		<label class="check-label">
			<input type="checkbox" name="createBackup" value="true" id="update-backup" checked?={ u.CanBackup } disabled?={ !u.CanBackup }/>
			Create a stopped-server backup before recreation
		</label>
		<p class="muted check-help">The server stays stopped until it’s recreated. If it was stopped before, it stays stopped after.</p>
		<label class="check-label">
			<input type="checkbox" name="forceRecreate" value="true" id="update-recreate" checked?={ u.Recreate }/>
			Recreate anyway, even if the configured image is current
		</label>
		<p class="muted check-help" data-shown-by="update-recreate" hidden?={ !u.Recreate }>Use this to pick up a game update that installs on startup.</p>
		<label data-hidden-by="update-backup" hidden?={ u.CanBackup }>
			<span>Type <strong>{ u.ServerName }</strong> to skip the backup</span>
			<input name="skipBackupConfirmation" autocomplete="off"/>
		</label>
		<label class="check-label">
			<input type="checkbox" name="confirmed" value="true" required/>
			I understand that connected players will be disconnected and the server’s container will be recreated.
		</label>
		<div id="update-status" aria-live="polite"></div>
		<button class="primary-btn" type="submit" disabled?={ u.Blocked || u.Active } data-busy-label="Working…">{ capability.ActionLabel }</button>
	</form>
}
