package views

import (
	"net/url"
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/backups"
	"github.com/Crunging/Ludock/internal/helper"
	"github.com/Crunging/Ludock/internal/ops"
	"github.com/Crunging/Ludock/internal/update"
	"github.com/Crunging/Ludock/internal/servers"
)

type BackupsView struct {
	// Operation is a backup or restore the tab follows.
	Operation            ActivityView
	ServerID, ServerName string
	Admin                bool
	CanRead, CanCreate   bool
	CanRestore           bool
	CanDelete            bool
	// Blocked: the binding needs review or Docker state is unavailable.
	Blocked bool
	// Gone: the server's container is missing, so nothing backs it up or
	// removes its backups for retention.
	Gone   bool
	Active  bool
	// NoData: the server has no data folder Ludock can back up.
	NoData       bool
	// DeletedOnStop: Docker deletes the server when it stops, so it can't be
	// backed up or restored; the page header says why.
	DeletedOnStop bool
	LatestBackup *servers.BackupSummary
	Backups      []backups.Backup
	HistoryError string
	// FolderIssue says a backup folder isn't responding.
	FolderIssue string
	Restore      *backups.Backup
	// SetAside names the folders undoing earlier restores set aside in the
	// server's data, which restoring Restore replaces.
	SetAside []string
	// Fits says, for each backup, whether it restores onto the server as it
	// is now; nil while that is unknown.
	Fits map[string]backups.Fit
	// BindingRevision is the server's binding the page showed; a moved
	// restore is confirmed only for it.
	BindingRevision int64
	// Keep is the backup whose keep form is open.
	Keep *backups.Backup
	// Browse, when set, replaces the tab with one folder of a backup.
	Browse *BackupBrowser
	// Warn offers to warn players before a backup or restore.
	Warn bool
	// Running: the server is up, so taking it down disconnects whoever is on.
	Running bool
	// LastFailed is the newest backup attempt when it failed or was
	// interrupted.
	LastFailed *ops.Job
}

func (b BackupsView) archives() bool { return b.Admin && b.CanRead }

// usage says how much space the listed backups use, and how much of it
// kept backups hold. A missing archive takes none; one that couldn't be
// looked for counts as recorded.
func (b BackupsView) usage() string {
	var count int
	var total, kept int64
	recorded := false
	for _, backup := range b.Backups {
		if backup.State == "complete" && !backup.Missing {
			count++
			total += backup.Size
			if backup.KeptAt != 0 {
				kept += backup.Size
			}
			recorded = recorded || !backup.FromCopy && (backup.FolderAway || backup.CopyAway)
		}
	}
	if count == 0 {
		return ""
	}
	text := intText(count) + " backups use " + FormatBytes(total)
	if count == 1 {
		text = "1 backup uses " + FormatBytes(total)
	}
	if kept > 0 {
		text += ", " + FormatBytes(kept) + " of it in kept backups"
	}
	if recorded {
		text += ". As recorded; a folder can’t be read"
	}
	return text + "."
}

templ BackupsTab(b BackupsView) {
	if b.Operation.SelectedID != "" {
		@SelectedOperation(b.Operation)
	}
	// The rest reloads when the followed operation finishes, so readiness,
	// the create button, and the list catch up.
	<div id="backups-tab" hx-get={ string(detailURL(b.ServerID, "tab=backups")) } hx-select="#backups-tab" hx-trigger="operation-finished from:document" hx-swap="outerHTML">
		if b.Browse != nil {
			@BackupBrowserView(*b.Browse)
		} else {
			@backupsTabBody(b)
		}
	</div>
}

templ backupsTabBody(b BackupsView) {
	<div class="section-heading">
		<h2>Backups</h2>
		if b.CanCreate && !b.NoData {
			@CreateBackupButton(b.ServerID, b.ServerName, false, b.Warn, b.Running)
		}
	</div>
	if b.NoData {
		@noDataFolders(b.Admin)
	} else if b.Gone {
		<p class="section-lede">Its backups stay here until you delete them.</p>
	} else if !b.DeletedOnStop {
		<p class="section-lede">The server stops while a backup copies, then goes back to how it was.</p>
	}
	if failed := b.LastFailed; failed != nil {
		<p class="section-note backup-last-failed" id="backup-last-failed">
			@Pip("failed")
			// Dated by when it started, as Activity dates it: an interrupted
			// one was marked so only when Ludock started again.
			if failed.Status == ops.Interrupted {
				The last backup, started @Time(failed.CreatedAt, "", ""), was interrupted.
			} else {
				The last backup, started @Time(failed.CreatedAt, "", ""), failed.
			}
			<a class="text-link" href={ templ.SafeURL("/servers/" + b.ServerID + "?tab=activity&operation=" + failed.ID) }>See what happened</a>
		</p>
	}
	if b.CanCreate && !b.NoData && !b.Blocked && !b.Active {
		<div id="backup-readiness" hx-get={ "/fragments/servers/" + b.ServerID + "/backups/preflight" } hx-trigger="load" hx-swap="outerHTML"></div>
	}
	if !b.archives() {
		<p class="section-note">
			Last backup:
			if b.LatestBackup != nil {
				@Time(b.LatestBackup.CreatedAt, "plain", "")
				if note := SafetyNote(b.LatestBackup.Reason); note != "" {
					({ FormatBytes(b.LatestBackup.Size) }, { strings.ToLower(note) })
				} else {
					({ FormatBytes(b.LatestBackup.Size) })
				}
			} else {
				never
			}
		</p>
	}
	if b.archives() && b.Keep != nil {
		@KeepForm(b)
	}
	if b.archives() && b.CanRestore && b.Restore != nil {
		@RestoreForm(b)
	}
	if b.archives() && (!b.NoData || len(b.Backups) > 0) {
		@BackupList(b)
	} else if b.Admin && !b.archives() {
		<p class="section-note">The list of backups can’t be shown right now.</p>
	}
	if !b.NoData && !b.Gone {
		<details class="disclosure" id="backup-retention">
			<summary>Which backups Ludock keeps</summary>
			<p>The 3 newest, plus the last one of each of the 7 most recent days, 4 weeks, and 6 months with backups. The rest are removed after each new backup. Nothing is removed for its age alone, so a server that is rarely backed up keeps its old backups.</p>
			<p>Safety backups taken before a restore or update are counted apart: Ludock keeps the 3 newest of them, and they never take the place of your own backups.</p>
			if b.Admin {
				<p>Backups you keep are never removed.</p>
			}
			<p>When the backup disk runs short, this server’s safety backups go first, then its oldest other backups, until the next one fits. Its newest backup, the 3 newest of your own, and kept ones always stay.</p>
		</details>
	}
}

// noDataFolders explains a server whose data no backup can reach.
templ noDataFolders(admin bool) {
	<div class="alert alert--info" id="backup-no-data" role="status">
		<div>
			<p><strong>Ludock can’t back up this server.</strong> None of its data is in a folder Ludock can reach.</p>
			if admin {
				<p>Where you define the server, such as its Compose file or Portainer stack, give its game data a writable volume or bind mount and recreate it. Ludock finds the folder by itself.</p>
			} else {
				<p>Its owner can change that where the server is defined.</p>
			}
		</div>
	</div>
}

func backupDetail(running bool) string {
	detail := "The server stops for the whole copy, then returns to how it was."
	if note := DisconnectNote(running); note != "" {
		return detail + " " + note
	}
	return detail
}

// CreateBackupButton is replaced once readiness is known.
templ CreateBackupButton(serverID, serverName string, ready, warn, running bool) {
	<button
		id="create-backup"
		class="primary-btn"
		type="button"
		disabled?={ !ready }
		hx-post={ "/servers/" + serverID + "/backups" }
		hx-target="#detail-status"
		hx-confirm={ "Back up " + serverName + "?" }
		data-confirm-detail={ backupDetail(running) }
		data-confirm-action="Create backup"
		if warn {
			data-confirm-options={ confirmOptions([]ConfirmOption{WarnOption}) }
		}
		data-busy-label="Working…"
	>Create backup</button>
}

type ReadinessView struct {
	ServerID, ServerName string
	Admin                bool
	Preflight            *backups.Preflight
	Error                string
	Warn                 bool
	Running               bool
}

// BackupReadiness shows only what stops a backup; a ready server shows
// nothing but an enabled button.
templ BackupReadiness(r ReadinessView) {
	{{ ready := r.Preflight != nil && r.Preflight.Ready }}
	if ready {
		<div id="backup-readiness"></div>
	} else {
		<section class="backup-readiness backup-readiness--blocked" id="backup-readiness" aria-labelledby="backup-readiness-title">
			<div class="backup-readiness__status">
				<h3 id="backup-readiness-title">
					@Pip("attention")
					This server can’t be backed up right now
				</h3>
				<button class="text-link" type="button" hx-get={ "/fragments/servers/" + r.ServerID + "/backups/preflight?again=1" } hx-target="#backup-readiness" hx-swap="outerHTML" data-busy-label="Checking…">Check again</button>
			</div>
			if r.Error != "" {
				<p role="alert">{ r.Error }</p>
			}
			if r.Preflight != nil && len(r.Preflight.Issues) > 0 {
				<ul>
					for _, issue := range r.Preflight.Issues {
						<li>{ issue.Message }</li>
					}
				</ul>
			}
			if !r.Admin {
				<p class="muted">Ask an administrator to fix this.</p>
			}
		</section>
	}
	@Partial("#create-backup", "outerHTML") {
		@CreateBackupButton(r.ServerID, r.ServerName, ready, r.Warn, r.Running)
	}
}

// BackupOutcome is a change's notice, sent with the refreshed archive table.
templ BackupOutcome(message string, b BackupsView) {
	@Alert("success", message)
	@Partial("#backup-list", "outerHTML") {
		@BackupList(b)
	}
}

// BackupList is the archive table; it reloads after a deletion.
templ BackupList(b BackupsView) {
	<div id="backup-list" hx-get={ "/fragments/servers/" + b.ServerID + "/backups" } hx-trigger="backups-changed from:document" hx-swap="outerHTML">
		if usage := b.usage(); usage != "" {
			<p class="backup-usage" id="backup-usage">{ usage }</p>
		}
		if b.FolderIssue != "" {
			@Alert("warning", b.FolderIssue)
		}
		// Not in a scrolling wrapper, which would clip each row's menu.
		<div>
			<table class="data-table">
				<thead>
					<tr>
						<th>Created</th>
						<th>Size</th>
						<th>State</th>
						<th><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					if len(b.Backups) == 0 {
						<tr>
							<td colspan="4" class="muted">
								if b.HistoryError != "" {
									The backup list can’t be read right now.
								} else {
									No backups yet.
								}
							</td>
						</tr>
					}
					for _, backup := range b.Backups {
						@backupRow(b, backup)
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ backupRow(b BackupsView, backup backups.Backup) {
	{{ kept := backup.KeptAt != 0 }}
	{{ complete := backup.State == "complete" }}
	// A backup whose archive is gone can only be removed, and one whose only
	// intact copy is out of reach can't be read until its folder is back.
	{{ readable := complete && !backup.Missing && !backup.CopyAway }}
	<tr class={ templ.KV("backup-row--kept", kept) }>
		<td>
			@Time(backup.CreatedAt, "", "")
			<small class="table-detail">@Time(backup.CreatedAt, "sentence", "")</small>
			if note := SafetyNote(backup.Reason); note != "" {
				<small class="table-detail">{ note }</small>
			}
			if kept && backup.Note != "" {
				<small class="table-detail backup-note">{ backup.Note }</small>
			}
			if complete {
				{{ fit := b.Fits[backup.ID] }}
				if fit.Moved {
					<small class="table-detail backup-moved">Taken when the server’s data lived somewhere else</small>
				} else if fit.Refusal != "" {
					<small class="table-detail backup-unfit">Can’t be restored here. { fit.Refusal }</small>
				}
			}
		</td>
		<td>{ FormatBytes(backup.Size) }</td>
		<td>
			// Every listed backup is complete unless it is being removed, so
			// only a kept or departing one says so.
			switch {
				case !complete:
					@Pip("attention")
					Being removed
				case kept:
					@Pip("ok")
					Kept
			}
			if complete {
				@copyState(backup)
			} else if backup.FolderAway {
				<small class="table-detail backup-copy backup-copy--warning">Its backup folder can’t be reached</small>
			}
		</td>
		<td>
			<div class="inline-actions backup-row__actions">
				if readable && b.CanRestore && b.Fits[backup.ID].Refusal == "" {
					if !b.Blocked && !b.Active {
						<a class="secondary-btn" href={ detailURL(b.ServerID, "tab=backups&restore="+backup.ID) } { inPage()... }>Restore…</a>
					} else {
						<button class="secondary-btn" type="button" disabled>Restore…</button>
					}
				}
				<div class="action-menu" data-action-menu>
					<button type="button" class="secondary-btn action-menu__trigger action-menu__trigger--compact" aria-label={ "More actions for the backup from " + UTCText(backup.CreatedAt) } aria-expanded="false" aria-controls={ "backup-actions-" + backup.ID }>
						<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="3" cy="8" r="1.5"></circle><circle cx="8" cy="8" r="1.5"></circle><circle cx="13" cy="8" r="1.5"></circle></svg>
					</button>
					<div class="action-menu__content" id={ "backup-actions-" + backup.ID } hidden>
						if readable {
							<a class="action-menu__action" href={ detailURL(b.ServerID, "tab=backups&browse="+backup.ID) } { inPage()... }>Browse files</a>
							<a class="action-menu__action" href={ templ.SafeURL("/servers/" + b.ServerID + "/backups/" + backup.ID + "/download") } download>Download</a>
						}
						// Keeping protects an archive from being removed; one that is
						// missing, or whose server is gone, is never removed.
						if complete && (kept || (!backup.Missing && !b.Gone)) {
							if kept {
								<button
									class="action-menu__action"
									type="button"
									hx-post={ "/servers/" + b.ServerID + "/backups/" + backup.ID + "/release" }
									hx-target="#detail-status"
									data-busy-label="Releasing…"
								>Release</button>
							} else {
								<a class="action-menu__action" href={ detailURL(b.ServerID, "tab=backups&keep="+backup.ID) } { inPage()... }>Keep…</a>
							}
						}
						<button
							class="action-menu__action action-menu__action--danger"
							type="button"
							disabled?={ !b.CanDelete || b.Active || kept }
							if kept {
								title="Release this backup before deleting it"
							}
							hx-target="#detail-status"
							if backup.FolderAway {
								hx-post={ "/servers/" + b.ServerID + "/backups/" + backup.ID + "/delete?folderAway=1" }
								hx-confirm="Remove this backup from Ludock?"
								data-confirm-detail="Ludock can’t reach the folder this backup was saved in, so its archive may still be there. Ludock stops listing it and deletes its second copy."
								data-confirm-action="Remove backup"
							} else {
								// templ has no else-if among attributes.
								hx-post={ "/servers/" + b.ServerID + "/backups/" + backup.ID + "/delete" }
								hx-confirm="Delete this backup?"
								if backup.Missing {
									data-confirm-detail="Its archive is already missing or damaged in the backup folder. Deleting removes this entry from Ludock, along with whatever is left of the archive."
								} else {
									data-confirm-detail="The archive is deleted permanently."
								}
								data-confirm-action="Delete backup"
							}
							data-confirm-danger
							data-busy-label="Deleting…"
						>Delete</button>
					</div>
				</div>
			</div>
		</td>
	</tr>
}

// copyState says where a backup's second copy stands.
templ copyState(backup backups.Backup) {
	switch {
		case backup.FromCopy && backup.FolderAway:
			<small class="table-detail backup-copy backup-copy--warning">Its backup folder can’t be reached; using the second copy</small>
		case backup.FromCopy:
			<small class="table-detail backup-copy backup-copy--warning">Missing or damaged in the backup folder; using the second copy</small>
		case backup.FolderAway:
			<small class="table-detail backup-copy backup-copy--warning">Its backup folder can’t be reached</small>
		case backup.Missing:
			<small class="table-detail backup-copy backup-copy--warning">Its archive is missing or damaged in the backup folder, so it can’t be restored</small>
		case backup.CopyAway:
			<small class="table-detail backup-copy backup-copy--warning">Missing or damaged in the backup folder, and the second folder can’t be reached</small>
		case backup.CopyState == "complete":
			<small class="table-detail backup-copy">Second copy saved</small>
		case backup.Copying:
			<small class="table-detail backup-copy">Making the second copy…</small>
		case backup.CopyError != "":
			<small class="table-detail backup-copy backup-copy--warning">Second copy failed. { backup.CopyError }</small>
		case backup.CopyState != "":
			<small class="table-detail backup-copy">Second copy waiting</small>
	}
}

// KeepForm marks a backup kept, with an optional note.
templ KeepForm(b BackupsView) {
	<form class="keep-panel stack-form" id="keep-backup" hx-post={ "/servers/" + b.ServerID + "/backups/" + b.Keep.ID + "/keep" } hx-target="#keep-status">
		<h3>Keep the backup from @Time(b.Keep.CreatedAt, "", "")</h3>
		<p>Ludock never removes a kept backup, even when space runs short. It still uses disk space until you release or delete it.</p>
		<label>
			<span>Note <small class="muted">(optional)</small></span>
			<input name="note" maxlength="100" autocomplete="off" placeholder="Before the big update"/>
		</label>
		<div id="keep-status" aria-live="polite"></div>
		<div class="inline-actions">
			<button class="primary-btn" type="submit" data-busy-label="Keeping…">Keep backup</button>
			<a class="secondary-btn" href={ detailURL(b.ServerID, "tab=backups") } { inPage()... }>Cancel</a>
		</div>
	</form>
}

templ RestoreForm(b BackupsView) {
	{{ moved := b.Fits[b.Restore.ID].Moved }}
	<form class="danger-panel stack-form" hx-post={ "/servers/" + b.ServerID + "/restores" } hx-target="#restore-status">
		<h3>Restore backup from @Time(b.Restore.CreatedAt, "", "")</h3>
		if moved {
			<p class="restore-moved"><strong>This backup was taken when the server’s data lived somewhere else.</strong> Restoring it replaces the game data in { rootList(b.Restore.Roots) } where the server keeps it now.</p>
			<input type="hidden" name="dataMoved" value="true"/>
			<input type="hidden" name="bindingRevision" value={ strconv.FormatInt(b.BindingRevision, 10) }/>
		}
		<p>This replaces the server’s current game data. Ludock stops the server and takes a safety backup first; if that fails, nothing is replaced.</p>
		if len(b.SetAside) > 0 {
			<p class="restore-set-aside">The data folder holds copies Ludock set aside earlier: { nameList(b.SetAside) }. They are replaced with everything else, and stay in the safety backup taken before the restore.</p>
			for _, name := range b.SetAside {
				<input type="hidden" name="setAside" value={ name }/>
			}
		}
		if note := DisconnectNote(b.Running); note != "" {
			<p>{ note }</p>
		}
		if b.Restore.FromCopy {
			@Alert("warning", "This backup is missing or damaged in the backup folder, so Ludock restores it from the second copy.")
		}
		<details class="disclosure">
			<summary>More about restoring</summary>
			<p>Ludock checks the backup before replacing anything. The server returns to its previous running state only after the data is safe. Restoring game data doesn’t undo an update or change the server’s settings.</p>
		</details>
		<input type="hidden" name="backupId" value={ b.Restore.ID }/>
		if b.Warn {
			{{ option := WarnOption }}
			<label class="check-label">
				<input type="checkbox" name={ option.Name } value="true" checked?={ option.Checked }/>
				{ option.Label }
			</label>
			<p class="muted check-help">{ option.Help }</p>
		}
		<label>
			<span>Type <strong>{ b.ServerName }</strong> to confirm</span>
			<input name="confirmation" autocomplete="off" required data-confirm-value={ b.ServerName }/>
		</label>
		<div id="restore-status" aria-live="polite"></div>
		<div class="inline-actions">
			<button class="secondary-btn secondary-btn--danger" type="submit" data-busy-label="Working…">Restore game data</button>
			<a class="secondary-btn" href={ detailURL(b.ServerID, "tab=backups") } { inPage()... }>Cancel</a>
		</div>
	</form>
}

// BackupBrowser is one folder of a backup, for administrators.
type BackupBrowser struct {
	ServerID, ServerName string
	Backup               backups.Backup
	Roots                []backups.Root
	Root                 backups.Root
	Path                 string
	// Entries holds the first Limit of the folder's Total items.
	Entries      []backups.ArchiveEntry
	Total, Limit int
	Error        string
	CanRestore   bool
	// Fit is whether the backup restores onto the server as it is now, at
	// BindingRevision.
	Fit             backups.Fit
	BindingRevision int64
	Warn            bool
	Running          bool
}

// nameList names things in a sentence.
func nameList(names []string) string {
	if len(names) < 2 {
		return strings.Join(names, "")
	}
	return strings.Join(names[:len(names)-1], ", ") + " and " + names[len(names)-1]
}

// IsSetAside reports a folder name that undoing a restore gives what it set
// aside.
func IsSetAside(name string) bool {
	id, ok := strings.CutPrefix(name, helper.SetAsidePrefix)
	return ok && helper.ValidID(id)
}

// SetAsideReplaced says where a whole restore that succeeded put the
// folders earlier undos had set aside, as its confirmation named them.
func SetAsideReplaced(operation *ops.Job) string {
	if operation.Kind != ops.KindRestore || operation.Status != ops.Succeeded || operation.Result.SafetyBackupID == "" || operation.Result.RestoredItem != "" {
		return ""
	}
	listed, _ := operation.Input["setAside"].([]any)
	var names []string
	for _, value := range listed {
		if name, ok := value.(string); ok && IsSetAside(name) {
			names = append(names, name)
		}
	}
	if len(names) == 0 {
		return ""
	}
	return "The copies Ludock had set aside earlier, " + nameList(names) + ", were replaced with everything else. They are in the backup taken before this restore."
}

// rootList names data folders in a sentence.
func rootList(roots []backups.Root) string {
	paths := make([]string, len(roots))
	for index, root := range roots {
		paths[index] = root.Path
	}
	if len(paths) < 2 {
		return strings.Join(paths, "")
	}
	return strings.Join(paths[:len(paths)-1], ", ") + " and " + paths[len(paths)-1]
}

func (b BackupBrowser) values(path string) url.Values {
	values := url.Values{"browse": {b.Backup.ID}, "root": {b.Root.ID}}
	if path != "" {
		values.Set("path", path)
	}
	return values
}

func (b BackupBrowser) folderURL(path string) templ.SafeURL {
	return detailURL(b.ServerID, "tab=backups&"+b.values(path).Encode())
}

func (b BackupBrowser) rootURL(root backups.Root) templ.SafeURL {
	b.Root = root
	return b.folderURL("")
}

func (b BackupBrowser) moreURL() string {
	values := b.values(b.Path)
	values.Set("limit", strconv.Itoa(b.Limit+FilePage))
	return "/fragments/servers/" + b.ServerID + "/backups/" + b.Backup.ID + "/folder?" + values.Encode()
}

func (b BackupBrowser) child(name string) string {
	if b.Path == "" {
		return name
	}
	return b.Path + "/" + name
}

func (b BackupBrowser) fileURL(name string) templ.SafeURL {
	values := url.Values{"root": {b.Root.ID}, "path": {b.child(name)}}
	return templ.SafeURL("/servers/" + b.ServerID + "/backups/" + b.Backup.ID + "/file?" + values.Encode())
}

func (b BackupBrowser) crumbs() [][2]string {
	return FilesView{Path: b.Path}.breadcrumbs()
}

// livePath is where an item of this folder lives in the server's data.
func (b BackupBrowser) livePath(name string) string {
	return strings.TrimSuffix(b.Root.Path, "/") + "/" + b.child(name)
}

func ItemCount(count int) string {
	if count == 1 {
		return "1 item"
	}
	return intText(count) + " items"
}

templ BackupBrowserView(b BackupBrowser) {
	<section class="file-manager backup-browser" aria-labelledby="backup-browser-title">
		<div class="section-heading">
			<h2 id="backup-browser-title">
				if b.Backup.ID != "" {
					Backup from @Time(b.Backup.CreatedAt, "", "")
				} else {
					Backup
				}
			</h2>
			<a class="secondary-btn" href={ detailURL(b.ServerID, "tab=backups") } { inPage()... }>All backups</a>
		</div>
		if b.CanRestore {
			<p class="section-lede">Download a file, or put one file or folder back the way it was in this backup.</p>
		} else {
			<p class="section-lede">Download a file from this backup.</p>
		}
		if b.Backup.FromCopy {
			@Alert("warning", "This backup is missing or damaged in the backup folder, so Ludock is reading the second copy.")
		}
		if b.Fit.Moved {
			@Alert("info", "This backup was taken when the server’s data lived somewhere else. Restoring from it puts files where the server keeps its data now.")
		} else if b.Fit.Refusal != "" {
			@Alert("info", "This backup can’t be restored onto the server as it is now. "+b.Fit.Refusal+" You can still download its files.")
		}
		if b.Error != "" {
			<p class="alert alert--error" role="alert">Unable to open this backup: { b.Error }</p>
		} else {
			if len(b.Roots) > 1 {
				<nav class="inline-actions" aria-label="Data folders">
					for _, root := range b.Roots {
						<a
							class="secondary-btn"
							href={ b.rootURL(root) }
							if root.ID == b.Root.ID {
								aria-current="page"
							}
							{ inPage()... }
						>{ root.Path }</a>
					}
				</nav>
			}
			<div class="file-toolbar">
				<nav class="file-breadcrumbs" aria-label="Current folder">
					<a
						href={ b.folderURL("") }
						if b.Path == "" {
							aria-current="page"
						}
						{ inPage()... }
					>{ b.Root.Path }</a>
					for index, crumb := range b.crumbs() {
						<span>
							<b aria-hidden="true">/</b>
							<a
								href={ b.folderURL(crumb[1]) }
								if index == len(b.crumbs())-1 {
									aria-current="page"
								}
								{ inPage()... }
							>{ crumb[0] }</a>
						</span>
					}
				</nav>
			</div>
			@BackupFolder(b)
		}
	</section>
}

// BackupFolder is a backup folder's items; Show more replaces it.
templ BackupFolder(b BackupBrowser) {
	<div id="backup-folder">
		if b.Error != "" {
			<p class="alert alert--error" role="alert">Unable to open this backup: { b.Error }</p>
		} else {
			<div class="file-filter-summary">
				<p>Folders first</p>
				<p role="status">Showing { intText(len(b.Entries)) } of { intText(b.Total) } items</p>
			</div>
			<div class="file-list">
				<div class="file-list__header">
					<span>Name</span>
					<span>Size</span>
					<span>Modified</span>
					<span>Actions</span>
				</div>
				if b.Total == 0 {
					<p class="file-list__empty">This folder is empty.</p>
				}
				for index, entry := range b.Entries {
					<div class="file-row">
						<div class="file-row__name">
							@fileIcon(entry.Type)
							if entry.Type == "directory" {
								<a href={ b.folderURL(b.child(entry.Name)) } { inPage()... }>{ entry.Name }</a>
								<small>{ ItemCount(entry.Items) }</small>
							} else {
								<span>{ entry.Name }</span>
							}
						</div>
						<span>{ FormatBytes(entry.Size) }</span>
						<span>
							if entry.ModifiedAt > 0 {
								@Time(int64(entry.ModifiedAt*1000), "", "")
							} else {
								—
							}
						</span>
						<div class="file-row__actions">
							if entry.Type == "file" || b.CanRestore {
								<div class="action-menu" data-action-menu>
									<button type="button" class="secondary-btn action-menu__trigger action-menu__trigger--compact" aria-label={ "Actions for " + entry.Name } aria-expanded="false" aria-controls={ "backup-item-" + intText(index) }>
										<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="3" cy="8" r="1.5"></circle><circle cx="8" cy="8" r="1.5"></circle><circle cx="13" cy="8" r="1.5"></circle></svg>
									</button>
									<div class="action-menu__content" id={ "backup-item-" + intText(index) } hidden>
										if entry.Type == "file" {
											<a class="action-menu__action" href={ b.fileURL(entry.Name) } download>Download</a>
										}
										if b.CanRestore {
											@restoreItem(b, entry)
										}
									</div>
								</div>
							}
						</div>
					</div>
				}
				if remaining := b.Total - len(b.Entries); remaining > 0 {
					<div class="file-list__more">
						<button class="secondary-btn" type="button" hx-get={ b.moreURL() } hx-target="#backup-folder" hx-swap="outerMorph" hx-sync="#backup-folder:queue last" data-busy-label="Loading…">Show { intText(min(remaining, FilePage)) } more</button>
					</div>
				}
			</div>
		}
	</div>
}

// restoreItemDetail says what restoring one item replaces.
func (b BackupBrowser) restoreItemDetail(item backups.ArchiveEntry) string {
	detail := "The backup’s copy (" + FormatBytes(item.Size)
	if b.Fit.Moved {
		detail = "This backup was taken when the server’s data lived somewhere else. Its copy (" + FormatBytes(item.Size)
	}
	if item.Type == "directory" {
		detail += " in " + ItemCount(item.Items)
	}
	detail += ") replaces " + b.livePath(item.Name) + ", or brings it back if it was deleted."
	if item.Type == "directory" {
		detail += " Everything now inside that folder is replaced."
	}
	detail += " The server stops while the copies swap, then goes back to how it was. If anything fails, the current copy is put back."
	if note := DisconnectNote(b.Running); note != "" {
		detail += " " + note
	}
	return detail
}

func (b BackupBrowser) restoreItemOptions() []ConfirmOption {
	options := []ConfirmOption{{Name: "createBackup", Label: "Back up first", Checked: true,
		Help: "Saves the server’s data as it is now, so this restore can be undone."}}
	if b.Warn {
		options = append([]ConfirmOption{WarnOption}, options...)
	}
	return options
}

// restoreItem restores one file or folder after the confirmation dialog,
// which offers a backup of the current data first.
templ restoreItem(b BackupBrowser, item backups.ArchiveEntry) {
	{{ kind := map[bool]string{true: "folder", false: "file"}[item.Type == "directory"] }}
	<form
		hx-post={ "/servers/" + b.ServerID + "/restores" }
		hx-target="#detail-status"
		hx-confirm={ "Restore the " + kind + " “" + item.Name + "”?" }
		data-confirm-detail={ b.restoreItemDetail(item) }
		data-confirm-action={ "Restore " + kind }
		data-confirm-danger
		data-confirm-options={ confirmOptions(b.restoreItemOptions()) }
	>
		<input type="hidden" name="backupId" value={ b.Backup.ID }/>
		<input type="hidden" name="root" value={ b.Root.ID }/>
		<input type="hidden" name="item" value={ b.child(item.Name) }/>
		if b.Fit.Moved {
			<input type="hidden" name="dataMoved" value="true"/>
			<input type="hidden" name="bindingRevision" value={ strconv.FormatInt(b.BindingRevision, 10) }/>
		}
		<button class="action-menu__action action-menu__action--danger" type="submit">Restore…</button>
	</form>
}

type UpdateView struct {
	ServerID, ServerName string
	CanBackup            bool
	// NoData: the server has no data folders, so no backup can come first.
	NoData bool
	Blocked, Active      bool
	// Gone: the server's container is missing, so there is nothing to update;
	// Removed: an administrator removed it from Ludock.
	Gone, Removed        bool
	Recreate             bool
	Capability           *update.Capability
	Error                string
	// Check is the newest-image check, nil before it applies; ChecksOff
	// means an administrator turned the checks off.
	Check     *update.CheckStatus
	ChecksOff bool
	// Warn offers to warn players first.
	Warn bool
	// Running: the server is up, so taking it down disconnects whoever is on.
	Running bool
	// DeletedOnStop: Docker deletes the server when it stops, so it can't
	// be updated; the page header says why.
	DeletedOnStop bool
}

templ UpdateTab(serverID string, recreate bool) {
	<div id="update-panel" hx-get={ "/fragments/servers/" + serverID + "/update" + map[bool]string{true: "?recreate=1"}[recreate] } hx-trigger="load" hx-swap="outerHTML">
		<p role="status">Checking update options…</p>
	</div>
}

// UpdatePanel reloads, like the Backups tab, when work ends or an earlier
// restore's undo is blocked or unblocked.
templ UpdatePanel(u UpdateView) {
	<div id="update-panel" hx-get={ "/fragments/servers/" + u.ServerID + "/update" + map[bool]string{true: "?recreate=1"}[u.Recreate] } hx-trigger="operation-finished from:document" hx-swap="outerHTML">
		if u.Removed {
			<p role="status">This server was removed from Ludock, so it can’t be updated.</p>
		} else if u.Gone {
			<p role="status">Ludock can’t find this server in Docker, so it can’t be updated.</p>
		} else if u.Capability == nil {
			<div>
				<p role="alert">Couldn’t check whether this server can be updated. Try again.</p>
				@reloadUpdate(u.ServerID, "Check again")
			</div>
		} else {
			{{ capability := u.Capability }}
			<h2>{ capability.ActionLabel }</h2>
			if capability.UpdatesOnStart {
				<div class="startup-update-note">
					<h3>Game updates</h3>
					<p class="section-lede">This image downloads the latest game version when it starts, so Restart updates the game.</p>
					<p class="muted">
						Version pins in the image’s settings still apply.
						if u.CanBackup {
							To back up first, tick Back up first in the Restart dialog.
						}
					</p>
				</div>
			}
			<h3>Update the server’s image</h3>
			if u.DeletedOnStop {
				<p class="section-note">Ludock can’t update this server.</p>
			} else if !capability.Available {
				<p class="section-note">{ capability.UnavailableReason }</p>
				<div class="inline-actions">
					@reloadUpdate(u.ServerID, "Check again")
				</div>
			} else {
				@ImageCheck(u)
				@UpdateForm(u)
			}
		}
	</div>
}

// ImageCheck is what the background check last learned about a newer image.
templ ImageCheck(u UpdateView) {
	<div class="image-check" id="image-check">
		if u.ChecksOff {
			<p class="muted">Checks for newer images are off. Turn them on in <a class="text-link" href="/settings#image-update-settings-title">Settings</a>.</p>
		} else {
			{{ check := u.Check }}
			if check != nil && check.State == update.CheckAvailable {
				<div class="alert alert--info image-check__available" role="status">
					<div>
						<p><strong>A newer image is available.</strong> Update the server below to use it.</p>
						if u.Capability.UpdatesOnStart {
							<p>This is the container image itself, such as its startup scripts and system packages. The game already updates on every restart.</p>
						}
					</div>
				</div>
			}
			<p class="muted image-check__status">
				switch {
					case check != nil && check.State == update.CheckPending && check.CheckedAt != 0:
						Ludock is waiting for a fresh answer from the registry.
					case check == nil || check.State == update.CheckPending:
						Ludock hasn’t checked the registry for a newer image yet.
					case check.State == update.CheckCurrent:
						This server runs the newest image its tag points to.
					case check.State == update.CheckUnknown:
						Ludock can’t tell which registry version this server’s image came from, so it can’t compare it with the registry.
					case check.State == update.CheckPlatform:
						The newest image for this tag doesn’t offer this server’s platform, so updating wouldn’t change it.
				}
			</p>
			if check != nil && check.CheckedAt != 0 {
				<p class="muted image-check__checked">Last checked @Time(check.CheckedAt, "plain", "")</p>
			}
			if check != nil && check.Failed {
				<p class="muted image-check__failed">
					if check.ConfigProblem {
						Ludock could not read registry credentials from LUDOCK_DOCKER_CONFIG for the last check.
					} else {
						The last check couldn’t reach the registry, or the registry refused it.
					}
					Ludock will try again later. Last tried @Time(check.TriedAt, "plain", "")
				</p>
			}
			<div class="inline-actions">
				<button class="secondary-btn" type="button" hx-post={ "/servers/" + u.ServerID + "/update-check" } hx-target="#image-check" hx-swap="outerHTML" data-busy-label="Checking…">Check now</button>
			</div>
		}
	</div>
}

templ reloadUpdate(serverID, label string) {
	<button class="secondary-btn" type="button" hx-get={ "/fragments/servers/" + serverID + "/update" } hx-target="#update-panel" hx-swap="outerHTML" data-busy-label="Checking…">{ label }</button>
}

func updateDetail(running bool) string {
	if note := DisconnectNote(running); note != "" {
		return note + " Ludock replaces the server with the newest image."
	}
	return "Ludock replaces the server with the newest image."
}

templ UpdateForm(u UpdateView) {
	{{ capability := u.Capability }}
	<form
		class="stack-form"
		hx-post={ "/servers/" + u.ServerID + "/updates" }
		hx-target="#update-status"
		hx-confirm={ "Update " + u.ServerName + "?" }
		data-confirm-detail={ updateDetail(u.Running) }
		data-confirm-action={ capability.ActionLabel }
		data-confirm-danger
	>
		<p class="section-lede">
			Download the newest version of this server’s image, including its system packages and startup scripts, and replace the server with it. Its settings and mounted data stay.
		</p>
		<dl class="metadata-list">
			<dt>Image</dt>
			<dd>{ capability.Image }</dd>
		</dl>
		<details class="disclosure">
			<summary>What gets replaced</summary>
			<p>The new server keeps the old one’s settings, ports, networks, mounted folders, and volumes, including unnamed ones. Files changed inside it outside those are lost. Other containers aren’t touched, and the tool that created this one still owns its settings.</p>
			<p>If the new server stops or reports itself unhealthy right after starting, Ludock puts the previous one back and leaves it stopped, since the new version may already have changed the game data.</p>
		</details>
		<label class="check-label">
			<input type="checkbox" name="createBackup" value="true" id="update-backup" checked?={ u.CanBackup } disabled?={ !u.CanBackup }/>
			Back up first
		</label>
		if u.NoData {
			<p class="muted check-help">This server has no data folders Ludock can reach, so there is nothing to back up first.</p>
		} else {
			<p class="muted check-help">The server stays stopped during the backup. If it was stopped before, it stays stopped after.</p>
		}
		if u.Warn {
			{{ option := WarnOption }}
			<label class="check-label">
				<input type="checkbox" name={ option.Name } value="true" checked?={ option.Checked }/>
				{ option.Label }
			</label>
			<p class="muted check-help">{ option.Help }</p>
		}
		<label data-hidden-by="update-backup" hidden?={ u.CanBackup }>
			if u.NoData {
				<span>Type <strong>{ u.ServerName }</strong> to update without a backup</span>
			} else {
				<span>Type <strong>{ u.ServerName }</strong> to skip the backup</span>
			}
			<input name="skipBackupConfirmation" autocomplete="off"/>
		</label>
		<details class="disclosure" open?={ u.Recreate }>
			<summary>Advanced</summary>
			<div class="stack-form">
				<label class="check-label">
					<input type="checkbox" name="forceRecreate" value="true" id="update-recreate" checked?={ u.Recreate }/>
					Update even if the image is already up to date
				</label>
				<p class="muted check-help">Picks up a game update that installs on startup.</p>
			</div>
		</details>
		<div id="update-status" aria-live="polite"></div>
		<button class="primary-btn" type="submit" disabled?={ u.Blocked || u.Active } data-busy-label="Working…">{ capability.ActionLabel }</button>
	</form>
}
