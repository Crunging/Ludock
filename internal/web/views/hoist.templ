package views

import "strconv"

// SignalHoist spells LUDOCK in international maritime signal flags, hung
// from a dressing line: the sign-in page's one decorative moment.
templ SignalHoist() {
	<svg class="hoist" viewBox="0 0 360 64" aria-hidden="true" focusable="false">
		<path class="hoist__line" d="M0 9 Q180 15 360 9"></path>
		for index, flag := range hoistFlags {
			{{ x := 10 + index*58 }}
			<g transform={ "translate(" + strconv.Itoa(x) + " 12)" }>
				<line class="hoist__toggle" x1="2" y1="-3" x2="2" y2="0"></line>
				<line class="hoist__toggle" x1="46" y1="-3" x2="46" y2="0"></line>
				<g class={ "hoist__flag", "hoist__flag--" + strconv.Itoa(index+1) }>
					@flag()
					<rect class="hoist__edge" x="0" y="0" width="48" height="34"></rect>
				</g>
			</g>
		}
	</svg>
}

var hoistFlags = []func() templ.Component{flagL, flagU, flagD, flagO, flagC, flagK}

// L: yellow and black quarters.
templ flagL() {
	<rect class="sf-yellow" width="24" height="17"></rect>
	<rect class="sf-black" x="24" width="24" height="17"></rect>
	<rect class="sf-black" y="17" width="24" height="17"></rect>
	<rect class="sf-yellow" x="24" y="17" width="24" height="17"></rect>
}

// U: red and white quarters.
templ flagU() {
	<rect class="sf-red" width="24" height="17"></rect>
	<rect class="sf-white" x="24" width="24" height="17"></rect>
	<rect class="sf-white" y="17" width="24" height="17"></rect>
	<rect class="sf-red" x="24" y="17" width="24" height="17"></rect>
}

// D: yellow, blue, yellow bands; the blue band is twice as wide.
templ flagD() {
	<rect class="sf-yellow" width="48" height="34"></rect>
	<rect class="sf-blue" y="8.5" width="48" height="17"></rect>
}

// O: red over yellow, divided diagonally.
templ flagO() {
	<rect class="sf-yellow" width="48" height="34"></rect>
	<path class="sf-red" d="M0 0H48V34Z"></path>
}

// C: blue, white, red, white, blue stripes.
templ flagC() {
	<rect class="sf-blue" width="48" height="34"></rect>
	<rect class="sf-white" y="6.8" width="48" height="20.4"></rect>
	<rect class="sf-red" y="13.6" width="48" height="6.8"></rect>
}

// K: yellow hoist, blue fly.
templ flagK() {
	<rect class="sf-yellow" width="24" height="34"></rect>
	<rect class="sf-blue" x="24" width="24" height="34"></rect>
}
