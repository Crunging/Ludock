package views

templ Alert(kind, message string) {
	<div class={ "alert", "alert--" + kind } role={ map[bool]string{true: "alert", false: "status"}[kind == "error"] }>{ message }</div>
}

// Partial sends its children to another part of the page along with a
// response: target is a selector and swap an hx-swap value.
templ Partial(target, swap string) {
	<hx-partial hx-target={ target } hx-swap={ swap }>
		{ children... }
	</hx-partial>
}

templ ErrorPage(page Page, title, message string) {
	@Shell(page) {
		<div class="page">
			<div class="page__header">
				<h1 class="page__title">{ title }</h1>
			</div>
			@Alert("error", message)
			<p><a href="/">Back to servers</a></p>
		</div>
	}
}
