package views

templ Alert(kind, message string) {
	<div class={ "alert", "alert--" + kind } role={ map[bool]string{true: "alert", false: "status"}[kind == "error"] }>{ message }</div>
}

templ ErrorPage(page Page, title, message string) {
	@Shell(page) {
		<div class="page">
			<div class="page__header">
				<h1 class="page__title">{ title }</h1>
			</div>
			@Alert("error", message)
			<p><a href="/">Back to servers</a></p>
		</div>
	}
}
