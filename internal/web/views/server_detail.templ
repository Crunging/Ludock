package views

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/Crunging/Ludock/internal/history"
	"github.com/Crunging/Ludock/internal/monitor"
	"github.com/Crunging/Ludock/internal/ops"
	"github.com/Crunging/Ludock/internal/resources"
	"github.com/Crunging/Ludock/internal/schedules"
	"github.com/Crunging/Ludock/internal/servers"
)

type DetailTab struct{ ID, Label string }

type ServerDetail struct {
	Row                  ServerRow
	Stats                *servers.Stats
	DiscoveryUnavailable bool
	Admin                bool
	Tab                  string
	Tabs                 []DetailTab
	Availability         *monitor.Availability
	// Resources is the resource history; overview refreshes leave it nil
	// and keep the one on the page.
	Resources *resources.History
	// ShowSchedule shows the next run; SchedulesReady is false when the list
	// could not be read.
	ShowSchedule   bool
	SchedulesReady bool
	NextSchedule   *schedules.Schedule
	Now            int64
	Activity       ActivityView
	Backups        BackupsView
	Schedules      SchedulesView
	// Recreate preselects "Recreate anyway" in the update tab.
	Recreate bool
	// Operation is the operation the page shows, if any.
	Operation string
}

type ActivityView struct {
	ServerID      string
	Total         int
	Visible       []history.Operation
	Kinds         []string
	Status, Kind  string
	Error         string
	Admin         bool
	HiddenActive  bool
	Active        bool
	SelectedID    string
	Selected      *ops.Job
	SelectedError string
	// AlreadyCurrent offers recreation after an update found nothing new.
	AlreadyCurrent bool
	// Tab is the tab showing the selected operation.
	Tab string
	// Archives offers the download of a backup the operation made.
	Archives bool
}

func detailURL(id, query string) templ.SafeURL {
	if query == "" {
		return templ.SafeURL("/servers/" + id)
	}
	return templ.SafeURL("/servers/" + id + "?" + query)
}

// inPage moves between views of a server inside the page: the address bar
// changes, but the page and its live connection stay. Boosting keeps the
// link's own address and lets modified clicks open a new tab.
func inPage() templ.Attributes {
	return templ.Attributes{"hx-boost": "true", "hx-target": "#detail-body", "hx-select": "#detail-body",
		"hx-swap": "outerHTML show:none"}
}

func liveTrigger(id string, active bool) string {
	every := "every 10s"
	if active {
		every = "every 2s"
	}
	return "sse:server-" + id + ", sse:refresh, servers-changed from:body, " + every
}

// activeID is the server's running operation, if any. The live header
// sends it back, so its next refresh can tell when that work has ended.
func activeID(server servers.View) string {
	if server.ActiveOperation == nil {
		return ""
	}
	return server.ActiveOperation.ID
}

func headerClass(d ServerDetail) string {
	class := "detail-header"
	if LifecycleAction(d.Row.Server.State) == "start" {
		class += " detail-header--stopped"
	}
	if ServerStatus(d.Row.Server.State, d.Row.Server.Health, d.Row.Server.Exit).Tone == "failed" {
		class += " detail-header--failed"
	}
	return class
}

templ ServerDetailPage(page Page, d ServerDetail) {
	@Shell(page) {
		<div class="page server-detail" sse-connect="/events">
			<a class="text-link back-link" href="/"><span aria-hidden="true">←</span> All servers</a>
			// In-page links replace only this part, so the event stream stays open.
			<div id="detail-body">
				@detailBody(d)
			</div>
		</div>
	}
}

templ detailBody(d ServerDetail) {
	{{ server := d.Row.Server }}
	@DetailLive(d)
	if d.Admin && server.BindingStatus == "review_required" {
		@BindingReview(server.ID, server.DisplayName, server.BindingRevision)
	}
	<div id="detail-status" aria-live="polite"></div>
	<nav class="section-tabs" aria-label="Server management">
		for _, tab := range d.Tabs {
			<a href={ detailURL(server.ID, "tab="+tab.ID) } { inPage()... } id={ "tab-" + tab.ID } role="tab" aria-selected={ strconv.FormatBool(tab.ID == d.Tab) } aria-current={ map[bool]string{true: "page"}[tab.ID == d.Tab] }>{ tab.Label }</a>
		}
	</nav>
	<section class="section-tab-panel" aria-label={ tabLabel(d) }>
		switch d.Tab {
			case "activity":
				@ActivityPanel(d.Activity)
			case "backups":
				@BackupsTab(d.Backups)
			case "schedules":
				@SchedulesTab(d.Schedules)
			case "update":
				@UpdateTab(server.ID, d.Recreate)
			default:
				@OverviewLive(d)
				if d.Admin && d.Availability != nil {
					@AvailabilityForm(server.ID, d.Availability.Policy)
				} else if d.Availability != nil {
					<p class="muted">Ask an administrator to investigate availability problems or change monitoring settings.</p>
				}
		}
	</section>
}

func tabLabel(d ServerDetail) string {
	for _, tab := range d.Tabs {
		if tab.ID == d.Tab {
			return tab.Label
		}
	}
	return "Overview"
}

// DetailLive is the header and server-wide notices; it reloads itself.
templ DetailLive(d ServerDetail) {
	{{ server := d.Row.Server }}
	<div id="detail-live" hx-get={ "/fragments/servers/" + server.ID + "/live?" + url.Values{"tab": {d.Tab}, "operation": {d.Operation}, "active": {activeID(server)}}.Encode() } hx-trigger={ liveTrigger(server.ID, server.ActiveOperation != nil) } hx-swap="outerHTML" hx-disinherit="*">
		<header class={ headerClass(d) }>
			@StateMark(ServerStatus(server.State, server.Health, server.Exit).Tone)
			<div class="detail-header__title">
				<h1 class="page__title" id="server-detail-title" tabindex="-1">{ server.DisplayName }</h1>
				<p class="detail-header__identity">
					@ServerState(server.State, server.Health, server.Exit)
					<span class="detail-header__game">{ server.GameName }</span>
					if server.Name != server.DisplayName {
						<span title="Docker container name"><code>{ server.Name }</code></span>
					}
				</p>
			</div>
			if d.Row.ConsoleLabel != "" || d.Row.CanFiles || d.Row.CanStart || d.Row.CanStop || d.Row.CanRestart {
				<div class="inline-actions detail-actions">
					if d.Row.ConsoleLabel != "" || d.Row.CanFiles {
						<div class="detail-actions__group">
							if d.Row.ConsoleLabel != "" {
								<a class="primary-btn" href={ templ.SafeURL("/console/" + server.ID) }>{ d.Row.ConsoleLabel }</a>
							}
							if d.Row.CanFiles {
								<a class="secondary-btn" href={ templ.SafeURL("/files/" + server.ID) }>Files</a>
							}
						</div>
					}
					if d.Row.CanStart || d.Row.CanStop || d.Row.CanRestart {
						<div class="detail-actions__group">
							if d.Row.CanStart {
								<button type="button" class="secondary-btn" disabled?={ d.Row.Disabled } hx-post={ "/servers/" + server.ID + "/start" } hx-target="#detail-status" data-busy-label="Working…">Start</button>
							}
							if d.Row.CanStop {
								<button type="button" class="secondary-btn secondary-btn--danger" disabled?={ d.Row.Disabled } hx-post={ "/servers/" + server.ID + "/stop" } hx-target="#detail-status" data-busy-label="Working…" { LifecycleConfirm("stop", server.DisplayName, false)... }>Stop</button>
							}
							if d.Row.CanRestart {
								<button type="button" class="secondary-btn" disabled?={ d.Row.Disabled } hx-post={ "/servers/" + server.ID + "/restart" } hx-target="#detail-status" data-busy-label="Working…" { LifecycleConfirm("restart", server.DisplayName, d.Row.CanBackup)... }>Restart</button>
							}
						</div>
					}
				</div>
			}
		</header>
		if d.DiscoveryUnavailable {
			<div class="alert alert--error" role="alert">
				Live server status could not be verified. Saved history and monitoring remain accessible; server controls are paused until live status can be verified.
				if d.Admin {
					<a class="text-link" href="/diagnostics">Check Docker connectivity</a>
				}
			</div>
		}
		if server.BindingStatus == "active" {
			if guidance := StateGuidance(server.State); guidance != "" {
				<p class="section-note" role="status">{ guidance }</p>
			}
		} else {
			<div class="alert alert--error" role="alert">
				This server’s binding is { Capitalize(string(server.BindingStatus)) }. Operations are blocked until an administrator reviews the identity.
			</div>
		}
		// The notice points to progress the page doesn't already show.
		if operation := server.ActiveOperation; operation != nil && d.Tab != "activity" && operation.ID != d.Operation {
			<div class="detail-operation-notice">
				<p role="status">
					<strong>{ Capitalize(operation.Kind) }</strong>: { OperationLabel(operation.Status, operation.Phase) }. Server controls, backups, and updates are paused until it finishes.
				</p>
				<a class="text-link" href={ templ.SafeURL(OperationPath(server.ID, operation.Kind, operation.ID)) } { inPage()... }>View progress</a>
			</div>
		}
	</div>
}

templ BindingReview(serverID, serverName string, revision int64) {
	<form class="danger-panel stack-form" hx-post={ "/servers/" + serverID + "/binding-review" } hx-target="#binding-review-status">
		<h3>Review changed server identity</h3>
		<p>
			Verify that this is the same intended server and game data. Accepting the new binding re-enables existing user grants. Schedules for changed game data stay suspended; review and recreate them separately. Old backups remain subject to compatibility checks.
		</p>
		<input type="hidden" name="bindingRevision" value={ strconv.FormatInt(revision, 10) }/>
		<label>
			<span>Type <strong>{ serverName }</strong> to accept the changed binding</span>
			<input name="confirmation" autocomplete="off" required data-confirm-value={ serverName }/>
		</label>
		<div id="binding-review-status" aria-live="polite"></div>
		<button class="secondary-btn secondary-btn--danger" type="submit" data-busy-label="Working…">Accept binding</button>
	</form>
}

var healthNotes = map[string]string{"starting": "Health check is starting", "healthy": "Health check passing", "unhealthy": "Health check failing"}

func resourcesUnavailable(d ServerDetail) string {
	if d.DiscoveryUnavailable {
		return "Unavailable until Docker can be reached"
	}
	if d.Row.Server.State == "running" {
		return "Not available right now"
	}
	return "Shown while the server is running"
}

const mib = 1024 * 1024

func memoryShare(stats *servers.Stats) string {
	share := min(100, stats.MemUsageMB/stats.MemLimitMB*100)
	return fmt.Sprintf("width: %.1f%%", share)
}

// OverviewLive is the overview facts and monitoring status; it reloads itself.
templ OverviewLive(d ServerDetail) {
	{{ server := d.Row.Server }}
	<div id="overview-live" hx-get={ "/fragments/servers/" + server.ID + "/overview" } hx-trigger={ liveTrigger(server.ID, false) + ", availability-changed from:body" } hx-swap="outerHTML" hx-disinherit="*">
		<h2 class="sr-only">Overview</h2>
		<dl class="overview-facts">
			<div>
				<dt>State</dt>
				<dd>
					@ServerState(server.State, server.Health, server.Exit)
					if server.StateSince != 0 {
						if server.State == "running" {
							<span class="overview-since">Started @Time(server.StateSince, "plain", "")</span>
						} else {
							@Time(server.StateSince, "sentence", "overview-since")
						}
					}
					if server.State == "running" && healthNotes[server.Health] != "" {
						<span class="muted">{ healthNotes[server.Health] }</span>
					}
					if detail := ExitDetail(server.Exit); detail != "" {
						<span class="muted">{ detail }</span>
					}
				</dd>
			</div>
			if d.Row.ShowPlayers {
				@PlayersFact(d.Row.Players)
			}
			<div>
				<dt>Connect</dt>
				<dd>
					if d.Row.Address != "" {
						@CopyAddress(d.Row.Address, server.DisplayName)
						if server.Connection.Source == "label" {
							<span class="muted">Set by the ludock.address label</span>
						} else if server.Connection.Host == "" {
							<span class="muted">Using this page’s address</span>
						}
					} else {
						No public port
					}
				</dd>
			</div>
			<div>
				<dt>Ports</dt>
				<dd>
					if ports := publicPorts(server.Ports); len(ports) > 0 {
						<ul class="overview-ports">
							for _, port := range ports {
								<li>
									<code>{ strconv.Itoa(port.Public) }/{ port.Type }</code>
									if port.Private != port.Public {
										<span class="muted">container port { strconv.Itoa(port.Private) }</span>
									}
								</li>
							}
						</ul>
					} else {
						None published
					}
				</dd>
			</div>
			<div>
				<dt>CPU</dt>
				<dd>
					if d.Stats != nil {
						<span class="overview-figure">{ fmt.Sprintf("%.1f%%", d.Stats.CPUPercent) }</span>
						<span class="muted">100% is one core</span>
					} else {
						<span class="muted">{ resourcesUnavailable(d) }</span>
					}
				</dd>
			</div>
			<div>
				<dt>Memory</dt>
				<dd>
					if d.Stats != nil {
						<span class="overview-figure">{ FormatBytes(int64(d.Stats.MemUsageMB*mib + 0.5)) }</span>
						if d.Stats.MemLimitMB > 0 {
							<span class="overview-meter" aria-hidden="true"><span style={ memoryShare(d.Stats) }></span></span>
							<span class="muted">of { FormatBytes(int64(d.Stats.MemLimitMB*mib + 0.5)) }</span>
						}
					} else {
						<span class="muted">{ resourcesUnavailable(d) }</span>
					}
				</dd>
			</div>
			if d.Row.BackupSummary {
				<div>
					<dt>Last backup</dt>
					<dd>
						if backup := server.LatestBackup; backup != nil {
							@Time(backup.CreatedAt, "sentence", "")
							<span class="muted">{ FormatBytes(backup.Size) }</span>
						} else {
							Never
						}
						if hasTab(d, "backups") {
							<a class="text-link" href={ detailURL(server.ID, "tab=backups") } { inPage()... }>Backups</a>
						}
					</dd>
				</div>
			}
			if d.ShowSchedule && d.SchedulesReady {
				<div>
					<dt>Next scheduled</dt>
					<dd>
						if next := d.NextSchedule; next != nil {
							<span>{ Capitalize(next.Action) }</span>
							@Time(next.NextRunAt, "plain", "")
						} else {
							Nothing scheduled
						}
						<a class="text-link" href={ detailURL(server.ID, "tab=schedules") } { inPage()... }>Schedules</a>
					</dd>
				</div>
			}
			<div>
				<dt>Image</dt>
				<dd>
					<code>
						if server.Image != "" {
							{ server.Image }
						} else {
							Unknown
						}
					</code>
				</dd>
			</div>
		</dl>
		if d.Resources != nil {
			@ResourceHistory(*d.Resources)
		} else {
			<section id="resource-history" hx-preserve="true"></section>
		}
		if d.Availability != nil {
			@AvailabilityStatus(d)
		}
	</div>
}

func publicPorts(ports []servers.Port) []servers.Port {
	var result []servers.Port
	for _, port := range ports {
		if port.Public > 0 {
			result = append(result, port)
		}
	}
	return result
}

func hasTab(d ServerDetail, id string) bool {
	for _, tab := range d.Tabs {
		if tab.ID == id {
			return true
		}
	}
	return false
}

// availability describes monitoring for the status block.
type availability struct {
	Status      string
	OutageSince int64
	Suppressed  bool
}

func describeAvailability(a *monitor.Availability, paused bool, now int64) availability {
	policy, state := a.Policy, a.State
	suppressed := state.SuppressedUntil > now
	monitoring := policy.Enabled && !policy.Maintenance && !paused && !state.IntentionallyStopped && !suppressed
	result := availability{Status: "No outage detected.", Suppressed: suppressed && policy.Enabled && !policy.Maintenance && !paused && !state.IntentionallyStopped}
	if monitoring {
		result.OutageSince = state.OutageStartedAt
	}
	switch {
	case !policy.Enabled:
		result.Status = "Monitoring disabled."
	case policy.Maintenance:
		result.Status = "Monitoring paused for maintenance."
	case paused:
		result.Status = "Monitoring paused while a server operation is active."
	case state.IntentionallyStopped:
		result.Status = "Intentionally stopped. Outage alerts are paused until the server is running again."
	case suppressed:
		result.Status = "Waiting for monitoring to resume after a server action."
	case result.OutageSince != 0:
		if now-result.OutageSince < int64(policy.GraceSeconds)*1000 {
			result.Status = "Availability problem detected. Waiting for the failure grace period."
		} else {
			result.Status = "Availability problem detected."
		}
	case state.LastState == "":
		result.Status = "Waiting for the first availability observation."
	}
	return result
}

templ AvailabilityStatus(d ServerDetail) {
	{{ a := d.Availability }}
	{{ described := describeAvailability(a, d.Row.Server.ActiveOperation != nil, d.Now) }}
	<section class="stack-form" aria-labelledby="availability-title">
		<h2 id="availability-title">Monitoring</h2>
		<p role="status">{ described.Status }</p>
		if a.Policy.Enabled {
			<dl class="metadata-list">
				if described.OutageSince != 0 {
					<dt>Outage since</dt>
					<dd>@Time(described.OutageSince, "", "")</dd>
				}
				<dt>Last observed state</dt>
				<dd>
					if a.State.LastState != "" {
						{ Capitalize(a.State.LastState) }
					} else {
						Not observed yet
					}
				</dd>
				if described.Suppressed {
					<dt>Monitoring resumes</dt>
					<dd>@Time(a.State.SuppressedUntil, "", "")</dd>
				}
			</dl>
		}
		if described.OutageSince != 0 {
			<p class="section-note">
				if a.State.LastState == "docker_unavailable" {
					Ludock cannot reach Docker to verify this server.
					if d.Admin {
						<a class="text-link" href="/diagnostics">Check Docker connectivity in Diagnostics</a>
					}
				} else {
					Review the container’s state and health in its owning manager. A running container can still be unhealthy or starting.
				}
			</p>
		}
	</section>
}

templ AvailabilityForm(serverID string, policy monitor.Policy) {
	// Each change saves right away; the result says so.
	<form class="stack-form" hx-post={ "/servers/" + serverID + "/availability" } hx-target="#availability-result" hx-trigger="change, submit" hx-sync="this:replace">
		<p class="muted">
			Alert when this server is down. Ludock checks Docker’s running state and health check, and ignores stops made through Ludock.
		</p>
		<label class="check-label">
			<input type="checkbox" name="enabled" value="true" id="availability-enabled" checked?={ policy.Enabled }/>
			Monitor this server
		</label>
		<div class="stack-form" data-shown-by="availability-enabled" hidden?={ !policy.Enabled }>
			<label class="narrow-field">
				Failure grace period (seconds)
				<input type="number" name="graceSeconds" min="10" max="86400" inputmode="numeric" aria-describedby="monitoring-grace-help" required value={ strconv.Itoa(policy.GraceSeconds) }/>
			</label>
			<p class="muted" id="monitoring-grace-help">
				How long to wait before reporting an outage, so quick restarts don’t alert. Default 120 seconds.
			</p>
			<label class="check-label">
				<input type="checkbox" name="maintenance" value="true" checked?={ policy.Maintenance }/>
				Maintenance mode
			</label>
			<p class="muted check-help">Pauses alerts until you turn it off. The server and its schedules keep running.</p>
		</div>
		<p class="muted">Alerts go to Discord. <a class="text-link" href="/settings">Set up Discord in Settings</a></p>
		<div id="availability-result" aria-live="polite"></div>
	</form>
}

func activityQuery(a ActivityView) string {
	return url.Values{"status": {a.Status}, "kind": {a.Kind}}.Encode()
}

templ ActivityPanel(a ActivityView) {
	if a.SelectedID != "" {
		@SelectedOperation(a)
	}
	<div class="section-heading">
		<h2 id="recent-operations-title" tabindex="-1">Recent operations</h2>
		<div class="inline-actions">
			<a class="text-link" href={ templ.SafeURL("/operations?serverId=" + a.ServerID) }>Search operation history</a>
			<button class="secondary-btn" type="button" hx-get={ "/fragments/servers/" + a.ServerID + "/activity?" + activityQuery(a) } hx-target="#activity-list" hx-swap="outerHTML" data-busy-label="Refreshing…">Refresh</button>
		</div>
	</div>
	<form class="activity-filters stack-form" role="group" aria-label="Filter recent operations" method="get" action={ templ.SafeURL("/servers/" + a.ServerID) } hx-get={ "/fragments/servers/" + a.ServerID + "/activity" } hx-trigger="change" hx-target="#activity-list" hx-swap="outerHTML">
		<input type="hidden" name="tab" value="activity"/>
		<label>
			<span>Status</span>
			<select name="status">
				<option value="">All statuses</option>
				for _, status := range operationStatuses {
					<option value={ status } selected?={ a.Status == status }>{ OperationStatusLabels[status] }</option>
				}
			</select>
		</label>
		<label>
			<span>Operation</span>
			<select name="kind">
				<option value="">All operations</option>
				for _, kind := range a.Kinds {
					<option value={ kind } selected?={ a.Kind == kind }>{ Capitalize(kind) }</option>
				}
			</select>
		</label>
		if a.Status != "" || a.Kind != "" {
			<a class="secondary-btn" href={ detailURL(a.ServerID, "tab=activity") } { inPage()... }>Clear filters</a>
		}
		<noscript><button class="secondary-btn" type="submit">Apply filters</button></noscript>
	</form>
	@ActivityList(a)
}

var operationStatuses = []string{"queued", "running", "succeeded", "already_current", "failed", "interrupted"}

// ActivityList is the filtered operation list; it reloads itself.
templ ActivityList(a ActivityView) {
	<div id="activity-list" hx-get={ "/fragments/servers/" + a.ServerID + "/activity?" + activityQuery(a) } hx-trigger={ liveTrigger(a.ServerID, a.Active) } hx-swap="outerHTML" hx-disinherit="*">
		if a.Error != "" {
			@Alert("error", a.Error)
		}
		<p class="section-note activity-filter-count" aria-live="polite">Showing { strconv.Itoa(len(a.Visible)) } of { strconv.Itoa(a.Total) } recent operations.</p>
		if a.HiddenActive {
			<p class="section-note activity-filter-notice">
				An active operation is hidden by these filters. Server controls remain paused.
				<a class="text-link" href={ detailURL(a.ServerID, "tab=activity") } { inPage()... }>Show active work</a>
			</p>
		}
		@OperationList(a.Visible, map[bool]string{true: "No recent operations match these filters.", false: "No operations yet."}[a.Total > 0], false, nil)
		if a.Admin && a.AlreadyCurrent {
			<p class="section-note">
				The configured image is current. Game software may update during startup.
				<a class="text-link" href={ detailURL(a.ServerID, "tab=update&recreate=1") } { inPage()... }>Recreate anyway</a>
			</p>
		}
	</div>
}

func guidance(result map[string]any) string {
	text, _ := result["guidance"].(string)
	return text
}

// SelectedOperation reloads itself while the operation is active.
templ SelectedOperation(a ActivityView) {
	<section
		class="scheduled-operation"
		id="selected-operation"
		aria-labelledby="scheduled-operation-title"
		if a.Selected != nil && ActiveStatus(a.Selected.Status) {
			hx-get={ "/fragments/servers/" + a.ServerID + "/operations/" + a.SelectedID + "?tab=" + a.Tab }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
			hx-disinherit="*"
		}
	>
		<div class="section-heading">
			<h2 id="scheduled-operation-title" tabindex="-1">Operation details</h2>
			// The Backups tab follows running work until it ends.
			if a.Tab != "backups" || a.Selected == nil || !ActiveStatus(a.Selected.Status) {
				<a class="secondary-btn" href={ detailURL(a.ServerID, "tab="+a.Tab) } { inPage()... }>Dismiss</a>
			}
		</div>
		if a.SelectedError != "" {
			<p role="alert">{ a.SelectedError }</p>
		}
		if operation := a.Selected; operation != nil {
			<p><a class="text-link" href={ templ.SafeURL("/operations/" + operation.ID) }>Open in operation history</a></p>
			<dl class="metadata-list">
				<dt>Action</dt>
				<dd>{ Capitalize(operation.Kind) }</dd>
				<dt>Status</dt>
				<dd>
					@Pip(OperationTones[operation.Status])
					{ OperationStatusLabels[operation.Status] }
				</dd>
				<dt>Queued at</dt>
				<dd>@Time(operation.CreatedAt, "", "")</dd>
				<dt>Last updated</dt>
				<dd>@Time(operation.UpdatedAt, "", "")</dd>
				<dt>Progress</dt>
				<dd>{ OperationLabel(operation.Status, operation.Phase) }</dd>
			</dl>
			if operation.Error != "" {
				<p class="operation-error">{ operation.Error }</p>
			}
			if detail := SaveDetail(operation.Result); detail != "" {
				<p class="section-note">{ detail }</p>
			}
			if text := guidance(operation.Result); text != "" {
				<p class="section-note">{ text }</p>
			}
			if id := newBackup(operation); id != "" && a.Archives {
				<p class="inline-actions">
					<a class="secondary-btn" href={ templ.SafeURL("/servers/" + a.ServerID + "/backups/" + id + "/download") } download>Download backup</a>
				</p>
			}
		}
	</section>
}

func ActiveStatus(status string) bool { return status == "queued" || status == "running" }

// newBackup is the backup a finished operation made, if any.
func newBackup(operation *ops.Job) string {
	id, _ := operation.Result["backupId"].(string)
	if operation.Status != "succeeded" {
		return ""
	}
	return id
}

// OperationList is a table of operations; showContext adds the server and
// actor column for the history page.
templ OperationList(operations []history.Operation, empty string, showContext bool, serverNames map[string]string) {
	<div class="table-scroll">
		<table class="data-table" aria-label={ map[bool]string{true: "Operation history", false: "Recent operations"}[showContext] }>
			<thead>
				<tr>
					<th>Operation</th>
					if showContext {
						<th>Server / actor</th>
					}
					<th>Started</th>
					<th>Progress / result</th>
				</tr>
			</thead>
			<tbody>
				if len(operations) == 0 {
					<tr><td colspan={ map[bool]string{true: "4", false: "3"}[showContext] } class="muted">{ empty }</td></tr>
				}
				for _, operation := range operations {
					<tr>
						<td><a class="text-link" href={ templ.SafeURL("/operations/" + operation.ID) }>{ Capitalize(operation.Kind) }</a></td>
						if showContext {
							<td class="operation-server">
								<a class="text-link" href={ templ.SafeURL("/servers/" + operation.ServerID) }>
									if name := serverNames[operation.ServerID]; name != "" {
										{ name }
									} else {
										{ operation.ServerID }
									}
								</a>
								<p class="muted">{ ActorLabel(operation.Actor) }</p>
							</td>
						}
						<td>@Time(operation.CreatedAt, "", "")</td>
						<td>
							<span
								if ActiveStatus(operation.Status) {
									role="status"
								}
							>
								@Pip(OperationTones[operation.Status])
								{ OperationLabel(operation.Status, operation.Phase) }
							</span>
							if operation.Error != "" {
								<p class="operation-error">{ operation.Error }</p>
							}
							if detail := SaveDetail(operation.Result); detail != "" {
								<p class="muted">{ detail }</p>
							}
							if text := guidance(operation.Result); text != "" {
								<p class="muted">{ text }</p>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

func ActorLabel(actor *history.Actor) string {
	switch {
	case actor == nil:
		return "Not recorded"
	case actor.Name != "":
		return actor.Name
	case actor.ID != "":
		return "User " + actor.ID + " (name unavailable)"
	}
	return "Not recorded"
}
