package views

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/history"
	"github.com/Crunging/Ludock/internal/monitor"
	"github.com/Crunging/Ludock/internal/ops"
	"github.com/Crunging/Ludock/internal/resources"
	"github.com/Crunging/Ludock/internal/schedules"
	"github.com/Crunging/Ludock/internal/servers"
)

type DetailTab struct{ ID, Label string }

type ServerDetail struct {
	Row                  ServerRow
	Stats                *servers.Stats
	DiscoveryUnavailable bool
	DockerProblem        string
	Admin                bool
	Tab                  string
	Tabs                 []DetailTab
	Availability         *monitor.Availability
	// Recovery is what automatic restarts last did.
	Recovery monitor.Recovery
	Disk     monitor.DiskState
	// ResourceAlerts are the server's active disk and memory alerts.
	ResourceAlerts []monitor.Resource
	// FolderPaths: the viewer may see data folders' container paths.
	FolderPaths bool
	// Resources is the resource history; overview refreshes leave it nil
	// and keep the one on the page.
	Resources *resources.History
	// ShowSchedule shows the next run; SchedulesReady is false when the list
	// could not be read.
	ShowSchedule   bool
	SchedulesReady bool
	NextSchedule   *schedules.Schedule
	// Suspended counts enabled schedules that can't run.
	Suspended int
	// WaitingSchedule is a run waiting for players to leave.
	WaitingSchedule *schedules.Schedule
	WaitingCancel   bool
	Now             int64
	Activity        ActivityView
	Backups         BackupsView
	Schedules       SchedulesView
	// Recreate opens the update tab with "Update even if the image is already up to date" ticked.
	Recreate bool
	Sharing  SharingView
	// Operation is the operation the page shows, if any.
	Operation string
}

type ActivityView struct {
	ServerID string
	Total    int
	Visible  []history.Operation
	Kinds    []string
	// AlreadyOffered offers "Already up to date" to a member, whose access
	// never includes updates, once the server's history has one.
	AlreadyOffered bool
	Status, Kind   string
	Error          string
	Admin          bool
	HiddenActive   bool
	Active         bool
	SelectedID     string
	Selected       *ops.Job
	SelectedError  string
	// AlreadyCurrent offers recreation after an update found nothing new.
	AlreadyCurrent bool
	// Tab is the tab showing the selected operation.
	Tab string
	// Waiting is a scheduled run waiting for players to leave;
	// WaitingCancel, whether the viewer may cancel it.
	Waiting       *schedules.Schedule
	WaitingCancel bool
	// Cancellable are the waiting operations the viewer may cancel.
	Cancellable         map[string]bool
	SelectedCancelledBy *history.Actor
	// Archives offers the download of a backup the operation made.
	Archives bool
}

func detailURL(id, query string) templ.SafeURL {
	if query == "" {
		return templ.SafeURL("/servers/" + id)
	}
	return templ.SafeURL("/servers/" + id + "?" + query)
}

// inPage moves between views of a server inside the page: the address bar
// changes, but the page and its live connection stay. Boosting keeps the
// link's own address and lets modified clicks open a new tab. A second click
// on a link replaces its pending request. The swap stays synchronous (no
// view transition): a later click must see the view the earlier one opened.
func inPage() templ.Attributes {
	return templ.Attributes{"hx-boost": "true", "hx-target": "#detail-body", "hx-select": "#detail-body",
		"hx-swap": "outerHTML show:none", "hx-sync": "this:replace"}
}

func liveTrigger(id string, active bool) string {
	every := "every 10s"
	if active {
		every = "every 2s"
	}
	return "server-" + id + " from:document, refresh from:document, servers-changed from:document, " + every
}

// activeID is the server's running operation, if any. The live header
// sends it back, so its next refresh can tell when that work has ended.
func activeID(server servers.View) string {
	if server.ActiveOperation == nil {
		return ""
	}
	return server.ActiveOperation.ID
}

func headerClass(d ServerDetail) string {
	class := "detail-header"
	if LifecycleAction(d.Row.Server.State) == "start" {
		class += " detail-header--stopped"
	}
	if d.Row.Status().Tone == "failed" {
		class += " detail-header--failed"
	}
	return class
}

templ ServerDetailPage(page Page, d ServerDetail) {
	@Shell(page) {
		<div class="page server-detail" hx-sse:connect={ "/events?" + url.Values{"server": {d.Row.Server.ID}}.Encode() } hx-trigger="load, live-retry" hx-swap="none">
			<a class="text-link back-link" href="/"><span aria-hidden="true">←</span> All servers</a>
			// In-page links replace only this part, so the event stream stays open.
			<div id="detail-body">
				@detailBody(d)
			</div>
		</div>
	}
}

templ detailBody(d ServerDetail) {
	{{ server := d.Row.Server }}
	@DetailLive(d)
	if server.SharingPaused {
		@ConfirmChange(server.ID, server.BindingRevision)
	}
	<div id="detail-status" aria-live="polite"></div>
	<nav class="section-tabs" aria-label="Server management">
		for _, tab := range d.Tabs {
			<a href={ detailURL(server.ID, "tab="+tab.ID) } { inPage()... } id={ "tab-" + tab.ID } aria-current={ map[bool]string{true: "page"}[tab.ID == d.Tab] }>{ tab.Label }</a>
		}
	</nav>
	<section class="section-tab-panel" aria-label={ tabLabel(d) }>
		switch d.Tab {
			case "activity":
				@ActivityPanel(d.Activity)
			case "backups":
				@BackupsTab(d.Backups)
			case "schedules":
				@SchedulesTab(d.Schedules)
			case "update":
				@UpdateTab(server.ID, d.Recreate)
			case "sharing":
				@SharingTab(d.Sharing)
			default:
				@OverviewLive(d)
				if d.Admin && d.Availability != nil {
					@AvailabilityForm(server.ID, d.Availability.Policy, monitor.RecoveryOffered(server.Container))
				}
				if d.Admin {
					@RemoveServer(server)
				}
		}
	</section>
}

func tabLabel(d ServerDetail) string {
	for _, tab := range d.Tabs {
		if tab.ID == d.Tab {
			return tab.Label
		}
	}
	return "Overview"
}

// DetailLive is the header and server-wide notices; it reloads itself.
templ DetailLive(d ServerDetail) {
	{{ server := d.Row.Server }}
	<div id="detail-live" hx-get={ "/fragments/servers/" + server.ID + "/live?" + url.Values{"tab": {d.Tab}, "operation": {d.Operation}, "active": {activeID(server)}}.Encode() } hx-trigger={ liveTrigger(server.ID, server.ActiveOperation != nil) } hx-swap="outerMorph">
		<header class={ headerClass(d) }>
			@StateMark(d.Row.Status().Tone)
			<div class="detail-header__title">
				<h1 class="page__title" id="server-detail-title" tabindex="-1">{ server.DisplayName }</h1>
				<p class="detail-header__identity">
					@StatusLabel(d.Row.Status())
					<span class="detail-header__game">{ server.GameName }</span>
				</p>
			</div>
			if d.Row.ConsoleLabel != "" || d.Row.CanFiles || d.Row.CanStart || d.Row.CanStop || d.Row.CanRestart {
				<div class="inline-actions detail-actions">
					if d.Row.ConsoleLabel != "" || d.Row.CanFiles {
						<div class="detail-actions__group">
							if d.Row.ConsoleLabel != "" {
								// Start is the primary action of a stopped server.
								<a class={ templ.KV("primary-btn", !d.Row.CanStart), templ.KV("secondary-btn", d.Row.CanStart) } href={ templ.SafeURL("/console/" + server.ID) }>{ d.Row.ConsoleLabel }</a>
							}
							if d.Row.CanFiles {
								<a class="secondary-btn" href={ templ.SafeURL("/files/" + server.ID) }>Files</a>
							}
						</div>
					}
					if d.Row.CanStart || d.Row.CanStop || d.Row.CanRestart {
						<div class="detail-actions__group">
							if d.Row.CanStart {
								<button type="button" class="primary-btn" disabled?={ d.Row.Disabled } hx-post={ "/servers/" + server.ID + "/start" } hx-target="#detail-status" data-busy-label="Working…">Start</button>
							}
							if d.Row.CanStop {
								<button type="button" class="secondary-btn secondary-btn--danger" disabled?={ d.Row.Disabled } hx-post={ "/servers/" + server.ID + "/stop" } hx-target="#detail-status" data-busy-label="Working…" { LifecycleConfirm("stop", server.DisplayName, false, d.Row.Warn, d.Row.Online)... }>Stop</button>
							}
							if d.Row.CanRestart {
								<button type="button" class="secondary-btn" disabled?={ d.Row.Disabled } hx-post={ "/servers/" + server.ID + "/restart" } hx-target="#detail-status" data-busy-label="Working…" { LifecycleConfirm("restart", server.DisplayName, d.Row.CanBackup, d.Row.Warn, d.Row.Online)... }>Restart</button>
							}
						</div>
					}
				</div>
			}
		</header>
		if d.DiscoveryUnavailable {
			<div class="alert alert--error" role="alert">
				if d.DockerProblem != "" {
					{ d.DockerProblem } This shows the last known state.
				} else {
					Ludock can’t reach Docker right now, so this shows the last known state. Server controls come back once it can.
				}
				if d.Admin {
					<a class="text-link" href="/settings/system">Check the connection</a>
				}
			</div>
		}
		if server.BindingStatus == "active" {
			if guidance := StateGuidance(server.State); guidance != "" {
				<p class="section-note" role="status">{ guidance }</p>
			}
			if server.AutoRemove {
				<p class="section-note" id="deleted-on-stop">{ servers.AutoRemoveMessage }</p>
			}
		} else {
			<div class="alert alert--error" role="alert">{ BindingNote(string(server.BindingStatus)) } Controls come back once Docker has exactly one container for it.</div>
		}
		// The notice points to progress the page doesn't already show.
		if operation := server.ActiveOperation; operation != nil && d.Tab != "activity" && operation.ID != d.Operation {
			<div class="detail-operation-notice">
				<p role="status">
					<strong>{ Capitalize(operation.Kind) }</strong>: { OperationLabel(operation.Status, operation.Phase) }. Server controls, backups, and updates are paused until it finishes.
				</p>
				<a class="text-link" href={ templ.SafeURL(OperationPath(server.ID, operation.Kind, operation.ID)) } { inPage()... }>View progress</a>
				if CanCancelActive(server) {
					@CancelButton(server.ID, operation.ID, operation.Kind, "#detail-status")
				}
			</div>
		}
	</div>
}

templ ConfirmChange(serverID string, revision int64) {
	<form class="notice-panel stack-form" hx-post={ "/servers/" + serverID + "/confirm-change" } hx-target="#confirm-change-status">
		<h3>This server changed in Docker</h3>
		<p>
			Its game or data folders changed. People you shared it with can’t use it, and their schedules wait, until you confirm it’s still the server you meant to share. You can keep using it as usual.
		</p>
		<input type="hidden" name="bindingRevision" value={ strconv.FormatInt(revision, 10) }/>
		<div id="confirm-change-status" aria-live="polite"></div>
		<button class="primary-btn" type="submit" data-busy-label="Confirming…">Confirm and restore access</button>
	</form>
}

// BindingNote explains a server without exactly one container, or is empty.
func BindingNote(status string) string {
	switch status {
	case "missing":
		return "Ludock can’t find this server’s container in Docker."
	case "ambiguous":
		return "More than one container claims to be this server."
	}
	return ""
}

var healthNotes = map[string]string{"starting": "Health check is starting", "healthy": "Health check passing", "unhealthy": "Health check failing"}

var healthStates = map[string]string{"starting": "Starting", "healthy": "Passing", "unhealthy": "Failing"}

func resourcesUnavailable(d ServerDetail) string {
	if d.DiscoveryUnavailable {
		return "Shown once Ludock can reach Docker"
	}
	if d.Row.Server.State == "running" {
		return "Can’t be read right now"
	}
	return "Shown while the server is running"
}

const mib = 1024 * 1024

templ folderName(paths bool, path string) {
	if paths {
		<code>{ path }</code>
	} else {
		<span>A data folder</span>
	}
}

// WholePercent shows a percentage rounded to a whole number.
func WholePercent(value float64) string { return fmt.Sprintf("%.0f%%", value) }

func diskShare(folder monitor.Folder) string {
	return fmt.Sprintf("width: %.1f%%", min(100, folder.Percent()))
}

func diskUnmeasured(d ServerDetail) string {
	switch {
	case d.FolderPaths && len(d.Row.Server.FileRoots) == 0:
		return "No data folders"
	case d.Availability == nil || !d.Availability.Policy.Enabled:
		return "Measured while monitoring is on"
	case !d.Availability.Policy.DiskAlert:
		return "Measured while disk alerts are on"
	}
	return "Not measured yet"
}

func memoryShare(stats *servers.Stats) string {
	share := min(100, stats.MemUsageMB/stats.MemLimitMB*100)
	return fmt.Sprintf("width: %.1f%%", share)
}

// OverviewLive is what an owner or friend opens the page for, then who is
// on, resources, the Docker-facing details, and monitoring; it reloads
// itself. Parts that hold their own state (the player lists, the resource
// history, the details' open state) survive its refreshes.
templ OverviewLive(d ServerDetail) {
	{{ server := d.Row.Server }}
	<div id="overview-live" hx-get={ "/fragments/servers/" + server.ID + "/overview" } hx-trigger={ liveTrigger(server.ID, false) + ", availability-changed from:document" } hx-swap="outerMorph">
		<h2 class="sr-only">Overview</h2>
		<dl class="overview-facts">
			<div>
				<dt>State</dt>
				<dd>
					@StatusLabel(d.Row.Status())
					if server.StateSince != 0 {
						if server.State == "running" {
							<span class="overview-since">Started @Time(server.StateSince, "plain", "")</span>
						} else {
							@Time(server.StateSince, "sentence", "overview-since")
						}
					}
					if server.State == "running" && server.Health == "unhealthy" {
						<span class="muted">{ healthNotes[server.Health] }</span>
					}
					if detail := ExitDetail(server.Exit); detail != "" {
						<span class="muted">{ detail }</span>
					}
				</dd>
			</div>
			@GameFact(d.Row.Game)
			<div>
				<dt>Connect</dt>
				<dd>
					if d.Row.Address != "" {
						@CopyAddress(d.Row.Address, server.DisplayName)
						if server.Connection.Source != "label" && server.Connection.Host == "" {
							<span class="muted">Using this page’s address</span>
						}
					} else {
						No public port
					}
				</dd>
			</div>
			// The header says why a server that refuses backups has none, and
			// the Disk line why one with no data folders has none.
			if d.Row.BackupSummary && (server.LatestBackup != nil || (!server.Refuses(ops.KindBackup) && !server.NoDataFolders)) {
				<div>
					<dt>Last backup</dt>
					<dd>
						if backup := server.LatestBackup; backup != nil {
							@Time(backup.CreatedAt, "sentence", "")
							<span class="muted">{ FormatBytes(backup.Size) }</span>
						} else {
							Never
						}
						if hasTab(d, "backups") {
							<a class="text-link" href={ detailURL(server.ID, "tab=backups") } { inPage()... }>Backups</a>
						}
					</dd>
				</div>
			}
			if d.ShowSchedule && d.SchedulesReady {
				<div>
					<dt>Next scheduled</dt>
					<dd>
						if waiting := d.WaitingSchedule; waiting != nil {
							<span class="schedule-waiting">{ ActionLabel(waiting.Action) } waiting for players to leave, until</span>
							@Time(waiting.WaitingUntil, "plain", "")
							if d.WaitingCancel {
								@CancelWaitButton(server.ID, waiting.ID, waiting.LastSlot)
							}
						} else if next := d.NextSchedule; next != nil {
							<span>{ ActionLabel(next.Action) }</span>
							@Time(next.NextRunAt, "plain", "")
						} else {
							Nothing scheduled
						}
						if d.Suspended > 0 {
							<span class="muted">{ map[bool]string{true: "1 schedule is", false: intText(d.Suspended) + " schedules are"}[d.Suspended == 1] } suspended</span>
						}
						<a class="text-link" href={ detailURL(server.ID, "tab=schedules") } { inPage()... }>Schedules</a>
					</dd>
				</div>
			}
		</dl>
		<section class="overview-section" aria-labelledby="players-title">
			<h2 id="players-title">Players</h2>
			<dl class="overview-facts overview-facts--wide">
				@PlayersFact(d.Row.Players)
			</dl>
			if moderation := d.Row.Players.Moderation; moderation != nil && moderation.Lists != nil {
				@PlayerListsDisclosure(server.ID)
			}
		</section>
		<section class="overview-section" aria-labelledby="resources-title">
			<h2 id="resources-title">Resources</h2>
			<dl class="overview-facts">
				<div>
					<dt>CPU</dt>
					<dd>
						if d.Stats != nil {
							<span class="overview-figure">{ fmt.Sprintf("%.1f%%", d.Stats.CPUPercent) }</span>
						} else {
							<span class="muted">{ resourcesUnavailable(d) }</span>
						}
					</dd>
				</div>
				<div>
					<dt>Memory</dt>
					<dd>
						if d.Stats != nil {
							<span class="overview-figure">{ FormatBytes(int64(d.Stats.MemUsageMB*mib + 0.5)) }</span>
							if d.Stats.MemLimitMB > 0 {
								<span class="overview-meter" aria-hidden="true"><span style={ memoryShare(d.Stats) }></span></span>
								<span class="muted">of { FormatBytes(int64(d.Stats.MemLimitMB*mib + 0.5)) }</span>
							}
						} else {
							<span class="muted">{ resourcesUnavailable(d) }</span>
						}
					</dd>
				</div>
				<div class="overview-disk">
					<dt>Disk</dt>
					<dd>
						if len(d.Disk.Folders) == 0 {
							<span class="muted">{ diskUnmeasured(d) }</span>
						} else {
							<ul class="overview-disks">
								for _, folder := range d.Disk.Folders {
									<li>
										@folderName(d.FolderPaths, folder.Path)
										if folder.MeasuredAt != 0 {
											<span class="overview-disks__figure">{ fmt.Sprintf("%.0f%% full", folder.Percent()) }</span>
											<span class={ "overview-meter", templ.KV("overview-meter--alert", folder.AlertSince != 0) } aria-hidden="true"><span style={ diskShare(folder) }></span></span>
											<span class="muted">{ FormatBytes(folder.AvailableBytes) } free of { FormatBytes(folder.TotalBytes) }, measured @Time(folder.MeasuredAt, "plain", "")</span>
										}
										if folder.Unknown {
											<span class="muted">Couldn’t be measured just now</span>
										}
									</li>
								}
							</ul>
						}
					</dd>
				</div>
			</dl>
			if d.Resources != nil {
				@ResourceHistory(*d.Resources)
			} else {
				<section id="resource-history" hx-preserve="true"></section>
			}
		</section>
		@overviewDetails(d)
		if d.Availability != nil {
			@AvailabilityStatus(d)
		}
	</div>
}

// overviewDetails holds the Docker-facing facts few people need. It stays
// open across refreshes once opened (data-keep-open in ludock.js).
templ overviewDetails(d ServerDetail) {
	{{ server := d.Row.Server }}
	<details class="disclosure overview-details" id="overview-details" data-keep-open>
		<summary>Details</summary>
		<dl class="metadata-list">
			if server.State == "running" && healthNotes[server.Health] != "" {
				<dt>Health check</dt>
				<dd>{ healthStates[server.Health] }</dd>
			}
			if d.Row.Address != "" && server.Connection.Source == "label" {
				<dt>Address</dt>
				<dd>Set by the ludock.address label</dd>
			}
			if d.Admin {
				<dt>Ports</dt>
				<dd>
					if ports := publicPorts(server.Ports); len(ports) > 0 {
						<ul class="overview-ports">
							for _, port := range ports {
								<li>
									<code>{ strconv.Itoa(port.Public) }/{ port.Type }</code>
									if port.Private != port.Public {
										<span class="muted">container port { strconv.Itoa(port.Private) }</span>
									}
								</li>
							}
						</ul>
					} else {
						None published
					}
				</dd>
				<dt>Container</dt>
				<dd><code>{ server.Name }</code></dd>
				if server.Image != "" {
					<dt>Image</dt>
					<dd><code>{ server.Image }</code></dd>
				}
			}
			<dt>CPU</dt>
			<dd>100% is one core.</dd>
		</dl>
	</details>
}

func publicPorts(ports []servers.Port) []servers.Port {
	var result []servers.Port
	for _, port := range ports {
		if port.Public > 0 {
			result = append(result, port)
		}
	}
	return result
}

func hasTab(d ServerDetail, id string) bool {
	for _, tab := range d.Tabs {
		if tab.ID == id {
			return true
		}
	}
	return false
}

// availability describes monitoring for the status block.
type availability struct {
	Status      string
	OutageSince int64
	Suppressed  bool
}

func describeAvailability(a *monitor.Availability, paused bool, now int64) availability {
	policy, state := a.Policy, a.State
	suppressed := state.SuppressedUntil > now
	monitoring := policy.Enabled && !policy.Maintenance && !paused && !state.IntentionallyStopped && !suppressed
	result := availability{Status: "No outage detected.", Suppressed: suppressed && policy.Enabled && !policy.Maintenance && !paused && !state.IntentionallyStopped}
	if monitoring {
		result.OutageSince = state.OutageStartedAt
	}
	switch {
	case !policy.Enabled:
		result.Status = "Monitoring is off."
	case policy.Maintenance:
		result.Status = "Alerts are paused for maintenance."
	case paused:
		result.Status = "Monitoring is paused while other work on the server runs."
	case state.IntentionallyStopped:
		result.Status = "Stopped. Alerts resume once the server is running again."
	case suppressed:
		result.Status = "Paused briefly after a restart or stop."
	case result.OutageSince != 0:
		waiting := now-result.OutageSince < int64(policy.GraceSeconds)*1000
		switch {
		case state.LastState == monitor.NotAnswering:
			result.Status = "The game isn’t answering."
		case state.LastState == monitor.DockerUnavailable:
			result.Status = "Ludock can’t check the server."
		case waiting:
			result.Status = "The server looks down."
		default:
			result.Status = "The server is down."
		}
		if waiting {
			result.Status += " Waiting a moment before alerting, in case it comes back."
		}
	case state.LastState == "":
		result.Status = "Checking it for the first time."
	}
	return result
}

templ AvailabilityStatus(d ServerDetail) {
	{{ a := d.Availability }}
	{{ described := describeAvailability(a, d.Row.Server.ActiveOperation != nil, d.Now) }}
	<section class="stack-form" aria-labelledby="availability-title">
		<h2 id="availability-title">Monitoring</h2>
		<p role="status">{ described.Status }</p>
		if a.Policy.Enabled {
			<dl class="metadata-list">
				if described.OutageSince != 0 {
					<dt>Outage since</dt>
					<dd>@Time(described.OutageSince, "", "")</dd>
				}
				<dt>Last seen</dt>
				<dd>
					if a.State.LastState == monitor.NotAnswering {
						Running, but the game isn’t answering
					} else if a.State.LastState == monitor.DockerUnavailable {
						Unknown: Ludock can’t reach Docker
					} else if a.State.LastState != "" {
						{ Capitalize(a.State.LastState) }
					} else {
						Not checked yet
					}
				</dd>
				if described.Suppressed {
					<dt>Monitoring resumes</dt>
					<dd>@Time(a.State.SuppressedUntil, "", "")</dd>
				}
				if a.Policy.Recover && monitor.RecoveryOffered(d.Row.Server.Container) {
					<dt>Automatic restart</dt>
					<dd class="recovery-status">@RecoveryStatus(d.Recovery, d.Row.Server.State == "running")</dd>
				}
				for _, alert := range d.ResourceAlerts {
					if alert.Kind == "disk" {
						<dt>Disk nearly full</dt>
						<dd>@folderName(d.FolderPaths, alert.Path) is { WholePercent(alert.Percent) } full, since @Time(alert.Since, "", "")</dd>
					} else {
						<dt>Memory near its limit</dt>
						<dd>Over { WholePercent(alert.Percent) } of the limit since @Time(alert.Since, "", "")</dd>
					}
				}
			</dl>
		}
		if described.OutageSince != 0 {
			<p class="section-note">
				if a.State.LastState == monitor.DockerUnavailable {
					Ludock can’t reach Docker to check this server.
					if d.Admin {
						<a class="text-link" href="/settings/system">Check the connection</a>
					}
				} else if a.State.LastState == monitor.NotAnswering {
					The server is running, but the game stopped answering. Check its logs and console; a restart may bring it back.
				} else {
					Check the server in the tool that runs it, such as Compose or Portainer. A running server can still be unhealthy or starting.
				}
			</p>
		}
	</section>
}

// RecoveryStatus says what automatic restarts last did.
templ RecoveryStatus(r monitor.Recovery, running bool) {
	if !running {
		On while the server runs: it restarts a game that stops answering. A server that exits is left to the restart policy set in the tool that runs it, such as Compose.
	} else {
		switch r.Last {
			case monitor.RecoveryRestarted:
				Restarted it @Time(r.RestartedAt, "plain", "") because the game stopped answering.
				if r.Pending {
					{ " Waiting for it to answer." }
				}
			case monitor.RecoveryAnswered:
				Restarted it @Time(r.RestartedAt, "plain", "") because the game stopped answering. It answered again.
			case monitor.RecoveryNotAnswered:
				Restarted it @Time(r.RestartedAt, "plain", ""), but the game hasn’t answered since. It won’t be restarted again until the game answers.
			case monitor.RecoveryFailed:
				Tried to restart it @Time(r.RestartedAt, "plain", "") and couldn’t; Activity says why.
			case monitor.RecoverySkipped:
				A restart @Time(r.RestartedAt, "plain", "") wasn’t needed: the game answered or the server stopped first.
			case monitor.RecoveryGaveUp:
				Stopped restarting it @Time(r.LastAt, "plain", "") after { strconv.Itoa(monitor.RecoveryAttempts) } restarts in 6 hours. It needs a look.
			default:
				On. Not needed so far.
		}
	}
}

// AvailabilityForm keeps automatic restart in sight and the rest of
// monitoring's settings under a disclosure, open while monitoring is off.
templ AvailabilityForm(serverID string, policy monitor.Policy, recoveryOffered bool) {
	// Each change saves right away; the result says so.
	<form class="stack-form availability-form" hx-post={ "/servers/" + serverID + "/availability" } hx-target="#availability-result" hx-trigger="change, submit" hx-sync="this:replace">
		if recoveryOffered {
			<div class="stack-form" data-shown-by="availability-enabled" hidden?={ !policy.Enabled }>
				<input type="hidden" name="recoverOffered" value="true"/>
				<label class="check-label">
					<input type="checkbox" name="recover" value="true" checked?={ policy.Recover }/>
					Restart it if the game stops answering
				</label>
				<p class="muted check-help">Ludock restarts it the way the Restart button does, at most { strconv.Itoa(monitor.RecoveryAttempts) } times in 6 hours. A server that is stopped or hasn’t answered since it started is left alone.</p>
			</div>
		}
		<details class="disclosure" id="monitoring-settings" open?={ !policy.Enabled }>
			<summary>Monitoring settings</summary>
			<div class="stack-form">
				<label class="check-label">
					<input type="checkbox" name="enabled" value="true" id="availability-enabled" checked?={ policy.Enabled }/>
					Monitor this server
				</label>
				<p class="muted check-help">Alerts when it goes down, its game stops answering, its disk is nearly full, or its memory stays near its limit. Stops made through Ludock don’t alert.</p>
				<div class="stack-form" data-shown-by="availability-enabled" hidden?={ !policy.Enabled }>
					<label class="check-label">
						<input type="checkbox" name="maintenance" value="true" checked?={ policy.Maintenance }/>
						Pause alerts for maintenance
					</label>
					<p class="muted check-help">Until you turn this off. The server and its schedules keep running.</p>
					<label class="narrow-field">
						Wait before alerting (seconds)
						<input type="number" name="graceSeconds" min="10" max="86400" inputmode="numeric" aria-describedby="monitoring-grace-help" required value={ strconv.Itoa(policy.GraceSeconds) }/>
					</label>
					<p class="muted" id="monitoring-grace-help">So a quick restart doesn’t alert. Default 120.</p>
					<label class="check-label">
						<input type="checkbox" name="diskAlert" value="true" id="availability-disk" checked?={ policy.DiskAlert }/>
						Alert when a data folder’s disk is nearly full
					</label>
					<div class="stack-form" data-shown-by="availability-disk" hidden?={ !policy.DiskAlert }>
						<label class="narrow-field">
							Disk alert level (% full)
							<input type="number" name="diskPercent" min="50" max="99" inputmode="numeric" aria-describedby="monitoring-disk-help" required value={ strconv.Itoa(policy.DiskPercent) }/>
						</label>
						<p class="muted" id="monitoring-disk-help">Default 90%.</p>
					</div>
					<label class="check-label">
						<input type="checkbox" name="memoryAlert" value="true" id="availability-memory" checked?={ policy.MemoryAlert }/>
						Alert when memory stays near the server’s limit
					</label>
					<div class="stack-form" data-shown-by="availability-memory" hidden?={ !policy.MemoryAlert }>
						<label class="narrow-field">
							Memory alert level (% of limit)
							<input type="number" name="memoryPercent" min="50" max="99" inputmode="numeric" aria-describedby="monitoring-memory-help" required value={ strconv.Itoa(policy.MemoryPercent) }/>
						</label>
						<label class="narrow-field">
							For at least (minutes)
							<input type="number" name="memoryMinutes" min="1" max="60" inputmode="numeric" aria-describedby="monitoring-memory-help" required value={ strconv.Itoa(policy.MemoryMinutes) }/>
						</label>
						<p class="muted" id="monitoring-memory-help">Only for a server with a memory limit. Default 90% for 5 minutes.</p>
					</div>
				</div>
				<p class="muted">Alerts go to the destinations turned on in <a class="text-link" href="/settings#notification-settings-title">Settings → Notifications</a>.</p>
			</div>
		</details>
		<div id="availability-result" aria-live="polite"></div>
	</form>
}

templ ActivityPanel(a ActivityView) {
	if a.SelectedID != "" {
		@SelectedOperation(a)
	}
	<div class="section-heading">
		<h2 id="recent-operations-title" tabindex="-1">Recent activity</h2>
		<div class="inline-actions">
			<a class="text-link" href={ templ.SafeURL("/activity?serverId=" + a.ServerID) }>Search all activity</a>
		</div>
	</div>
	<form class="activity-filters stack-form" role="group" aria-label="Filter recent activity" method="get" action={ templ.SafeURL("/servers/" + a.ServerID) } hx-get={ "/fragments/servers/" + a.ServerID + "/activity" } hx-trigger="change" hx-target="#activity-list" hx-swap="outerMorph" hx-sync="#activity-list:queue last">
		<input type="hidden" name="tab" value="activity"/>
		<label>
			<span>Result</span>
			<select name="status">
				<option value="">Any result</option>
				for _, status := range operationStatuses {
					if status != "already_current" || a.Admin || a.AlreadyOffered {
						<option value={ status } selected?={ a.Status == status }>{ OperationStatusLabels[status] }</option>
					}
				}
			</select>
		</label>
		<label>
			<span>What</span>
			<select name="kind">
				<option value="">Everything</option>
				for _, kind := range a.Kinds {
					<option value={ kind } selected?={ a.Kind == kind }>{ Capitalize(kind) }</option>
				}
			</select>
		</label>
		if a.Status != "" || a.Kind != "" {
			<a class="secondary-btn" href={ detailURL(a.ServerID, "tab=activity") } { inPage()... }>Clear filters</a>
		}
		<noscript><button class="secondary-btn" type="submit">Apply filters</button></noscript>
	</form>
	@ActivityList(a)
}

var operationStatuses = []string{"queued", "running", "succeeded", "already_current", "skipped", "failed", "interrupted", "cancelled"}

// ActivityList is the filtered operation list; it reloads itself. Like the
// server list, its refreshes read the filters from the form and share its
// queue with filter requests, so the newest filters win; every swap into it
// morphs, since a queued request keeps the element it targets.
templ ActivityList(a ActivityView) {
	<div id="activity-list" hx-get={ "/fragments/servers/" + a.ServerID + "/activity" } hx-include=".activity-filters" hx-trigger={ liveTrigger(a.ServerID, a.Active) } hx-swap="outerMorph">
		if a.Error != "" {
			@Alert("error", a.Error)
		}
		if waiting := a.Waiting; waiting != nil {
			<div class="section-note activity-waiting" role="status">
				A scheduled { waiting.Action } is waiting for players to leave, until
				@Time(waiting.WaitingUntil, "plain", "")<span>.</span>
				<a class="text-link" href={ detailURL(a.ServerID, "tab=schedules&schedule="+waiting.ID) } { inPage()... }>View schedule</a>
				if a.WaitingCancel {
					@CancelWaitButton(a.ServerID, waiting.ID, waiting.LastSlot)
				}
			</div>
		}
		<p class="section-note activity-filter-count" aria-live="polite">Showing { strconv.Itoa(len(a.Visible)) } of { strconv.Itoa(a.Total) }.</p>
		if a.HiddenActive {
			<p class="section-note activity-filter-notice">
				Work in progress is hidden by these filters. Server controls stay paused until it finishes.
				<a class="text-link" href={ detailURL(a.ServerID, "tab=activity") } { inPage()... }>Show active work</a>
			</p>
		}
		@OperationList(a.Visible, map[bool]string{true: "Nothing matches these filters.", false: "Nothing has happened yet."}[a.Total > 0], false, nil, a.Cancellable)
		if a.Admin && a.AlreadyCurrent {
			<p class="section-note">
				Already up to date. Some games update when they start.
				<a class="text-link" href={ detailURL(a.ServerID, "tab=update&recreate=1") } { inPage()... }>Update anyway</a>
			</p>
		}
	</div>
}

// guidance is what an operation's result tells the owner, starting with
// any restore it finished undoing first.
func guidance(result map[string]any) string {
	text, _ := result["guidance"].(string)
	if undone, _ := result["undone"].(string); undone != "" {
		text = strings.TrimSpace(undone + " " + text)
	}
	return text
}

// SelectedOperation reloads itself while the operation is active.
templ SelectedOperation(a ActivityView) {
	<section
		class="scheduled-operation"
		id="selected-operation"
		aria-labelledby="scheduled-operation-title"
		if a.Selected != nil && ActiveStatus(a.Selected.Status) {
			hx-get={ "/fragments/servers/" + a.ServerID + "/operations/" + a.SelectedID + "?tab=" + a.Tab }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		<div class="section-heading">
			<h2 id="scheduled-operation-title" tabindex="-1">Details</h2>
			// The Backups tab follows running work until it ends.
			if a.Tab != "backups" || a.Selected == nil || !ActiveStatus(a.Selected.Status) {
				<a class="secondary-btn" href={ detailURL(a.ServerID, "tab="+a.Tab) } { inPage()... }>Dismiss</a>
			}
		</div>
		if a.SelectedError != "" {
			<p role="alert">{ a.SelectedError }</p>
		}
		if operation := a.Selected; operation != nil {
			<p><a class="text-link" href={ templ.SafeURL("/activity/" + operation.ID) }>Open on its own page</a></p>
			<dl class="metadata-list">
				<dt>Action</dt>
				<dd>{ Capitalize(operation.Kind) }</dd>
				if item, _ := operation.Input["item"].(string); item != "" && a.Archives {
					<dt>Restored item</dt>
					<dd>{ item }</dd>
				}
				<dt>Status</dt>
				<dd>
					@Pip(OperationTones[operation.Status])
					{ OperationStatusLabels[operation.Status] }
				</dd>
				<dt>When</dt>
				<dd>@Time(operation.CreatedAt, "", "")</dd>
				<dt>Last updated</dt>
				<dd>@Time(operation.UpdatedAt, "", "")</dd>
				if ActiveStatus(operation.Status) {
					<dt>Progress</dt>
					<dd>{ OperationLabel(operation.Status, operation.Phase) }</dd>
				}
			</dl>
			if a.Cancellable[operation.ID] {
				<p class="inline-actions">
					@CancelButton(a.ServerID, operation.ID, operation.Kind, "#detail-status")
				</p>
			}
			if operation.Status == "cancelled" {
				<p class="section-note">{ CancelledNote(a.SelectedCancelledBy) }</p>
			}
			if operation.Error != "" {
				<p class="operation-error">{ operation.Error }</p>
			}
			if detail := SaveDetail(operation.Result); detail != "" {
				<p class="section-note">{ detail }</p>
			}
			if detail := WarnDetail(operation.Result); detail != "" {
				<p class="section-note">{ detail }</p>
			}
			if detail := MovedDetail(operation.Result); detail != "" {
				<p class="section-note">{ detail }</p>
			}
			if detail := LeftOutDetail(operation.Result); detail != "" {
				<p class="section-note">{ detail }</p>
			}
			if detail := DockerWaitDetail(operation.Result); detail != "" {
				<p class="section-note">{ detail }</p>
			}
			if text := guidance(operation.Result); text != "" {
				<p class="section-note">{ text }</p>
			}
			if id := newBackup(operation); id != "" && a.Archives {
				<p class="inline-actions">
					<a class="secondary-btn" href={ templ.SafeURL("/servers/" + a.ServerID + "/backups/" + id + "/download") } download>Download backup</a>
				</p>
			}
		}
	</section>
}

func ActiveStatus(status string) bool { return status == "queued" || status == "running" }

// newBackup is the backup a finished operation made, if any.
func newBackup(operation *ops.Job) string {
	id, _ := operation.Result["backupId"].(string)
	if operation.Status != "succeeded" {
		return ""
	}
	return id
}

// OperationList is a table of operations; showContext adds the server and
// actor column for the history page.
templ OperationList(operations []history.Operation, empty string, showContext bool, serverNames map[string]string, cancellable map[string]bool) {
	<div class="table-scroll">
		<table class="data-table" aria-label={ map[bool]string{true: "Activity", false: "Recent activity"}[showContext] }>
			<thead>
				<tr>
					<th>What</th>
					if showContext {
						<th>Server and who</th>
					}
					<th>When</th>
					<th>Result</th>
				</tr>
			</thead>
			<tbody>
				if len(operations) == 0 {
					<tr><td colspan={ map[bool]string{true: "4", false: "3"}[showContext] } class="muted">{ empty }</td></tr>
				}
				for _, operation := range operations {
					// A stable ID lets a morph keep focus on this row's button.
					<tr id={ "operation-row-" + operation.ID }>
						<td>
							<a class="text-link" href={ templ.SafeURL("/activity/" + operation.ID) }>{ Capitalize(operation.Kind) }</a>
							if !showContext && operation.Actor != nil && operation.Actor.ID == ops.RecoveryActor {
								<p class="muted">By { ActorLabel(operation.Actor) }</p>
							}
						</td>
						if showContext {
							<td class="operation-server">
								<a class="text-link" href={ templ.SafeURL("/servers/" + operation.ServerID) }>
									if name := serverNames[operation.ServerID]; name != "" {
										{ name }
									} else {
										{ operation.ServerID }
									}
								</a>
								<p class="muted">{ ActorLabel(operation.Actor) }</p>
							</td>
						}
						<td>@Time(operation.CreatedAt, "", "")</td>
						<td>
							<span
								if ActiveStatus(operation.Status) {
									role="status"
								}
							>
								@Pip(OperationTones[operation.Status])
								{ OperationLabel(operation.Status, operation.Phase) }
							</span>
							if cancellable[operation.ID] {
								@CancelButton(operation.ServerID, operation.ID, operation.Kind, map[bool]string{true: "#activity-status", false: "#detail-status"}[showContext])
							}
							if operation.Status == "cancelled" {
								<p class="muted">{ CancelledNote(operation.CancelledBy) }</p>
							}
							if operation.Error != "" {
								<p class="operation-error">{ operation.Error }</p>
							}
							if detail := SaveDetail(operation.Result); detail != "" {
								<p class="muted">{ detail }</p>
							}
							if detail := WarnDetail(operation.Result); detail != "" {
								<p class="muted">{ detail }</p>
							}
							if detail := MovedDetail(operation.Result); detail != "" {
								<p class="muted">{ detail }</p>
							}
							if detail := LeftOutDetail(operation.Result); detail != "" {
								<p class="muted">{ detail }</p>
							}
							if detail := DockerWaitDetail(operation.Result); detail != "" {
								<p class="muted">{ detail }</p>
							}
							if text := guidance(operation.Result); text != "" {
								<p class="muted">{ text }</p>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// RecoveryActorLabel names who did an automatic restart, and why, wherever
// Ludock shows who did something.
const RecoveryActorLabel = "Ludock, because the game stopped answering"

func ActorLabel(actor *history.Actor) string {
	switch {
	case actor == nil:
		return "Not recorded"
	case actor.ID == ops.RecoveryActor:
		return RecoveryActorLabel
	case actor.Name != "":
		return actor.Name
	case actor.ID != "":
		return "A deleted user"
	}
	return "Not recorded"
}

// RemoveServer takes a server out of Ludock (administrators only).
templ RemoveServer(server servers.View) {
	<section class="stack-form remove-server" aria-labelledby="remove-server-title">
		<h2 id="remove-server-title">Remove from Ludock</h2>
		if server.Source == servers.SourceLabel {
			<p class="muted">Its <code>ludock.enable: "true"</code> label keeps this server in Ludock. To take it out, set the label to <code>"false"</code> where the container is defined and recreate it.</p>
		} else {
			<p class="muted">Ludock stops managing this server. Nothing changes in Docker, and its sharing, schedules, and backups come back if you add it again from the server list.</p>
			<div>
				<button
					type="button"
					class="secondary-btn secondary-btn--danger"
					hx-post={ "/servers/" + server.ID + "/remove" }
					hx-target="#remove-server-result"
					hx-confirm={ "Remove " + server.DisplayName + " from Ludock?" }
					data-confirm-detail="The container keeps running as it is. You can add it again from the server list."
					data-confirm-action="Remove server"
					data-busy-label="Removing…"
				>Remove from Ludock</button>
			</div>
		}
		<div id="remove-server-result" aria-live="polite"></div>
	</section>
}
