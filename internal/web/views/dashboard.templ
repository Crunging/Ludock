package views

import (
	"encoding/json"
	"slices"
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/attention"
	"github.com/Crunging/Ludock/internal/helper"
	"github.com/Crunging/Ludock/internal/monitor"
	"github.com/Crunging/Ludock/internal/ops"
	"github.com/Crunging/Ludock/internal/selfupdate"
	"github.com/Crunging/Ludock/internal/servers"
)

// ServerRow is one server in the list, with the controls its viewer may use.
type ServerRow struct {
	Server servers.View
	// Removed: an administrator removed the server from Ludock, which keeps
	// it only for its backups.
	Removed    bool
	Address    string
	ShowBackup bool
	// Controls are off while Docker state is unavailable or work is active.
	Disabled       bool
	CanStart       bool
	CanStop        bool
	CanRestart     bool
	CanBackup      bool
	CanFiles       bool
	ConsoleLabel   string // "", "Console", "Logs", or "Shell"
	BackupSummary  bool
	ShowPlayers    bool
	Players        PlayersView
	Game           GameView
	// ImageUpdate: a newer image is available (shown to administrators).
	ImageUpdate bool
	// Down: the server stopped without anyone stopping it, and its outage
	// alert is due.
	Down bool
	// Warn: stopping offers to warn players first.
	Warn bool
	// Online is how many players are on, when Ludock knows.
	Online int
}

// Status is the row's state, naming a server its alert calls down the same way.
func (r ServerRow) Status() Status {
	if r.Removed {
		return Status{"Removed from Ludock", "idle"}
	}
	status := ServerStatus(r.Server.State, r.Server.Health, r.Server.Exit)
	if r.Down && status.Tone != "failed" {
		return Status{"Down", "failed"}
	}
	return status
}

// ConfirmOption is a checkbox in the confirmation dialog.
type ConfirmOption struct {
	Name    string `json:"name"`
	Label   string `json:"label"`
	Help    string `json:"help"`
	Checked bool   `json:"checked"`
}

func confirmOptions(options []ConfirmOption) string {
	encoded, _ := json.Marshal(options)
	return string(encoded)
}

// WarnOption offers to warn players before an action takes the server down.
// Whether anyone is online is decided when the action runs.
var WarnOption = ConfirmOption{Name: "warnPlayers", Label: "Warn players and wait 1 minute", Checked: true,
	Help: "If nobody is online when it’s time to warn, it goes ahead at once."}

// FleetBlock is one server in the strip of state blocks under the title.
type FleetBlock struct{ Name, Label, Tone string }

type ServerList struct {
	// Fleet is every server the viewer can see, whatever the filters.
	Fleet                []FleetBlock
	Rows                 []ServerRow
	Total                int
	Search, State        string
	States               []string
	Admin                bool
	Username             string
	ShowBackup           bool
	// ShowPlayers: some server in the list can list its players.
	ShowPlayers          bool
	DiscoveryUnavailable bool
	// DockerProblem says why Docker can't be used when it isn't a lost connection.
	DockerProblem string
	// AddOpen opens "Missing a server?", as the setup list's link asks.
	AddOpen bool
	// Paused says, for each server shared with a member that a change
	// paused, that it is.
	Paused []string
}

// Pip is a small state marker for a tone: ok, idle, active, attention, or
// failed. It always sits next to a text label.
templ Pip(tone string) {
	<span class={ "marker", "marker--sm", "marker--" + tone } aria-hidden="true"></span>
}

templ StateMark(tone string) {
	<span class={ "marker", "marker--" + tone } aria-hidden="true"></span>
}

templ ServerState(state, health string, exit *servers.Exit) {
	@StatusLabel(ServerStatus(state, health, exit))
}

templ StatusLabel(status Status) {
	<span class={ "server-state", "server-state--" + status.Tone }>
		@Pip(status.Tone)
		{ status.Label }
	</span>
}

// Time renders a timestamp the browser formats locally; relative="sentence"
// or "plain" shows "5 minutes ago".
templ Time(ms int64, relative, class string) {
	<time class={ class } datetime={ ISO(ms) } data-relative={ relative } title={ UTCText(ms) }>{ UTCText(ms) }</time>
}

templ CopyAddress(address, serverName string) {
	<span class="copy-address">
		<code>{ address }</code>
		<button type="button" class="copy-address__button" aria-label={ "Copy address for " + serverName } title="Copy address" data-copy={ address } data-copied-label="✓">
			<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="5.5" y="5.5" width="8" height="8" rx="1"></rect><path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"></path></svg>
		</button>
	</span>
}

// AddServersView lists the containers an administrator can add.
type AddServersView struct {
	Containers []servers.Unmanaged
	// Added is the server just added, if any.
	Added *AddedServer
	Error string
}

type AddedServer struct{ ID, Name string }

// split separates the containers that can be added from the games left out
// because they can control the host.
func (v AddServersView) split() (addable, controlsHost []servers.Unmanaged) {
	for _, container := range v.Containers {
		if container.ControlsHost {
			controlsHost = append(controlsHost, container)
		} else {
			addable = append(addable, container)
		}
	}
	return addable, controlsHost
}

// GameChoice is one game an administrator can pick for a container.
type GameChoice struct{ Type, Name string }

// addServersLoader fetches the list once the page has loaded.
templ addServersLoader() {
	<div id="add-servers" hx-get="/fragments/unmanaged" hx-trigger="load" hx-swap="outerHTML">
		<p class="muted" aria-live="polite">Looking for containers…</p>
	</div>
}

templ AddServers(v AddServersView) {
	<section class="help-panel add-servers" id="add-servers" aria-labelledby="add-servers-title">
		<h2 id="add-servers-title">Add a server</h2>
		<p>
			Ludock adds servers made from <a href="/settings/system" class="text-link">supported game images</a> by itself. Here are the other containers it can see. Adding one changes nothing in Docker, and only administrators see it until you share it from its Sharing tab.
		</p>
		if v.Added != nil {
			<div class="alert alert--success" role="status">
				Added { v.Added.Name }.
				<a class="text-link" href={ templ.SafeURL("/servers/" + v.Added.ID) }>Open it</a>
			</div>
		}
		if v.Error != "" {
			@Alert("error", v.Error)
		}
		{{ addable, controlsHost := v.split() }}
		if len(addable) > 0 {
			<ul class="add-servers__list" aria-label="Containers you can add">
				for _, container := range addable {
					<li class="add-servers__item">
						<div class="add-servers__identity">
							<strong class="add-servers__name">{ container.Name }</strong>
							<code class="add-servers__image">{ container.Image }</code>
							<span class="muted">
								{ ServerStatus(container.State, "", nil).Label }
								if len(container.Ports) > 0 {
									· Ports { portList(container.Ports) }
								} else {
									· No published ports
								}
							</span>
						</div>
						<form class="add-servers__form" hx-post="/servers/add" hx-target="#add-servers" hx-swap="outerHTML">
							<input type="hidden" name="container" value={ container.ID }/>
							<label>
								<span class="sr-only">Game for { container.Name }</span>
								<select name="game">
									for _, game := range GameChoices() {
										<option value={ game.Type } selected?={ game.Type == container.Game }>{ game.Name }</option>
									}
								</select>
							</label>
							<button class="secondary-btn" type="submit" aria-label={ "Add " + container.Name } data-busy-label="Adding…">Add</button>
						</form>
					</li>
				}
			</ul>
		} else if v.Error == "" {
			<p class="muted">No other containers to add.</p>
		}
		if len(controlsHost) > 0 {
			<div class="add-servers__host" id="add-servers-host">
				<h3>Not added because they can control the host</h3>
				<p class="muted">
					These look like game servers, but each one is privileged or can reach Docker or the host’s system folders. Whoever uses its console or files could take over this whole machine, so Ludock doesn’t add it by itself and can’t add it from here.
					If it really is a game server, add the label <code>ludock.enable: "true"</code> where it is defined and recreate it. Better still, remove the access it doesn’t need.
				</p>
				<ul class="add-servers__list" aria-label="Containers that can control the host">
					for _, container := range controlsHost {
						<li class="add-servers__item">
							<div class="add-servers__identity">
								<strong class="add-servers__name">{ container.Name }</strong>
								<code class="add-servers__image">{ container.Image }</code>
								<span class="muted">{ ServerStatus(container.State, "", nil).Label } · Can control the host</span>
							</div>
						</li>
					}
				</ul>
			</div>
		}
		<p class="muted add-servers__note">
			Not listed? <a class="text-link" href="https://github.com/Crunging/Ludock/blob/main/docs/REFERENCE.md#which-containers-ludock-manages" target="_blank" rel="noreferrer">See why</a>
		</p>
	</section>
}

templ Dashboard(page Page, list ServerList) {
	@Shell(page) {
		<div class="page dashboard-page" hx-sse:connect="/events" hx-trigger="load, live-retry" hx-swap="none">
			<div class="page__header page__header--actions">
				<div>
					<h1 class="page__title">Servers</h1>
					if !page.Admin {
						<p class="page__subtitle">Servers shared with your account.</p>
					}
					@fleet(list)
				</div>
			</div>
			<div id="action-error" aria-live="polite"></div>
			<div class="server-connection" role="status" data-live-status hidden>
				<div>
					<p>Live updates are disconnected.</p>
					<p class="muted">Showing the last known state. Ludock reconnects automatically.</p>
				</div>
			</div>
			<div id="attention" hx-get="/fragments/attention" hx-trigger="load, server from:document delay:500ms, servers-changed from:document delay:500ms" hx-swap="innerHTML"></div>
			if page.Admin {
				<div id="checklist" hx-get="/fragments/checklist" hx-trigger="load, servers-changed from:document delay:500ms, refresh from:document delay:500ms" hx-swap="innerHTML"></div>
			}
			@serverFilters(list)
			// Refreshes carry the current filters, which stay outside the swap
			// so typing is never interrupted. Outside requests queue behind the
			// list's own, so the newest filters win; controls inside must not
			// inherit that.
			<div id="servers" hx-get="/fragments/servers" hx-include="#server-filters" hx-trigger="server from:document delay:300ms, servers-changed from:document, every 60s" hx-swap="innerMorph">
				@ServerListFragment(list)
			</div>
			if page.Admin {
				<div class="dashboard-help">
					<details id="missing-server" open?={ list.Total == 0 || list.AddOpen }>
						<summary class="text-link">Missing a server?</summary>
						@addServersLoader()
					</details>
				</div>
			}
		</div>
	}
}

var toneOrder = map[string]int{"failed": 0, "attention": 1, "active": 2, "ok": 3, "idle": 4}

// fleetSummary counts the servers in each state, problems first:
// "1 crashed, 2 running, 1 stopped".
func fleetSummary(blocks []FleetBlock) string {
	counts := map[string]int{}
	var labels []FleetBlock
	for _, block := range blocks {
		if counts[block.Label] == 0 {
			labels = append(labels, block)
		}
		counts[block.Label]++
	}
	slices.SortStableFunc(labels, func(a, b FleetBlock) int { return toneOrder[a.Tone] - toneOrder[b.Tone] })
	parts := make([]string, len(labels))
	for index, block := range labels {
		parts[index] = strconv.Itoa(counts[block.Label]) + " " + strings.ToLower(block.Label)
	}
	return strings.Join(parts, ", ")
}

// fleet draws one state block per server, like the Ludock mark, with the
// count of each state beside it.
templ fleet(list ServerList) {
	<p class="fleet" id="fleet">
		if len(list.Fleet) > 0 {
			<span class="fleet__blocks" aria-hidden="true">
				for _, block := range list.Fleet {
					<span class={ "marker", "marker--" + block.Tone } title={ block.Name + ": " + block.Label }></span>
				}
			</span>
			<span class="fleet__summary">{ fleetSummary(list.Fleet) }</span>
		}
	</p>
}

// filterAt is the number of servers worth a search box and state filter;
// fewer fit at a glance.
const filterAt = 8

// filterable is a list long enough to filter, or already filtered.
func (list ServerList) filterable() bool {
	return list.Total >= filterAt || list.Search != "" || (list.State != "" && list.State != "all")
}

// serverFilters narrows the list. Without scripts it submits to the page;
// the page hides it unless the list it shows is filterable.
templ serverFilters(list ServerList) {
	<form
		class="list-toolbar"
		id="server-filters" role="search" aria-label="Filter servers" method="get" action="/" hx-get="/fragments/servers" hx-target="#servers" hx-swap="innerMorph" hx-sync="#servers:queue last" hx-trigger="submit, input changed delay:250ms target:input">
		<label class="search-field">
			<span class="sr-only">Find a server</span>
			<input name="search" value={ list.Search } placeholder="Find a server…" type="search"/>
		</label>
		<label class="state-filter">
			<span>State</span>
			@stateSelect(list)
		</label>
		@serverCount(list)
	</form>
}

// stateSelect is replaced whole when the states change: moving options
// into a live select one at a time would change its selection. A choice
// submits the form, which stays in place, so a refresh replacing the select
// can't drop the request.
templ stateSelect(list ServerList) {
	<select name="state" id="server-state" data-autosubmit>
		<option value="all">All states</option>
		for _, state := range list.States {
			<option value={ state } selected?={ list.State == state }>{ ServerStatus(state, "", nil).Label }</option>
		}
	</select>
}

templ serverCount(list ServerList) {
	<span class="list-toolbar__count muted" id="server-count" role="status">{ strconv.Itoa(len(list.Rows)) } of { strconv.Itoa(list.Total) } servers</span>
}

// ServerListResponse is a list refresh: the rows, plus the fleet strip, the
// filter count, and the state choices, which leave the search box in place.
templ ServerListResponse(list ServerList) {
	@ServerListFragment(list)
	@Partial("#fleet", "outerMorph") {
		@fleet(list)
	}
	@Partial("#server-count", "outerHTML") {
		@serverCount(list)
	}
	@Partial("#server-state", "outerHTML") {
		@stateSelect(list)
	}
}

templ ServerListFragment(list ServerList) {
	if list.DiscoveryUnavailable {
		<div class="server-connection" role="status">
			<div>
				<p>{ dockerOutage(list.DockerProblem, "Ludock can’t reach Docker right now.") }</p>
				if list.DockerProblem != "" {
					<p class="muted">Showing the last known state.</p>
				} else {
					<p class="muted">Showing the last known state. Server controls come back once it can.</p>
				}
			</div>
			if list.Admin {
				<a class="secondary-btn" href="/settings/system">Check the connection</a>
			}
		</div>
	}
	for _, paused := range list.Paused {
		<p class="section-note server-paused" role="status">{ paused }</p>
	}
	if list.Total > 0 {
		<section class={ "server-list", templ.KV("server-list--backups", list.ShowBackup), templ.KV("server-list--players", list.ShowPlayers), templ.KV("server-list--filterable", list.filterable()) } aria-label="Game servers">
			<div class="server-list__header">
				<span>Server</span>
				<span>State</span>
				if list.ShowPlayers {
					<span>Players</span>
				}
				<span>Connect</span>
				if list.ShowBackup {
					<span>Last backup</span>
				}
				<span><span class="sr-only">Actions</span></span>
			</div>
			for _, row := range list.Rows {
				@ServerCard(row)
			}
			if len(list.Rows) == 0 {
				<div class="server-list__empty">
					<p>No servers match your filters.</p>
					<button type="button" class="text-link" data-clear-filters="server-filters">Clear filters</button>
				</div>
			}
		</section>
	} else if !list.DiscoveryUnavailable && len(list.Paused) == 0 {
		<div class="empty-state">
			if list.Admin {
				<h2 class="empty-state__title">No game servers found</h2>
				<p class="empty-state__description">Ludock looks for game containers on the Docker host it’s connected to.</p>
				<a href="/settings/system" class="secondary-btn dashboard-empty-action">Check the Docker connection</a>
			} else {
				<h2 class="empty-state__title">No servers shared with you yet</h2>
				<p class="empty-state__description">You’re signed in as { list.Username }. Ask an administrator to share the servers you need.</p>
			}
		</div>
	}
}

func rowClass(row ServerRow) string {
	class := "server-row"
	if LifecycleAction(row.Server.State) == "start" {
		class += " server-row--stopped"
	}
	if row.Status().Tone == "failed" {
		class += " server-row--failed"
	}
	return class
}

templ ServerCard(row ServerRow) {
	{{ server := row.Server }}
	<article class={ rowClass(row) } aria-labelledby={ "server-" + server.ID }>
		@StateMark(row.Status().Tone)
		<div class="server-row__identity">
			<a class="server-row__name" id={ "server-" + server.ID } href={ templ.SafeURL("/servers/" + server.ID) }>{ server.DisplayName }</a>
			<span class="server-row__game">{ server.GameName }</span>
			// A server without exactly one container has no Docker state of its own.
			if guidance := StateGuidance(server.State, row.CanStop); guidance != "" && BindingNote(string(server.BindingStatus)) == "" {
				<p class="server-row__note">{ guidance }</p>
			}
			if note := BindingNote(string(server.BindingStatus)); note != "" {
				<p class="server-row__warning">{ note }</p>
			} else if server.SharingPaused {
				<p class="server-row__note">Changed in Docker. Sharing is paused until you confirm.</p>
			}
			if row.ImageUpdate {
				<p class="server-row__update"><a class="text-link" href={ detailURL(server.ID, "tab=update") }>Update available</a></p>
			}
		</div>
		<div class="server-row__state">
			@StatusLabel(row.Status())
			if operation := server.ActiveOperation; operation != nil {
				<span role="status">
					<a class="text-link" href={ templ.SafeURL(OperationPath(server.ID, operation.Kind, operation.ID)) }>{ Capitalize(operation.Kind) }: { OperationLabel(operation.Status, operation.Phase) }</a>
				</span>
				if CanCancelActive(server) {
					@CancelButton(server.ID, operation.ID, operation.Kind, "#action-error")
				}
			}
			if server.StateSince != 0 {
				if server.State == "running" {
					<span class="server-row__since">Started @Time(server.StateSince, "plain", "")</span>
				} else {
					@Time(server.StateSince, "sentence", "server-row__since")
				}
			}
		</div>
		// Players, address, and last backup share a line on phones; elsewhere
		// they are columns of the list.
		<div class="server-row__facts">
			if row.ShowPlayers {
				@PlayersCell(row.Players)
			}
			<div class="server-row__address">
				<span class="server-row__label">Connect</span>
				if row.Address != "" {
					@CopyAddress(row.Address, server.DisplayName)
				} else {
					<span class="muted">No public port</span>
				}
			</div>
			if row.ShowBackup {
				<div class="server-row__backup">
					<span class="server-row__label">Last backup</span>
					if !row.BackupSummary {
						<span class="muted">—</span>
					} else if server.LatestBackup != nil {
						@Time(server.LatestBackup.CreatedAt, "sentence", "")
						if note := SafetyNote(server.LatestBackup.Reason); note != "" {
							<small class="muted">{ note }</small>
						}
					} else if server.NoDataFolders || server.Refuses(ops.KindBackup) {
						<span class="muted">—<span class="sr-only">Can’t be backed up</span></span>
					} else {
						<span class="server-row__never">Never</span>
					}
				</div>
			}
		</div>
		<div class="server-row__actions">
			if row.ConsoleLabel != "" {
				<a class={ "secondary-btn", templ.KV("secondary-btn--accent", !row.CanStart) } href={ templ.SafeURL("/console/" + server.ID) }>{ row.ConsoleLabel }</a>
			}
			if row.CanStart {
				<button class="secondary-btn secondary-btn--accent" type="button" disabled?={ row.Disabled } hx-post={ "/servers/" + server.ID + "/start" } hx-target="#action-error" data-busy-label="Working…">Start</button>
			}
			if row.CanStop {
				<button class="secondary-btn secondary-btn--danger" type="button" disabled?={ row.Disabled } hx-post={ "/servers/" + server.ID + "/stop" } hx-target="#action-error" data-busy-label="Working…" { LifecycleConfirm("stop", server.DisplayName, false, row.Warn, row.Online)... }>Stop</button>
			}
			if row.CanFiles || row.CanRestart {
				<div class="action-menu" data-action-menu>
					<button type="button" class="secondary-btn action-menu__trigger" aria-label={ "More actions for " + server.DisplayName } aria-expanded="false" aria-controls={ "actions-" + server.ID }>
						More
						<svg class="chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5"></path></svg>
					</button>
					<div class="action-menu__content" id={ "actions-" + server.ID } hidden>
						if row.CanFiles {
							<a class="action-menu__action" href={ templ.SafeURL("/files/" + server.ID) }>Files</a>
						}
						if row.CanRestart {
							<button type="button" class="action-menu__action" disabled?={ row.Disabled } hx-post={ "/servers/" + server.ID + "/restart" } hx-target="#action-error" { LifecycleConfirm("restart", server.DisplayName, row.CanBackup, row.Warn, row.Online)... }>Restart…</button>
						}
					</div>
				</div>
			}
		</div>
	</article>
}

// OnlineNote says how many players taking a server down disconnects, or ""
// when Ludock knows of none.
func OnlineNote(online int) string {
	switch {
	case online == 1:
		return "1 player is online and will be disconnected."
	case online > 1:
		return strconv.Itoa(online) + " players are online and will be disconnected."
	}
	return ""
}

// UndoRestoreDetail says what undoing a restore that stopped partway does.
// It is the one data operation that stops a server another manager started.
func UndoRestoreDetail(operationID string) string {
	return "Ludock stops the server, even though it was started outside Ludock, warning players a minute ahead if anyone is online and the game can. " +
		"It puts the server’s previous data back and starts the server again if it was running. " +
		"Anything in its way, including what the game made since, moves to the folder " + helper.SetAsideName(operationID) + " in the data folder: nothing the game wrote is deleted."
}

// DisconnectNote says taking a running server down disconnects whoever is
// on, without a number: for tabs that don't follow the player count, where
// one would go stale.
func DisconnectNote(running bool) string {
	if running {
		return "Connected players will be disconnected."
	}
	return ""
}

// LifecycleConfirm asks in the page's confirmation dialog before a stop or
// restart. It can offer to warn players first, and a restart to take a
// backup first.
func LifecycleConfirm(action, serverName string, backupOption, warn bool, online int) templ.Attributes {
	label := map[string]string{"stop": "Stop", "restart": "Restart"}[action]
	detail := OnlineNote(online)
	if detail == "" {
		detail = "Connected players will be disconnected."
	}
	if action == "stop" {
		detail += " The server will remain stopped until started again."
	}
	attributes := templ.Attributes{"hx-confirm": label + " " + serverName + "?", "data-confirm-detail": detail,
		"data-confirm-action": label + " server", "data-confirm-danger": true}
	var options []ConfirmOption
	if warn {
		options = append(options, WarnOption)
	}
	if backupOption {
		options = append(options, ConfirmOption{Name: "createBackup", Label: "Back up first",
			Help: "The server stays stopped while the backup runs, then starts again. If the backup fails, it stays stopped."})
	}
	if len(options) > 0 {
		attributes["data-confirm-options"] = confirmOptions(options)
	}
	return attributes
}

type AttentionView struct {
	Items                []attention.Item
	DiscoveryUnavailable bool
	DockerProblem        string
	Admin        bool
	Error        string
	// TakeOvers are the moves offered for missing servers, by server ID.
	TakeOvers map[string]*TakeOver
}

var scheduleReasons = map[string]string{
	"owner_missing":         "The schedule owner no longer exists.",
	"owner_disabled":        "The schedule owner’s account is disabled.",
	"owner_access_removed":  "The owner no longer has schedule access.",
	"action_access_removed": "The owner no longer has access to this action.",
	"sharing_paused":        "Waiting for an administrator to confirm the server’s change.",
	"binding_unavailable":   "Ludock can’t find the server in Docker.",
	"unavailable":           "Review the schedule settings and server state.",
}

type attentionText struct{ Title, Link, Action string }

func describeAttention(item attention.Item) attentionText {
	path := "/servers/" + item.ServerID
	switch item.Kind {
	case "notifications":
		return attentionText{"Alerts aren’t reaching " + item.Destination.Label(), DestinationURL(item.Destination), "Check " + item.Destination.Label()}
	case "ludock":
		if item.Unchanged {
			return attentionText{"Ludock couldn’t update itself", "/settings", "Open Settings"}
		}
		return attentionText{"Ludock’s update didn’t finish", "/settings", "Open Settings"}
	case "operation":
		title := Capitalize(item.OperationKind) + " " + item.Status
		if item.Undone {
			title += ", then undone"
		}
		if item.ForceStopped {
			title = "Force-stopped; recent progress may be lost"
		}
		return attentionText{title, path + "?tab=activity&operation=" + item.OperationID, "Review activity"}
	case "restore":
		if item.UndoBlocked {
			return attentionText{"Restore stopped partway", path, "Review server"}
		}
		return attentionText{"Restore stopped partway", path + "?tab=activity&operation=" + item.OperationID, "Review activity"}
	case "schedule":
		return attentionText{ActionLabel(item.Action) + " schedule suspended", path + "?tab=schedules&schedule=" + item.ScheduleID, "Review schedule"}
	case "binding":
		title := "Server missing in Docker"
		if item.BindingStatus == "ambiguous" {
			title = "More than one container for this server"
		}
		return attentionText{title, path, "Review server"}
	case "sharing":
		return attentionText{"Server changed", path, "Confirm the change"}
	case "disk":
		return attentionText{"Disk nearly full", path + "?tab=overview", "Check disk space"}
	case "memory":
		return attentionText{"Memory near its limit", path + "?tab=overview", "Check memory"}
	}
	title := "Server down"
	if item.State == "docker_unavailable" {
		title = "Can’t check the server"
	} else if item.State == monitor.NotAnswering {
		title = "Game not answering"
	}
	return attentionText{title, path + "?tab=overview", "Check availability"}
}

// renamedTo is the move offered for a missing server Ludock found again
// under another name, or nil.
func renamedTo(view AttentionView, item attention.Item) *TakeOver {
	if move := view.TakeOvers[item.ServerID]; item.Kind == "binding" && move != nil && move.Likely != nil && !view.DiscoveryUnavailable {
		return move
	}
	return nil
}

// attentionSubject is what an item is about: its server, or notifications.
func attentionSubject(item attention.Item) string {
	switch item.Kind {
	case "notifications":
		return "Notifications"
	case "ludock":
		return "Ludock"
	}
	return item.ServerName
}

templ attentionDetail(item attention.Item) {
	switch item.Kind {
		case "notifications":
			<span class="muted">Last tried @Time(item.Since, "", "")<span>.</span> { item.Reason }</span>
		case "ludock":
			<span class="muted">
				@Time(item.Since, "", "")
				if item.Interrupted && item.Finished {
					<span>· It was cut off partway, and nothing is left to do. Settings says which version runs.</span>
				} else if item.Interrupted {
					<span>· It stopped partway. Settings says how to finish it from a terminal.</span>
				} else {
					<span>· { Capitalize(strings.TrimSuffix(item.Reason, ".")) }. Ludock is still on version { item.Version }.</span>
					switch item.Data {
						case selfupdate.DataKept:
							<span>It found no copy of its data to put back, so it kept the newer data.</span>
						case selfupdate.DataNotRestored:
							<span>It couldn’t put the copy of its data from before the update back, so it runs on the newer data. The copy, { selfupdate.CopyName }, is beside its database.</span>
					}
					<span>Try again later. If it keeps failing, <a href="https://github.com/Crunging/Ludock/issues">report it</a>.</span>
				}
			</span>
		case "operation":
			<span class="muted">
				Started @Time(item.StartedAt, "", "")
				if item.Recovery {
					<span>· By { RecoveryActorLabel }</span>
				}
			</span>
		case "restore":
			if item.UndoBlocked {
				<span class="muted">The restore of { item.ServerName } stopped partway, and its data folders or game changed since. Put them back as they were where the server is defined, then undo the restore.</span>
			} else {
				<span class="muted">The restore of { item.ServerName } was stopped partway. Its previous data is safe but not in place: undo the restore to put it back.</span>
			}
		case "schedule":
			<span class="muted">{ scheduleReasons[item.Reason] }</span>
		case "disk":
			<span class="muted">
				if item.Path != "" {
					<code>{ item.Path }</code>
				} else {
					A data folder
				}
				is { WholePercent(item.Percent) } full, since @Time(item.Since, "", "")<span>.</span>
			</span>
		case "memory":
			<span class="muted">Over { WholePercent(item.Percent) } of its memory limit since @Time(item.Since, "", "")<span>.</span></span>
		case "binding":
			<span class="muted">Check it with the tool that runs it, such as Compose or Portainer, then refresh.</span>
		case "sharing":
			<span class="muted">Its game or data folders changed. People you shared it with can’t use it until you confirm.</span>
		default:
			if item.State == "docker_unavailable" {
				<span class="muted">Ludock can’t reach Docker.</span>
			} else if item.State == monitor.NotAnswering {
				<span class="muted">Not answering since @Time(item.OutageStartedAt, "", "")<span>.</span></span>
			} else {
				<span class="muted">Down since @Time(item.OutageStartedAt, "", "")<span>.</span></span>
			}
	}
}

// NeedsAttention shows nothing while nothing needs attention.
templ NeedsAttention(view AttentionView) {
	if len(view.Items) > 0 || view.DiscoveryUnavailable || view.Error != "" {
		@needsAttention(view)
	}
}

templ needsAttention(view AttentionView) {
	<section class="needs-attention" aria-labelledby="needs-attention-title">
		<div class="needs-attention__heading">
			<h2 id="needs-attention-title">Needs attention</h2>
			if len(view.Items) > 0 {
				<span class="muted">{ strconv.Itoa(len(view.Items)) } { map[bool]string{true: "item", false: "items"}[len(view.Items) == 1] }</span>
			}
		</div>
		if view.Error != "" {
			<div class="needs-attention__error" role="alert">
				<p>{ view.Error }</p>
				<button class="secondary-btn" type="button" hx-get="/fragments/attention" hx-target="#attention">Check again</button>
			</div>
		}
		if view.DiscoveryUnavailable {
			<p class="needs-attention__warning">
				if view.DockerProblem != "" {
					{ view.DockerProblem } These come from the last known state.
				} else {
					Ludock can’t reach Docker, so these come from the last known state.
				}
				if view.Admin {
					<a href="/settings/system" class="text-link">Check the connection</a>
				}
			</p>
		}
		if len(view.Items) == 0 && view.Error == "" {
			<p class="muted">Nothing in the last known state.</p>
		}
		if len(view.Items) > 0 {
			<ul class="needs-attention__list" data-collapse-after="10">
				for _, item := range view.Items {
					{{ info := describeAttention(item) }}
					{{ move := renamedTo(view, item) }}
					<li>
						<div class="needs-attention__description">
							<span class="needs-attention__server">{ attentionSubject(item) }</span>
							if move != nil {
								<strong>Looks like it was renamed to { move.Likely.Name }</strong>
								<span class="muted">Move its backups, schedules, and sharing there?</span>
							} else {
								<strong>{ info.Title }</strong>
								@attentionDetail(item)
							}
						</div>
						if move != nil {
							<form class="needs-attention__actions" hx-post={ "/servers/" + item.ServerID + "/take-over" } hx-target="#action-error" { takeOverConfirm(*move, move.Likely.Name)... }>
								<input type="hidden" name="to" value={ move.Likely.ID }/>
								<input type="hidden" name="bindingRevision" value={ int64Text(move.Likely.Revision) }/>
								<button class="secondary-btn secondary-btn--accent" type="submit" data-busy-label="Moving…" aria-label={ "Move them from " + item.ServerName + " to " + move.Likely.Name }>Move them</button>
								<a href={ templ.SafeURL(info.Link) } class="text-link" aria-label={ "Details: " + item.ServerName }>Details</a>
							</form>
						} else if item.CanStart && !view.DiscoveryUnavailable {
							<div class="needs-attention__actions">
								<button class="secondary-btn secondary-btn--accent" type="button" hx-post={ "/servers/" + item.ServerID + "/start" } hx-target="#action-error" data-busy-label="Working…" aria-label={ "Start " + item.ServerName }>Start</button>
								<a href={ templ.SafeURL(info.Link) } class="text-link" aria-label={ "Details: " + item.ServerName + ", " + info.Title }>Details</a>
							</div>
						} else if item.Kind == "restore" && !view.DiscoveryUnavailable && !item.UndoBlocked {
							<div class="needs-attention__actions">
								<button
									class="secondary-btn secondary-btn--accent"
									type="button"
									hx-post={ "/servers/" + item.ServerID + "/restores/undo" }
									hx-target="#action-error"
									hx-confirm={ "Undo the restore of " + item.ServerName + "?" }
									data-confirm-detail={ UndoRestoreDetail(item.OperationID) }
									data-confirm-action="Undo the restore"
									data-busy-label="Working…"
								>Undo the restore</button>
								<a href={ templ.SafeURL(info.Link) } class="text-link" aria-label={ "Details: " + item.ServerName + ", " + info.Title }>Details</a>
							</div>
						} else {
							<a href={ templ.SafeURL(info.Link) } class="text-link needs-attention__action" aria-label={ info.Action + ": " + attentionSubject(item) + ", " + info.Title }>{ info.Action }</a>
						}
					</li>
				}
			</ul>
		}
	</section>
}
