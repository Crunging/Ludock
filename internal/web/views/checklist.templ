package views

import (
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/monitor"
)

const (
	ChecklistAlerts    = "alerts"
	ChecklistBackups   = "backups"
	ChecklistRecovery  = "recovery"
	ChecklistAddress   = "address"
	ChecklistServers   = "servers"
	ChecklistTwoFactor = "two-factor"
)

// ChecklistItem is one thing left to set up.
type ChecklistItem struct {
	Key string
	// Names are the servers or containers the item is about; IDs are the
	// servers its one-click action is confirmed for.
	Names, IDs []string
	// Host is the address players are shown; Loopback when only this
	// computer can use it.
	Host     string
	Loopback bool
}

type ChecklistView struct {
	Items         []ChecklistItem
	Notice, Error string
}

// NameList joins up to three names: "A, B, and 2 others".
func NameList(names []string) string {
	shown := names
	if len(names) > 3 {
		shown = names[:2]
	}
	text := strings.Join(shown, ", ")
	switch rest := len(names) - len(shown); {
	case rest > 0:
		text += ", and " + strconv.Itoa(rest) + " others"
	case len(shown) == 2:
		text = shown[0] + " and " + shown[1]
	case len(shown) == 3:
		text = shown[0] + ", " + shown[1] + ", and " + shown[2]
	}
	return text
}

func checklistTitle(key string) string {
	return map[string]string{
		ChecklistAlerts:    "Get alerts",
		ChecklistBackups:   "Back up your servers",
		ChecklistRecovery:  "Restart servers that stop answering",
		ChecklistAddress:   "Check the address players use",
		ChecklistServers:   "Add the servers Ludock didn’t find",
		ChecklistTwoFactor: "Protect your sign-in",
	}[key]
}

func backupConfirm(count int) templ.Attributes {
	question, when := "Back up "+strconv.Itoa(count)+" servers every night?", "between 04:00 and 06:00 your time, a few minutes apart so they don’t stop together"
	if count == 1 {
		question, when = "Back up this server every night?", "between 04:00 and 06:00 your time"
	}
	return templ.Attributes{
		"hx-confirm": question,
		"data-confirm-detail": "Each backup stops its server for a few minutes, disconnecting anyone playing, then starts it again. " +
			"Backups run " + when + ". Change or remove them on each server’s Schedules tab.",
		"data-confirm-action": "Back up every night",
	}
}

func recoveryConfirm(count int) templ.Attributes {
	question := "Restart these " + strconv.Itoa(count) + " servers if their game stops answering?"
	if count == 1 {
		question = "Restart this server if its game stops answering?"
	}
	return templ.Attributes{
		"hx-confirm": question,
		"data-confirm-detail": "When a running game stops answering for a few minutes, Ludock restarts it the way the Restart button does, at most " +
			strconv.Itoa(monitor.RecoveryAttempts) + " times in 6 hours. Turn it off on each server’s Overview.",
		"data-confirm-action": "Turn on automatic restart",
	}
}

// Checklist is the "Finish setting up" list; it renders nothing once every
// item is done or dismissed.
templ Checklist(v ChecklistView) {
	if len(v.Items) > 0 || v.Notice != "" || v.Error != "" {
		<section class="checklist" aria-labelledby="checklist-title">
			<h2 id="checklist-title" class="checklist__title">Finish setting up</h2>
			if v.Notice != "" {
				@Alert("success", v.Notice)
			}
			if v.Error != "" {
				@Alert("error", v.Error)
			}
			if len(v.Items) > 0 {
				<ul class="checklist__list">
					for _, item := range v.Items {
						<li class={ "checklist__item", templ.KV("checklist__item--quiet", item.Key == ChecklistTwoFactor) }>
							<div class="checklist__text">
								<strong>{ checklistTitle(item.Key) }</strong>
								<span class="muted">
									@checklistDetail(item)
								</span>
							</div>
							<div class="checklist__actions">
								@checklistAction(item)
								<button type="button" class="text-link checklist__dismiss" hx-post={ "/checklist/" + item.Key + "/dismiss" } hx-target="#checklist" aria-label={ "Dismiss: " + checklistTitle(item.Key) }>Dismiss</button>
							</div>
						</li>
					}
				</ul>
			}
		</section>
	}
}

templ checklistDetail(item ChecklistItem) {
	switch item.Key {
		case ChecklistAlerts:
			Ludock already monitors your servers for crashes, games that stop answering, and full disks, but no notification is on, so no one hears about them.
		case ChecklistBackups:
			{ NameList(item.Names) }
			if len(item.Names) == 1 {
				has no scheduled backup.
			} else {
				have no scheduled backups.
			}
		case ChecklistAddress:
			Players are shown <code>{ item.Host }</code>, which
			if item.Loopback {
				only works on this computer.
			} else {
				only works on your own network.
			}
			Friends elsewhere need your public address or domain.
		case ChecklistRecovery:
			{ NameList(item.Names) }
			if len(item.Names) == 1 {
				stays down if its game stops answering, until someone restarts it.
			} else {
				stay down if their game stops answering, until someone restarts them.
			}
		case ChecklistServers:
			{ NameList(item.Names) }
			if len(item.Names) == 1 {
				looks like a game server, but Ludock isn’t managing it.
			} else {
				look like game servers, but Ludock isn’t managing them.
			}
		case ChecklistTwoFactor:
			Optional: ask for a code from an authenticator app when you sign in.
	}
}

templ checklistAction(item ChecklistItem) {
	switch item.Key {
		case ChecklistAlerts:
			<a class="secondary-btn" href="/settings#notification-settings-title">Set up notifications</a>
		case ChecklistBackups:
			<form id="checklist-backups" hidden>
				<input type="hidden" name="timezone" data-default-local-timezone/>
				for _, id := range item.IDs {
					<input type="hidden" name="server" value={ id }/>
				}
			</form>
			<button class="secondary-btn" type="button" hx-post="/checklist/backups" hx-include="#checklist-backups" hx-target="#checklist" data-busy-label="Scheduling…" { backupConfirm(len(item.Names))... }>Back up every night</button>
		case ChecklistRecovery:
			<form id="checklist-recovery" hidden>
				for _, id := range item.IDs {
					<input type="hidden" name="server" value={ id }/>
				}
			</form>
			<button class="secondary-btn" type="button" hx-post="/checklist/recovery" hx-include="#checklist-recovery" hx-target="#checklist" data-busy-label="Turning on…" { recoveryConfirm(len(item.Names))... }>Restart automatically</button>
		case ChecklistAddress:
			<a class="secondary-btn" href="/settings#connection-settings-title">Set the address</a>
		case ChecklistServers:
			<a class="secondary-btn" href="/?add=1#missing-server">Review containers</a>
		case ChecklistTwoFactor:
			<a class="secondary-btn" href="/account#two-factor">Set up two-factor</a>
	}
}
