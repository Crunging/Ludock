package views

import (
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/auth"
	"github.com/Crunging/Ludock/internal/db"
)

type AccountView struct {
	TwoFactor TwoFactorView
	Sessions  []db.Session
	// SessionsError replaces the list when it could not load.
	SessionsError string
	Error         string
	Message       string
}

templ AccountPage(page Page, view AccountView) {
	@Shell(page) {
		<div class="page">
			<div class="page__header">
				<h1 class="page__title">Account</h1>
				<p class="page__subtitle">Change your password, protect sign-in with an authenticator app, and review signed-in devices.</p>
			</div>
			@AccountStatus(view)
			<form class="settings-card" method="post" action="/account/password">
				<input type="hidden" name="_csrf" value={ page.CSRF }/>
				<h2>Change password</h2>
				<div class="form-grid form-grid--password">
					<label>
						<span>Current password</span>
						<input type="password" name="currentPassword" autocomplete="current-password" maxlength="128" required/>
					</label>
					<label>
						<span>New password</span>
						<input type="password" name="newPassword" autocomplete="new-password" minlength={ strconv.Itoa(passwordMin) } maxlength="128" required/>
					</label>
					<label>
						<span>Confirm new password</span>
						<input type="password" name="confirmPassword" autocomplete="new-password" minlength={ strconv.Itoa(passwordMin) } maxlength="128" required/>
					</label>
					<button class="primary-btn" type="submit" data-busy-label="Working…">Change password</button>
				</div>
			</form>
			@twoFactorSection(page, view.TwoFactor)
			<section class="settings-section" id="sessions">
				@AccountSessions(view)
			</section>
		</div>
	}
}

// AccountStatus shows the page's result.
templ AccountStatus(view AccountView) {
	<div id="account-status" aria-live="polite">
		if view.Error != "" {
			@Alert("error", view.Error)
		}
		if view.Message != "" {
			@Alert("success", view.Message)
		}
	</div>
}

// AccountStatusUpdate replaces the page's result from a fragment.
templ AccountStatusUpdate(view AccountView) {
	@Partial("#account-status", "outerHTML") {
		@AccountStatus(view)
	}
}

templ AccountSessions(view AccountView) {
	<div class="section-heading">
		<h2>Active sessions</h2>
		<button class="secondary-btn" type="button" hx-get="/fragments/account/sessions" hx-target="#sessions" data-busy-label="Refreshing…">Refresh sessions</button>
	</div>
	if view.SessionsError != "" {
		<div class="alert alert--error" role="alert">Unable to load sessions: { view.SessionsError }</div>
	} else if len(view.Sessions) == 0 {
		<p class="muted">No active sessions.</p>
	}
	<div class="settings-list">
		for _, session := range view.Sessions {
			<article class="settings-card session-row">
				<div>
					<strong>
						if session.Current {
							This device
						} else if session.IPAddress != "" {
							{ session.IPAddress }
						} else {
							Unknown address
						}
					</strong>
					<span title={ session.UserAgent }>{ BrowserName(session.UserAgent) }</span>
					<span>Last active @Time(session.LastSeenAt, "", "")</span>
				</div>
				<button class="secondary-btn secondary-btn--danger" type="button" hx-post={ "/account/sessions/" + session.ID + "/revoke" } hx-target="#sessions" data-busy-label="Working…">
					if session.Current {
						Sign out
					} else {
						Revoke
					}
				</button>
			</article>
		}
	</div>
}

type TwoFactorView struct {
	On           bool
	RecoveryLeft int
	// Enrollment is a secret being set up; it is shown only until confirmed.
	Enrollment *auth.Enrollment
	// RecoveryCodes are shown once, right after two-factor sign-in turns on.
	RecoveryCodes []string
}

// groupSecret splits a base32 secret into groups of four for typing.
func groupSecret(secret string) string {
	var groups []string
	for len(secret) > 4 {
		groups = append(groups, secret[:4])
		secret = secret[4:]
	}
	return strings.Join(append(groups, secret), " ")
}

templ twoFactorSection(page Page, view TwoFactorView) {
	<section class="settings-card two-factor" id="two-factor" aria-labelledby="two-factor-title">
		<h2 id="two-factor-title">Two-factor sign-in</h2>
		if len(view.RecoveryCodes) > 0 {
			<p>Save these recovery codes somewhere safe, such as a password manager. Each one works once in place of a code if you lose your phone. They won’t be shown again.</p>
			<ul class="recovery-codes" aria-label="Recovery codes">
				for _, code := range view.RecoveryCodes {
					<li><code>{ code }</code></li>
				}
			</ul>
		} else if view.Enrollment != nil {
			<p>Scan this QR code with an authenticator app, or enter the setup key by hand. Then enter the 6-digit code the app shows.</p>
			<div class="two-factor__setup">
				@qrCode(view.Enrollment.URI)
				<div>
					<p class="two-factor__key-label">Setup key</p>
					<code class="two-factor__key">{ groupSecret(view.Enrollment.Secret) }</code>
				</div>
			</div>
			<form method="post" action="/account/two-factor/enable">
				<input type="hidden" name="_csrf" value={ page.CSRF }/>
				<div class="form-grid">
					<label>
						<span>Current password</span>
						<input type="password" name="currentPassword" autocomplete="current-password" maxlength="128" required/>
					</label>
					<label>
						<span>Code from the app</span>
						<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="8" required/>
					</label>
					<button class="primary-btn" type="submit" data-busy-label="Working…">Turn on two-factor sign-in</button>
				</div>
			</form>
		} else if view.On {
			<p>
				On. Signing in asks for a code from your authenticator app.
				if view.RecoveryLeft == 1 {
					1 recovery code left.
				} else {
					{ strconv.Itoa(view.RecoveryLeft) } recovery codes left.
				}
			</p>
			<form method="post" action="/account/two-factor/disable">
				<input type="hidden" name="_csrf" value={ page.CSRF }/>
				<div class="form-grid">
					<label>
						<span>Current password</span>
						<input type="password" name="currentPassword" autocomplete="current-password" maxlength="128" required/>
					</label>
					<button class="secondary-btn secondary-btn--danger" type="submit" data-busy-label="Working…">Turn off two-factor sign-in</button>
				</div>
			</form>
		} else {
			<p>Off. Ask for a code from an authenticator app, such as a password manager or phone app, after your password.</p>
			<form method="post" action="/account/two-factor/setup">
				<input type="hidden" name="_csrf" value={ page.CSRF }/>
				<button class="secondary-btn" type="submit" data-busy-label="Working…">Set up two-factor sign-in</button>
			</form>
		}
	</section>
}

templ qrCode(content string) {
	{{ path, size, err := qrPath(content) }}
	if err == nil {
		<svg class="two-factor__qr" viewBox={ "0 0 " + strconv.Itoa(size) + " " + strconv.Itoa(size) } role="img" aria-label="QR code for your authenticator app" shape-rendering="crispEdges">
			<rect width="100%" height="100%" fill="#fff"></rect>
			<path d={ path } fill="#000"></path>
		</svg>
	}
}
