package views

import (
	"encoding/json"
	"net/url"
	"strconv"
	"strings"

	"github.com/Crunging/Ludock/internal/files"
	"github.com/Crunging/Ludock/internal/helper"
	"github.com/Crunging/Ludock/internal/servers"
)

// FilesView is the file browser for one folder.
type FilesView struct {
	// Hidden is the refusal that hides the server, which the page fails with.
	Hidden               error
	ServerID, ServerName string
	State, Health        string
	Exit                 *servers.Exit
	Roots                []files.Root
	Root                 files.Root
	Path                 string
	// Filter and Sort apply to the current folder only.
	Filter, Sort string
	Entries      []helper.FileEntry
	// Names are all the folder's entries, which an upload asks before
	// replacing.
	Names []string
	Total int
	// Matched counts the entries the filter keeps; Entries holds the first
	// Limit of them.
	Matched, Limit int
	ListError      string
	// Error replaces the browser when the server or access is unavailable.
	Error        string
	CanManage    bool
	Blocked      bool
	MaxUpload    string
	MaxUploadRaw int64
}

var fileSorts = []struct{ Value, Label string }{{"name-asc", "Name: A to Z"}, {"name-desc", "Name: Z to A"},
	{"size-desc", "Size: largest first"}, {"size-asc", "Size: smallest first"},
	{"modified-desc", "Modified: newest first"}, {"modified-asc", "Modified: oldest first"}}

func (f FilesView) query(path string) string {
	values := url.Values{"root": {f.Root.ID}}
	if path != "" {
		values.Set("path", path)
	}
	return values.Encode()
}

// FilePage is how many entries a folder shows at first and adds each time.
const FilePage = 500

func (f FilesView) listQuery() string {
	return f.limitQuery(f.Limit)
}

func (f FilesView) limitQuery(limit int) string {
	values := url.Values{"root": {f.Root.ID}, "path": {f.Path}, "q": {f.Filter}, "sort": {f.Sort}}
	if limit > FilePage {
		values.Set("limit", strconv.Itoa(limit))
	}
	return values.Encode()
}

func (f FilesView) child(name string) string {
	if f.Path == "" {
		return name
	}
	return f.Path + "/" + name
}

func (f FilesView) entryQuery(name string) string {
	return url.Values{"root": {f.Root.ID}, "path": {f.child(name)}}.Encode()
}

func (f FilesView) breadcrumbs() [][2]string {
	var crumbs [][2]string
	if f.Path == "" {
		return nil
	}
	parts := strings.Split(f.Path, "/")
	for index, part := range parts {
		crumbs = append(crumbs, [2]string{part, strings.Join(parts[:index+1], "/")})
	}
	return crumbs
}

templ fileIcon(kind string) {
	<svg class={ "file-row__icon", "file-row__icon--" + kind } viewBox="0 0 20 20" aria-hidden="true" focusable="false">
		switch kind {
			case "directory":
				<path d="M2.5 5.5a1 1 0 0 1 1-1h4l2 2h7a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1z"></path>
			case "symlink":
				<path d="M5 2.5h7l3.5 3.5v11a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 .5-.5z"></path>
				<path d="M8 13l4-4m-3 0h3v3"></path>
			default:
				<path d="M5 2.5h7l3.5 3.5v11a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 .5-.5zM12 2.5V6h3.5"></path>
		}
	</svg>
}

templ FilesPage(page Page, f FilesView) {
	@Shell(page) {
		<div class="page files-page" data-files={ f.ServerID } data-files-root={ f.Root.ID } data-files-path={ f.Path } data-max-upload={ int64Text(f.MaxUploadRaw) } data-max-upload-text={ f.MaxUpload }>
			<a class="text-link back-link" href={ templ.SafeURL("/servers/" + f.ServerID) }><span aria-hidden="true">←</span> { f.ServerName }</a>
			<div class="files-header">
				<div class="files-header__title">
					<div>
						<div class="files-header__name">
							<h1 class="page__title" id="files-page-title" tabindex="-1">Files</h1>
							if f.State != "" {
								@ServerState(f.State, f.Health, f.Exit)
							}
						</div>
						<p class="page__subtitle">Worlds, configuration, and mods</p>
					</div>
				</div>
				if len(f.Roots) > 1 {
					<form class="files-root" method="get" action={ templ.SafeURL("/files/" + f.ServerID) }>
						<label>
							Data folder
							<select name="root" data-autosubmit>
								for _, root := range f.Roots {
									<option value={ root.ID } selected?={ root.ID == f.Root.ID }>{ root.Name } ({ root.Path })</option>
								}
							</select>
						</label>
						<noscript><button class="secondary-btn" type="submit">Open</button></noscript>
					</form>
				}
			</div>
			<div id="file-feedback" aria-live="polite"></div>
			if f.Error != "" {
				<div class="alert alert--error" role="alert"><span>{ f.Error }</span> <a class="text-link" href={ templ.SafeURL("/files/" + f.ServerID) }>Try again</a></div>
			} else if f.Root.ID == "" {
				<div class="empty-state">
					<h2 class="empty-state__title">No folders to show</h2>
					<p class="empty-state__description">This server has no data folders Ludock may open. An administrator can choose them with the server’s ludock.files label.</p>
				</div>
			} else {
				<section class="file-manager">
					<div class="file-toolbar">
						<nav class="file-breadcrumbs" aria-label="Current folder">
							<a
								href={ templ.SafeURL("/files/" + f.ServerID + "?" + f.query("")) }
								if f.Path == "" {
									aria-current="page"
								}
							>{ f.Root.Name }</a>
							for index, crumb := range f.breadcrumbs() {
								<span>
									<b aria-hidden="true">/</b>
									<a
										href={ templ.SafeURL("/files/" + f.ServerID + "?" + f.query(crumb[1])) }
										if index == len(f.breadcrumbs())-1 {
											aria-current="page"
										}
									>{ crumb[0] }</a>
								</span>
							}
						</nav>
						<div class="file-toolbar__actions">
							<button class="secondary-btn" type="button" hx-get={ "/fragments/files/" + f.ServerID } hx-include=".file-filters" hx-target="#file-list" hx-swap="outerMorph" hx-sync="#file-list:queue last" data-busy-label="Refreshing…">Refresh</button>
							<button class="secondary-btn" type="button" aria-pressed="false" data-file-select-mode>Select</button>
							if f.CanManage {
								<button class="secondary-btn" type="button" disabled?={ f.Blocked } hx-get={ "/fragments/files/" + f.ServerID + "/dialog?action=create&" + f.query(f.Path) } hx-target="#file-dialog">New folder</button>
							}
						</div>
					</div>
					if f.Blocked && f.CanManage {
						<p class="file-manager__note">File changes are paused until Ludock finds exactly one copy of this server in Docker.</p>
					}
					if f.CanManage {
						<div class="file-dropzone" data-dropzone aria-disabled={ boolText(f.Blocked) }>
							<span>Drop files or folders here to upload them to this folder</span>
							<div class="file-dropzone__actions">
								<button class="secondary-btn" type="button" data-choose-folder hidden disabled?={ f.Blocked }>Choose folder</button>
								<button class="primary-btn" type="button" data-choose-files disabled?={ f.Blocked }>Choose files</button>
							</div>
							<input type="file" aria-label="Upload files" multiple hidden data-upload-input disabled?={ f.Blocked }/>
							<input type="file" aria-label="Upload a folder" webkitdirectory hidden data-upload-folder-input disabled?={ f.Blocked }/>
						</div>
						<div class="file-upload-progress" data-upload-progress hidden>
							<span role="status" data-upload-status></span>
							<button class="secondary-btn" type="button" data-upload-cancel>Cancel upload</button>
						</div>
					}
					<form class="file-filters" method="get" action={ templ.SafeURL("/files/" + f.ServerID) } hx-get={ "/fragments/files/" + f.ServerID } hx-target="#file-list" hx-swap="outerMorph" hx-sync="#file-list:queue last" hx-trigger="input changed delay:250ms target:input[name=q], change target:select">
						<input type="hidden" name="root" value={ f.Root.ID }/>
						<input type="hidden" name="path" value={ f.Path }/>
						<label class="file-filters__search">
							Filter filenames
							<input type="search" name="q" value={ f.Filter } placeholder="Search this folder" aria-describedby="file-filter-help" autocomplete="off"/>
						</label>
						<label class="file-filters__sort">
							Sort by
							<select name="sort">
								for _, option := range fileSorts {
									<option value={ option.Value } selected?={ f.Sort == option.Value }>{ option.Label }</option>
								}
							</select>
						</label>
						<noscript><button class="secondary-btn" type="submit">Apply</button></noscript>
					</form>
					<form class="file-selection" id="file-selection" method="get" action={ templ.SafeURL("/files/" + f.ServerID + "/download-selection") }>
						<input type="hidden" name="root" value={ f.Root.ID }/>
						<input type="hidden" name="path" value={ f.Path }/>
						<div class="file-selection-bar" data-selection-bar hidden>
							<span role="status" data-selection-count>0 selected</span>
							<div class="file-selection-bar__actions">
								<button class="secondary-btn" type="submit" disabled data-selection-action>Download</button>
								if f.CanManage {
									<button class="secondary-btn" type="button" disabled data-selection-action data-selection-blocked?={ f.Blocked } hx-get={ "/fragments/files/" + f.ServerID + "/move" } hx-include="#file-selection" hx-target="#file-dialog">Move…</button>
									<button class="secondary-btn secondary-btn--danger" type="button" disabled data-selection-action data-selection-blocked?={ f.Blocked } hx-get={ "/fragments/files/" + f.ServerID + "/dialog?action=delete-selection" } hx-include="#file-selection" hx-target="#file-dialog">Delete…</button>
								}
								<button class="secondary-btn" type="button" data-file-select-mode>Cancel</button>
							</div>
						</div>
						@FileList(f)
					</form>
					if !f.CanManage {
						<p class="file-manager__note">You can browse and download files, but not change them.</p>
					}
				</section>
			}
			<div id="file-dialog"></div>
		</div>
	}
}

func namesJSON(names []string) string {
	if names == nil {
		names = []string{}
	}
	encoded, _ := json.Marshal(names)
	return string(encoded)
}

func boolText(value bool) string {
	if value {
		return "true"
	}
	return "false"
}

// FileList is the current folder; it reloads after changes. Like the server
// list, its refreshes read the filters from the form and share its queue with
// filter requests, so the newest filters win; every swap into it morphs, since
// a queued request keeps the element it targets.
templ FileList(f FilesView) {
	<div id="file-list" hx-get={ "/fragments/files/" + f.ServerID + "?" + f.listQuery() } hx-include=".file-filters" hx-trigger="files-changed from:document" hx-swap="outerMorph" data-names={ namesJSON(f.Names) }>
		// File changes send this back, so their response shows this folder.
		<input type="hidden" id="file-list-state" name="list" value={ f.listQuery() }/>
		<div class="file-filter-summary">
			<p id="file-filter-help">This folder only, folders first</p>
			if f.ListError == "" {
				<p role="status">Showing { intText(len(f.Entries)) } of { intText(f.Total) } entries</p>
			}
		</div>
		<div class="file-list">
			<div class="file-list__header">
				<span class="file-list__name-header">
					<input class="file-row__select" type="checkbox" aria-label="Select all shown" data-file-select-all/>
					Name
				</span>
				<span>Size</span>
				<span>Modified</span>
				<span>Actions</span>
			</div>
			if f.ListError != "" {
				<div class="file-list__error">
					<p role="alert">Unable to load this folder: { f.ListError }</p>
					<button class="secondary-btn" type="button" hx-get={ "/fragments/files/" + f.ServerID + "?" + f.listQuery() } hx-include=".file-filters" hx-target="#file-list" hx-swap="outerMorph" hx-sync="#file-list:queue last">Try again</button>
				</div>
			} else if f.Total == 0 {
				<p class="file-list__empty">This folder is empty.</p>
			} else if len(f.Entries) == 0 {
				<p class="file-list__empty">No filenames match “{ strings.TrimSpace(f.Filter) }”.</p>
			}
			for index, entry := range f.Entries {
				<div class="file-row">
					<div class="file-row__name">
						<input class="file-row__select" type="checkbox" name="name" value={ entry.Name } aria-label={ "Select " + entry.Name } data-file-select/>
						@fileIcon(entry.Type)
						switch entry.Type {
							case "directory":
								<a href={ templ.SafeURL("/files/" + f.ServerID + "?" + f.query(f.child(entry.Name))) }>{ entry.Name }</a>
							case "file":
								<button class="file-row__file" type="button" hx-get={ "/fragments/files/" + f.ServerID + "/preview?" + f.entryQuery(entry.Name) } hx-target="#file-dialog">{ entry.Name }</button>
							default:
								<span>{ entry.Name }</span>
								<small title="Symbolic links cannot be opened">symbolic link</small>
						}
					</div>
					<span>
						if entry.Type == "file" {
							{ FormatBytes(entry.Size) }
						} else {
							—
						}
					</span>
					<span>
						if entry.ModifiedAt > 0 {
							@Time(int64(entry.ModifiedAt), "", "")
						} else {
							—
						}
					</span>
					<div class="file-row__actions">
						<div class="action-menu" data-action-menu>
							<button type="button" class="secondary-btn action-menu__trigger action-menu__trigger--compact" aria-label={ "Actions for " + entry.Name } aria-expanded="false" aria-controls={ "file-actions-" + intText(index) }>
								<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="3" cy="8" r="1.5"></circle><circle cx="8" cy="8" r="1.5"></circle><circle cx="13" cy="8" r="1.5"></circle></svg>
							</button>
							<div class="action-menu__content" id={ "file-actions-" + intText(index) } hidden>
								if entry.Type != "symlink" {
									<a class="action-menu__action" href={ templ.SafeURL("/files/" + f.ServerID + "/download?" + f.entryQuery(entry.Name)) } download>Download</a>
								}
								if f.CanManage && entry.Type == "file" && ArchiveName(entry.Name) {
									<button type="button" class="action-menu__action" disabled?={ f.Blocked } hx-get={ "/fragments/files/" + f.ServerID + "/dialog?action=unpack&type=file&" + f.entryQuery(entry.Name) } hx-target="#file-dialog">Unpack</button>
								}
								if f.CanManage && entry.Type != "symlink" {
									<button type="button" class="action-menu__action" disabled?={ f.Blocked } hx-get={ "/fragments/files/" + f.ServerID + "/dialog?action=rename&type=" + entry.Type + "&" + f.entryQuery(entry.Name) } hx-target="#file-dialog">Rename</button>
								}
								if f.CanManage {
									<button type="button" class="action-menu__action action-menu__action--danger" disabled?={ f.Blocked } hx-get={ "/fragments/files/" + f.ServerID + "/dialog?action=delete&type=" + entry.Type + "&" + f.entryQuery(entry.Name) } hx-target="#file-dialog">Delete</button>
								}
							</div>
						</div>
					</div>
				</div>
			}
			if remaining := f.Matched - len(f.Entries); remaining > 0 {
				<div class="file-list__more">
					<button class="secondary-btn" type="button" hx-get={ "/fragments/files/" + f.ServerID + "?" + f.limitQuery(f.Limit+FilePage) } hx-include=".file-filters" hx-target="#file-list" hx-swap="outerMorph" hx-sync="#file-list:queue last" data-busy-label="Loading…">Show { intText(min(remaining, FilePage)) } more</button>
				</div>
			}
		</div>
	</div>
}

// FileDialog is a new-folder, rename, delete, unpack, or delete-selection
// dialog.
type FileDialog struct {
	ServerID, ServerName string
	Action               string
	Root                 files.Root
	// Path is the folder for create and delete-selection, else the entry.
	Path, Name, Type string
	// Names are a selection's entries in Path.
	Names []string
	Value string
	Error string
}

// ArchiveName reports a name Unpack is offered for. The helper decides by
// content, so a misnamed archive still unpacks.
func ArchiveName(name string) bool {
	lower := strings.ToLower(name)
	for _, suffix := range []string{".zip", ".tar", ".tar.gz", ".tgz", ".mcworld", ".mcpack", ".mcaddon", ".mrpack"} {
		if strings.HasSuffix(lower, suffix) {
			return true
		}
	}
	return false
}

// shownNames lists a selection's first names; the rest are counted.
func shownNames(names []string) ([]string, int) {
	if len(names) > 8 {
		return names[:7], len(names) - 7
	}
	return names, 0
}

func (d FileDialog) folderLabel() string {
	folder := d.Path
	if d.Action != "create" && d.Action != "delete-selection" {
		folder = parentPath(d.Path)
	}
	if folder == "" {
		return d.Root.Name
	}
	return d.Root.Name + "/" + folder
}

func parentPath(value string) string {
	if index := strings.LastIndex(value, "/"); index >= 0 {
		return value[:index]
	}
	return ""
}

func (d FileDialog) title() string {
	switch d.Action {
	case "create":
		return "New folder"
	case "rename":
		return "Rename “" + d.Name + "”"
	case "unpack":
		return "Unpack “" + d.Name + "”?"
	case "delete-selection":
		return "Delete " + ItemCount(len(d.Names)) + "?"
	}
	return "Delete “" + d.Name + "”?"
}

func (d FileDialog) submitLabel() string {
	switch {
	case d.Action == "create":
		return "Create folder"
	case d.Action == "rename":
		return "Rename"
	case d.Action == "unpack":
		return "Unpack"
	case d.Action == "delete-selection":
		return "Delete " + ItemCount(len(d.Names))
	case d.Type == "directory":
		return "Delete folder"
	case d.Type == "symlink":
		return "Delete link"
	}
	return "Delete file"
}

func (d FileDialog) busyLabel() string {
	if d.Action == "unpack" {
		return "Unpacking…"
	}
	return "Working…"
}

// FileOutcome is a file change's notice, sent with the refreshed folder so
// no row from before the change stays on screen after the notice.
templ FileOutcome(kind, message string, list FilesView) {
	@Alert(kind, message)
	@Partial("#file-list", "outerMorph") {
		@FileList(list)
	}
}

templ FileActionDialog(d FileDialog) {
	<dialog class="file-action-dialog" id="file-action" aria-labelledby="file-action-title" aria-describedby="file-action-description" data-open-on-load>
		<form hx-post={ "/files/" + d.ServerID + "/" + d.Action } hx-include="#file-list-state" hx-target="#file-action" hx-swap="outerHTML" data-close-on-success>
			<input type="hidden" name="root" value={ d.Root.ID }/>
			<input type="hidden" name="path" value={ d.Path }/>
			<input type="hidden" name="type" value={ d.Type }/>
			for _, name := range d.Names {
				<input type="hidden" name="name" value={ name }/>
			}
			<h2 id="file-action-title">{ d.title() }</h2>
			<div id="file-action-description" class="file-action-dialog__description">
				<p>{ d.ServerName }, in { d.folderLabel() }</p>
				if d.Action == "unpack" {
					<p>The contents go into a new folder here, named after the archive or the one folder inside it. Nothing that exists is replaced.</p>
					<p>To swap in a new world or configuration, stop the game first.</p>
				}
				if d.Action == "delete-selection" {
					{{ shown, more := shownNames(d.Names) }}
					<ul class="file-action-dialog__names">
						for _, name := range shown {
							<li>{ name }</li>
						}
						if more > 0 {
							<li>and { intText(more) } more</li>
						}
					</ul>
					<p>This permanently deletes them, including everything in any folders. Stop the game first if it uses them.</p>
				}
				if d.Action == "delete" {
					<p>
						switch d.Type {
							case "directory":
								This permanently deletes the folder and everything inside it.
							case "symlink":
								This permanently deletes the symbolic link. Its target is not changed.
							default:
								This permanently deletes the file.
						}
					</p>
				}
			</div>
			if d.Action == "create" || d.Action == "rename" {
				<label class="file-action-dialog__field">
					if d.Action == "create" {
						Folder name
					} else {
						New name
					}
					<input name="name" value={ d.Value } required maxlength="255" autofocus/>
				</label>
			}
			if d.Error != "" {
				@Alert("error", d.Error)
			}
			<div class="file-action-dialog__actions">
				<button class="secondary-btn" type="button" data-dialog-close autofocus?={ d.Action != "create" && d.Action != "rename" }>Cancel</button>
				<button class={ "primary-btn", templ.KV("secondary-btn--danger", d.Action == "delete" || d.Action == "delete-selection") } type="submit" data-busy-label={ d.busyLabel() }>{ d.submitLabel() }</button>
			</div>
		</form>
	</dialog>
}

// FileMove chooses the folder a selection moves to, one level at a time.
type FileMove struct {
	ServerID, ServerName string
	Root                 files.Root
	// Path is the selection's folder; To is the folder being shown.
	Path, To string
	Names    []string
	Folders  []string
	Error    string
	// ListError replaces Folders when To can't be listed.
	ListError string
}

func (m FileMove) browse(to string) string {
	values := url.Values{"root": {m.Root.ID}, "path": {m.Path}, "name": m.Names, "to": {to}}
	return "/fragments/files/" + m.ServerID + "/move?" + values.Encode()
}

// moveCrumbs is how many of the destination's last folders the move dialog
// links to: each link carries the whole selection, so a deep destination
// would otherwise repeat it hundreds of times.
const moveCrumbs = 5

// crumbs are the destination's last folders.
func (m FileMove) crumbs() [][2]string {
	crumbs := FilesView{Path: m.To}.breadcrumbs()
	return crumbs[max(0, len(crumbs)-moveCrumbs):]
}

// cropped reports whether crumbs leaves folders out.
func (m FileMove) cropped() bool { return len(FilesView{Path: m.To}.breadcrumbs()) > moveCrumbs }

templ FileMoveDialog(m FileMove) {
	<dialog class="file-action-dialog" id="file-action" aria-labelledby="file-action-title" aria-describedby="file-action-description" data-open-on-load>
		@FileMoveContent(m)
	</dialog>
}

// FileMoveContent is the move dialog's content, swapped in place while
// browsing for a folder.
templ FileMoveContent(m FileMove) {
	<form hx-post={ "/files/" + m.ServerID + "/move" } hx-include="#file-list-state" hx-target="#file-action" hx-swap="outerHTML" data-close-on-success>
		<input type="hidden" name="root" value={ m.Root.ID }/>
		<input type="hidden" name="path" value={ m.Path }/>
		<input type="hidden" name="to" value={ m.To }/>
		for _, name := range m.Names {
			<input type="hidden" name="name" value={ name }/>
		}
		<h2 id="file-action-title">Move { ItemCount(len(m.Names)) }</h2>
		<div id="file-action-description" class="file-action-dialog__description">
			<p>Choose a folder in { m.Root.Name }. Stop the game first if it uses these files.</p>
		</div>
		<nav class="file-breadcrumbs file-move__crumbs" aria-label="Folder to move to">
			<button type="button" hx-get={ m.browse("") } hx-target="#file-action" hx-swap="innerHTML" aria-current?={ m.To == "" }>{ m.Root.Name }</button>
			if m.cropped() {
				<span><b aria-hidden="true">/</b> …</span>
			}
			for _, crumb := range m.crumbs() {
				<span>
					<b aria-hidden="true">/</b>
					<button type="button" hx-get={ m.browse(crumb[1]) } hx-target="#file-action" hx-swap="innerHTML" aria-current?={ m.To == crumb[1] }>{ crumb[0] }</button>
				</span>
			}
		</nav>
		<ul class="file-move__folders" aria-label="Folders">
			if m.ListError != "" {
				<li class="file-move__empty" role="alert">{ m.ListError }</li>
			} else if len(m.Folders) == 0 {
				<li class="file-move__empty">No folders here</li>
			}
			for _, folder := range m.Folders {
				<li>
					<button type="button" hx-get={ m.browse(FilesView{Path: m.To}.child(folder)) } hx-target="#file-action" hx-swap="innerHTML">
						@fileIcon("directory")
						{ folder }
					</button>
				</li>
			}
		</ul>
		if m.Error != "" {
			@Alert("error", m.Error)
		}
		<div class="file-action-dialog__actions">
			<button class="secondary-btn" type="button" data-dialog-close>Cancel</button>
			<button class="primary-btn" type="submit" disabled?={ m.To == m.Path } data-busy-label="Moving…">Move here</button>
		</div>
	</form>
}

type FilePreview struct {
	ServerID string
	Root     string
	// File is the path within Root.
	File       string
	Name       string
	Path       string
	Size       int64
	ModifiedAt int64
	Kind       files.PreviewKind
	Text       string
	Error      string
	Download   string
	Limit      string
	// CanEdit offers editing to users with file write access.
	CanEdit  bool
	Editable bool
	Editing  bool
	Version  string
	CRLF     bool
	BOM      bool
	// Unsaved marks editor text the file doesn't hold, such as a refused save.
	Unsaved bool
	Notice  string
}

func (p FilePreview) previewURL(edit bool) string {
	values := url.Values{"root": {p.Root}, "path": {p.File}}
	if edit {
		values.Set("edit", "1")
	}
	return "/fragments/files/" + p.ServerID + "/preview?" + values.Encode()
}

func (p FilePreview) saveURL() string {
	values := url.Values{"root": {p.Root}, "path": {p.File}, "version": {p.Version}}
	if p.CRLF {
		values.Set("crlf", "1")
	}
	if p.BOM {
		values.Set("bom", "1")
	}
	return "/files/" + p.ServerID + "/save?" + values.Encode()
}

templ FilePreviewDialog(p FilePreview) {
	<dialog class="file-action-dialog file-preview" id="file-action" aria-labelledby="file-preview-title" aria-describedby="file-preview-description" data-open-on-load>
		@FilePreviewContent(p)
	</dialog>
}

// FilePreviewContent is the preview dialog's content, swapped in place when
// editing starts, ends, or saves.
templ FilePreviewContent(p FilePreview) {
	<div class="file-preview__header">
		<div>
			<h2 id="file-preview-title">{ p.Name }</h2>
			<p id="file-preview-description" class="file-preview__meta">
				<code>{ p.Path }</code>
				<span>{ FormatBytes(p.Size) }</span>
			</p>
		</div>
	</div>
	if p.Editing {
		<form class="file-editor" data-file-editor={ p.saveURL() }>
			<p class="file-editor__note">A running game may overwrite this file, or ignore the change until it restarts.</p>
			<textarea class="file-editor__text" name="content" aria-label={ "Edit " + p.Name } spellcheck="false" autocomplete="off" autocapitalize="off" data-unsaved?={ p.Unsaved } autofocus>{ "\n" + p.Text }</textarea>
			<div data-file-editor-error>
				if p.Error != "" {
					@Alert("error", p.Error)
				}
			</div>
			<div class="file-action-dialog__actions">
				<button type="button" class="secondary-btn" hx-get={ p.previewURL(false) } hx-target="#file-action" hx-swap="innerHTML">Cancel</button>
				<button type="submit" class="primary-btn">Save</button>
			</div>
		</form>
	} else {
		<div class="file-preview__body">
			if p.Notice != "" {
				@Alert("success", p.Notice)
			}
			switch  {
				case p.Error != "":
					<div class="alert alert--error" role="alert">{ p.Error }</div>
				case p.Kind == files.PreviewLarge:
					<p class="muted">Files over { p.Limit } aren’t shown here. Download it to open it.</p>
				case p.Kind == files.PreviewBinary:
					<p class="muted">This file can’t be shown as text. Download it to open it.</p>
				case p.Text == "":
					<p class="muted">This file is empty.</p>
				default:
					<pre tabindex="0" aria-label={ "Contents of " + p.Name }>{ p.Text }</pre>
			}
			if p.CanEdit && p.Error == "" && p.Kind == files.PreviewText && !p.Editable {
				<p class="muted">This file mixes line endings, so it can’t be edited here.</p>
			}
		</div>
		<div class="file-action-dialog__actions">
			<a class="secondary-btn" href={ templ.SafeURL(p.Download) } download>Download</a>
			if p.CanEdit && p.Error == "" && p.Kind == files.PreviewText && p.Editable {
				<button type="button" class="secondary-btn" hx-get={ p.previewURL(true) } hx-target="#file-action" hx-swap="innerHTML">Edit</button>
			}
			<button type="button" class="primary-btn" data-dialog-close autofocus>Close</button>
		</div>
	}
}
