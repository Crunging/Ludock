package views

// Page describes the signed-in shell around a page.
type Page struct {
	Title    string
	CSRF     string
	Username string
	Admin    bool
	RoleName string
	// Path is the current path, for active navigation links.
	Path string
	// ServerTools marks server pages, which highlight "Servers".
	ServerTools bool
	// Console hides the navigation for the full-screen console.
	Console bool
	// Scripts are extra script URLs for this page.
	Scripts []string
	Styles  []string
}

templ Document(title, csrf string, scripts, styles []string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="theme-color" content="#14233a"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="description" content="Manage your existing Docker game servers with Ludock."/>
			// Eval stays off: the CSP allows no inline or string-evaluated script.
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyCacheSize":0,"selfRequestsOnly":true}'/>
			if csrf != "" {
				<meta name="csrf-token" content={ csrf }/>
			}
			<link rel="icon" type="image/svg+xml" href={ Asset("favicon.svg") }/>
			<link rel="icon" type="image/png" sizes="32x32" href={ Asset("favicon-32.png") }/>
			<link rel="apple-touch-icon" sizes="180x180" href={ Asset("apple-touch-icon.png") }/>
			<link rel="stylesheet" href={ Asset("ludock.css") }/>
			for _, style := range styles {
				<link rel="stylesheet" href={ Asset(style) }/>
			}
			<title>{ title }</title>
			<script src={ Asset("vendor/htmx.min.js") } defer></script>
			<script src={ Asset("vendor/htmx-sse.min.js") } defer></script>
			<script src={ Asset("ludock.js") } defer></script>
			for _, script := range scripts {
				<script src={ Asset(script) } defer></script>
			}
		</head>
		<body hx-ext="sse">
			{ children... }
		</body>
	</html>
}

templ LudockMark(class string) {
	<svg class={ class } viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" focusable="false">
		<rect x="17" y="9" width="14" height="14" rx="1.5"></rect>
		<rect x="17" y="25" width="14" height="14" rx="1.5"></rect>
		<rect x="17" y="41" width="14" height="14" rx="1.5"></rect>
		<rect x="33" y="41" width="14" height="14" rx="1.5"></rect>
	</svg>
}

func navClass(page Page, to string) string {
	if navCurrent(page, to) != "" {
		return "harbor__link harbor__link--current"
	}
	return "harbor__link"
}

func navCurrent(page Page, to string) string {
	switch {
	case page.Path == to:
		return "page"
	case to == "/" && page.ServerTools:
		return "location"
	case to != "/" && len(page.Path) > len(to) && page.Path[:len(to)+1] == to+"/":
		return "location"
	}
	return ""
}

templ navLink(page Page, to, label string) {
	<a href={ templ.SafeURL(to) } class={ navClass(page, to) } aria-current={ navCurrent(page, to) }>{ label }</a>
}

// Shell is the signed-in layout: a harbor bar across the top, then the page.
templ Shell(page Page) {
	@Document(page.Title+" · Ludock", page.CSRF, page.Scripts, page.Styles) {
		<div class={ "app", templ.KV("app--console", page.Console) } hx-headers={ csrfHeaders(page.CSRF) }>
			<a class="skip-link" href="#main-content">Skip to content</a>
			if !page.Console {
				<header class="harbor">
					<a class="harbor__brand" href="/" aria-label="Ludock servers">
						@LudockMark("harbor__mark")
						<span>Ludock</span>
					</a>
					<nav class="harbor__nav" aria-label="Primary navigation">
						<div class="harbor__group">
							@navLink(page, "/", "Servers")
							@navLink(page, "/operations", "Operations")
						</div>
						if page.Admin {
							<div class="harbor__group" role="group" aria-label="Administration">
								@navLink(page, "/users", "Users")
								@navLink(page, "/settings", "Settings")
								@navLink(page, "/diagnostics", "Diagnostics")
								@navLink(page, "/audit", "Audit log")
								@navLink(page, "/logs", "Ludock logs")
							</div>
						}
					</nav>
					<div class="harbor__session">
						<a href="/account" class={ "harbor__account", templ.KV("harbor__account--current", page.Path == "/account") } aria-current={ navCurrent(page, "/account") }>
							<span class="harbor__username">{ page.Username }</span>
							<span class="harbor__role">{ page.RoleName }</span>
						</a>
						<form method="post" action="/logout" class="harbor__signout">
							<input type="hidden" name="_csrf" value={ page.CSRF }/>
							<button type="submit">Sign out</button>
						</form>
					</div>
				</header>
			}
			<main id="main-content" tabindex="-1" class="main">
				{ children... }
			</main>
		</div>
	}
}
